+"""WildBench source judge transport and bounded structured scores."""
+
+import dataclasses
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import sys
+import tempfile
+
+from openai import OpenAI
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.json_objects import unique_object
+from verifyit.modes.grade_json_schema import grade_json_schema_candidate
+from verifyit.spec import ScriptSpec, render_spec
+
+SOURCE_HASHES = {
+    "src/eval.py": "ab53d94e0eef5c90e92858b21be06fca55cae0d6dfab58dc0554395b6c5d5116",
+    "evaluation/eval_template.score.v2.md": "c5984ae77b009f8dad0e8e37093348345f4e8d3099ce812bd7799ef7b73f005f",
+}
+
+
+def validate_source():
+    directory = Path(__file__).resolve().parents[1] / "chat_benchmarks/WildBench"
+    for name, digest in SOURCE_HASHES.items():
+        if hashlib.sha256((directory / name).read_bytes()).hexdigest() != digest:
+            raise InvalidTask("WildBench source request contract changed")
+
+
+def judge(payload, *, empty_response=False):
+    validate_source()
+    if type(empty_response) is not bool:
+        raise InvalidTask("WildBench empty-response flag must be boolean")
+    if not isinstance(payload, dict) or not isinstance(payload.get("body"), dict):
+        raise InvalidTask("Malformed WildBench judge request")
+    if not isinstance(payload.get("custom_id"), str) or "||" not in payload["custom_id"]:
+        raise InvalidTask("WildBench judge request requires a source identifier")
+    with tempfile.TemporaryDirectory(prefix="verifyit-wildbench-") as directory:
+        root = Path(directory)
+        (root / "input.json").write_text(
+            json.dumps({"request": payload, "empty_response": empty_response}, allow_nan=False)
+        )
+        (root / "run.sh").write_text('exec "$@"\n')
+        spec = ScriptSpec(
+            "run.sh",
+            args=(sys.executable, "-m", "eval.graders.verifyit_wildbench", str(root / "input.json")),
+            timeout=1900,
+            verdict_file="result.json",
+        )
+        (root / "verifier.toml").write_text(render_spec(spec))
+        verdict = run(root / "verifier.toml", root)
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(str(verdict.detail))
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"WildBench judge failed: {verdict.status}: {verdict.detail}")
+    score = verdict.detail.get("source_score")
+    if type(score) not in (int, float) or not math.isfinite(score) or not 1 <= score <= 10:
+        raise RuntimeError("WildBench verifier returned an invalid score")
+    if verdict.reward != (score - 1) / 9:
+        raise RuntimeError("WildBench score disagrees with verifier reward")
+    return {**payload, "response": verdict.detail["response"]}
+
+
+def main():
+    data = json.loads(Path(sys.argv[1]).read_text())
+    payload = data["request"]
+    validate_source()
+    body = {**payload["body"], "max_tokens": 4096}
+    with OpenAI() as client:
+        raw = client.chat.completions.with_raw_response.create(**body)
+        transport = json.loads(raw.http_response.text, object_pairs_hook=unique_object)
+        json.dumps(transport, allow_nan=False)
+        if not isinstance(transport, dict) or transport.get("error") is not None:
+            raise RuntimeError("WildBench judge transport error")
+        choices = transport.get("choices")
+        if not isinstance(choices, list) or len(choices) != 1 or choices[0].get("finish_reason") != "stop":
+            raise RuntimeError("WildBench requires one complete judgment")
+        message = choices[0].get("message")
+        if (
+            not isinstance(message, dict)
+            or message.get("refusal")
+            or message.get("tool_calls")
+            or message.get("function_call")
+        ):
+            raise RuntimeError("WildBench judge refused or requested a tool")
+        content = json.loads(message["content"], object_pairs_hook=unique_object)
+        json.dumps(content, allow_nan=False)
+        if not isinstance(content, dict) or type(content.get("score")) not in (str, int, float):
+            raise RuntimeError("WildBench judgment lacks a numeric score")
+        score = float(content["score"])
+        schema_verdict = grade_json_schema_candidate({"type": "number", "minimum": 1, "maximum": 10}, score)
+        if not math.isfinite(score) or schema_verdict.status != Status.SCORED or schema_verdict.reward != 1:
+            raise RuntimeError("WildBench judge score lies outside the source scale")
+        response = json.loads(raw.parse().json())
+        original_score = score
+        if data["empty_response"]:
+            score = 1.0
+            content["score"] = "1"
+            response["choices"][0]["message"]["content"] = json.dumps(content)
+    result = {
+        "status": "scored",
+        "reward": (score - 1) / 9,
+        "detail": {
+            "source_score": score,
+            "original_judge_score": original_score,
+            "response": response,
+            "schema_verdict": dataclasses.asdict(schema_verdict),
+        },
+    }
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(result, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
