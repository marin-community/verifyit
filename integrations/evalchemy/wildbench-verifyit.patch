+"""WildBench source score scale and malformed HTTP response regressions."""
+
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+import threading
+
+import pytest
+
+from eval.graders.verifyit_wildbench import judge
+
+
+@pytest.fixture
+def judge_server(monkeypatch):
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            case = request["messages"][0]["content"]
+            content = {"strengths": "Fixture", "weaknesses": "Fixture", "score": "10"}
+            message = {"role": "assistant", "content": json.dumps(content), "refusal": None}
+            choice = {"index": 0, "finish_reason": "stop", "message": message}
+            if case == "out_of_range":
+                content["score"] = 11
+                message["content"] = json.dumps(content)
+            elif case == "duplicate":
+                message["content"] = '{"score": "1", "score": "10"}'
+            elif case == "nonfinite":
+                message["content"] = '{"score": "NaN"}'
+            elif case == "refusal":
+                message["refusal"] = "Refused"
+            elif case == "truncated":
+                choice["finish_reason"] = "length"
+            elif case == "missing_score":
+                message["content"] = "{}"
+            response = {
+                "id": "fixture",
+                "object": "chat.completion",
+                "created": 0,
+                "model": "fixture",
+                "choices": [choice],
+            }
+            body = json.dumps(response).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *_):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    monkeypatch.setenv("OPENAI_API_KEY", "fixture")
+    monkeypatch.setenv("OPENAI_BASE_URL", f"http://127.0.0.1:{server.server_port}/v1")
+    yield
+    server.shutdown()
+    server.server_close()
+    thread.join()
+
+
+def request(content):
+    return {
+        "custom_id": "sample||model",
+        "body": {"model": "fixture", "messages": [{"role": "user", "content": content}], "max_tokens": 4096},
+    }
+
+
+def test_empty_output_uses_minimum_even_when_judge_returns_ten(judge_server):
+    result = judge(request("ordinary"), empty_response=True)
+    assert json.loads(result["response"]["choices"][0]["message"]["content"])["score"] == "1"
+
+
+def test_quoted_prompt_markers_do_not_make_nonempty_response_empty(judge_server):
+    result = judge(request("Quoted markers: <|begin_of_response|>\n<|end_of_response|>\n"), empty_response=False)
+    assert json.loads(result["response"]["choices"][0]["message"]["content"])["score"] == "10"
+
+
+@pytest.mark.parametrize("fault", ["out_of_range", "duplicate", "nonfinite", "refusal", "truncated", "missing_score"])
+def test_invalid_judge_response_does_not_produce_a_score(judge_server, fault):
+    with pytest.raises(RuntimeError, match="WildBench judge failed"):
+        judge(request(fault))
