+"""MathArena source contracts through isolated HMMT grading."""
+
+import subprocess
+
+import pytest
+
+from eval.graders.verifyit_hmmt import DOCKER, IMAGE, grade_response
+from verifyit.grade import InvalidTask
+
+
+@pytest.fixture(scope="module", autouse=True)
+def candidate_image():
+    if DOCKER is None:
+        pytest.skip("Docker is required for isolated HMMT grading")
+    if subprocess.run([DOCKER, "image", "inspect", IMAGE], capture_output=True, timeout=10).returncode:
+        pytest.skip("Load the pinned HMMT image")
+
+
+@pytest.mark.parametrize(
+    ("raw", "gold", "expected"),
+    [
+        (r"\boxed{2}", "2", True),
+        (r"\boxed{3}", "2", False),
+        (r"\boxed{2,1,1}", "1,1,2", True),
+        (r"\boxed{1,2,2}", "1,1,2", False),
+        (r"\boxed{1}, \boxed{2}", "1,2", True),
+        (r"\boxed{Integral(2*x,(x,0,1))}", "1", True),
+        (r"\boxed{1/20000000000}", "0", True),
+        (r"\boxed{0.0000000001}", "0", False),
+        (r"\boxed{Derivative(x,x)}", "1", False),
+        (None, "1", False),
+    ],
+)
+def test_isolated_source_parsing_and_comparison(raw, gold, expected):
+    actual, display = grade_response(raw, gold)
+    assert actual is expected
+    assert type(display) in (int, float, str, type(None))
+
+
+def test_empty_filtered_reference_aborts_instead_of_awarding_vacuous_credit():
+    with pytest.raises(InvalidTask):
+        grade_response(r"\boxed{a,b}", "a,b")
+
+
+@pytest.fixture
+def benchmark(monkeypatch):
+    import importlib
+    from pathlib import Path
+
+    monkeypatch.syspath_prepend(str(Path(__file__).resolve().parents[2] / "eval/chat_benchmarks/HMMT"))
+    module = importlib.import_module("eval.chat_benchmarks.HMMT.eval_instruct")
+    return module.HMMTBenchmark(verifyit_enabled=True)
+
+
+def test_invalid_reference_after_valid_sample_aborts_without_metrics(benchmark):
+    examples = [
+        {"answer": answer, "model_outputs": [r"\boxed{1}"] * 10, "model_answers": [1] * 10, "label": []}
+        for answer in ("1", "a,b")
+    ]
+    with pytest.raises(InvalidTask):
+        benchmark.evaluate_responses({"examples": examples})
+
+
+def test_missing_raw_outputs_cannot_reuse_positive_parsed_answers(benchmark):
+    examples = [{"answer": "1", "model_answers": [1] * 10, "label": []}]
+    with pytest.raises(InvalidTask):
+        benchmark.evaluate_responses({"examples": examples})
