+"""Bounded data nodes for the source HMMT numeric and algebraic answer contract."""
+
+import math
+
+import sympy
+from matharena.parser import AnswerList
+from sympy.polys.rootoftools import ComplexRootOf
+
+MAX_DEPTH = 32
+MAX_NODES = 4096
+MAX_INTEGER_BITS = 65536
+OPERATIONS = {
+    "Add": sympy.Add,
+    "Mul": sympy.Mul,
+    "Pow": sympy.Pow,
+    "Tuple": sympy.Tuple,
+    "Integral": sympy.Integral,
+    "Sum": sympy.Sum,
+    "Product": sympy.Product,
+    "sin": sympy.sin,
+    "cos": sympy.cos,
+    "exp": sympy.exp,
+    "log": sympy.log,
+}
+CONSTANTS = {"pi": sympy.pi, "E": sympy.E, "I": sympy.I, "oo": sympy.oo, "negative_oo": -sympy.oo}
+
+
+class UnsupportedNode(ValueError):
+    pass
+
+
+def _integer(value):
+    if type(value) is not int or value.bit_length() > MAX_INTEGER_BITS:
+        raise UnsupportedNode("Invalid or oversized integer")
+    return format(value, "x")
+
+
+def _decode_integer(value):
+    import re
+
+    if type(value) is not str or len(value) > MAX_INTEGER_BITS // 4 + 1 or re.fullmatch(r"-?[0-9a-f]+", value) is None:
+        raise UnsupportedNode("Invalid integer data")
+    result = int(value, 16)
+    _integer(result)
+    return result
+
+
+def encode(value):
+    remaining = [MAX_NODES]
+
+    def visit(item, depth):
+        remaining[0] -= 1
+        if depth > MAX_DEPTH or remaining[0] < 0:
+            raise UnsupportedNode("Symbolic data exceeds bounds")
+        if item is None:
+            return {"kind": "none"}
+        if type(item) is int:
+            return {"kind": "int", "value": _integer(item)}
+        if type(item) is float:
+            if not math.isfinite(item):
+                raise UnsupportedNode("Nonfinite candidate number")
+            return {"kind": "float", "value": item.hex()}
+        if type(item) is AnswerList:
+            return {"kind": "answers", "items": [visit(child, depth + 1) for child in item.answers]}
+        for name, constant in CONSTANTS.items():
+            if item is constant:
+                return {"kind": "constant", "name": name}
+        if isinstance(item, sympy.Integer) and type(item).__module__.startswith("sympy."):
+            return {"kind": "integer", "value": _integer(int(item))}
+        if isinstance(item, sympy.Rational) and type(item).__module__.startswith("sympy."):
+            return {"kind": "rational", "p": _integer(int(item.p)), "q": _integer(int(item.q))}
+        if type(item) is sympy.Float:
+            return {
+                "kind": "sympy_float",
+                "mpf": [_integer(int(part)) for part in item._mpf_],
+                "precision": item._prec,
+            }
+        if type(item) is sympy.Symbol:
+            return {"kind": "symbol", "name": item.name, "assumptions": item._assumptions_orig}
+        if type(item) is ComplexRootOf:
+            coefficients = item.poly.all_coeffs()
+            if not 2 <= len(coefficients) <= 17:
+                raise UnsupportedNode("Algebraic root degree exceeds bound")
+            return {
+                "kind": "root",
+                "coefficients": [visit(child, depth + 1) for child in coefficients],
+                "index": item.index,
+            }
+        if type(item) in OPERATIONS.values():
+            return {"kind": type(item).__name__, "items": [visit(child, depth + 1) for child in item.args]}
+        raise UnsupportedNode("Unsupported symbolic node: " + type(item).__name__)
+
+    return visit(value, 0)
+
+
+def decode(value):
+    remaining = [MAX_NODES]
+
+    def visit(node, depth):
+        remaining[0] -= 1
+        if depth > MAX_DEPTH or remaining[0] < 0 or type(node) is not dict:
+            raise UnsupportedNode("Invalid symbolic data bounds")
+        kind = node.get("kind")
+        if kind == "none" and set(node) == {"kind"}:
+            return None
+        if kind in {"int", "integer", "float"} and set(node) == {"kind", "value"}:
+            if kind == "float":
+                if type(node["value"]) is not str or len(node["value"]) > 64:
+                    raise UnsupportedNode("Invalid float data")
+                result = float.fromhex(node["value"])
+                if not math.isfinite(result):
+                    raise UnsupportedNode("Nonfinite float data")
+                return result
+            result = _decode_integer(node["value"])
+            return sympy.Integer(result) if kind == "integer" else result
+        if kind == "rational" and set(node) == {"kind", "p", "q"}:
+            numerator, denominator = _decode_integer(node["p"]), _decode_integer(node["q"])
+            if denominator <= 0:
+                raise UnsupportedNode("Invalid rational denominator")
+            return sympy.Rational(numerator, denominator)
+        if kind == "constant" and set(node) == {"kind", "name"} and node["name"] in CONSTANTS:
+            return CONSTANTS[node["name"]]
+        if kind == "symbol" and set(node) == {"kind", "name", "assumptions"}:
+            if (
+                type(node["name"]) is not str
+                or not 0 < len(node["name"]) <= 256
+                or type(node["assumptions"]) is not dict
+            ):
+                raise UnsupportedNode("Invalid symbol")
+            if any(
+                type(key) is not str or len(key) > 64 or type(item) is not bool
+                for key, item in node["assumptions"].items()
+            ):
+                raise UnsupportedNode("Invalid symbol assumptions")
+            return sympy.Symbol(node["name"], **node["assumptions"])
+        if kind == "sympy_float" and set(node) == {"kind", "mpf", "precision"}:
+            if (
+                type(node["mpf"]) is not list
+                or len(node["mpf"]) != 4
+                or type(node["precision"]) is not int
+                or not 1 <= node["precision"] <= 4096
+            ):
+                raise UnsupportedNode("Invalid SymPy float")
+            sign, mantissa, exponent, bits = map(_decode_integer, node["mpf"])
+            if sign not in (0, 1) or mantissa < 0 or abs(exponent) > 65536 or bits != mantissa.bit_length():
+                raise UnsupportedNode("Invalid SymPy float fields")
+            return sympy.Float._new((sign, mantissa, exponent, bits), node["precision"])
+        if kind == "root" and set(node) == {"kind", "coefficients", "index"}:
+            if (
+                type(node["coefficients"]) is not list
+                or not 2 <= len(node["coefficients"]) <= 17
+                or type(node["index"]) is not int
+                or not 0 <= node["index"] < len(node["coefficients"]) - 1
+            ):
+                raise UnsupportedNode("Invalid bounded algebraic root")
+            coefficients = [visit(child, depth + 1) for child in node["coefficients"]]
+            if (
+                any(not isinstance(child, sympy.Rational) and type(child) is not int for child in coefficients)
+                or coefficients[0] == 0
+            ):
+                raise UnsupportedNode("Invalid algebraic root coefficients")
+            symbol = sympy.Symbol("x")
+            degree = len(coefficients) - 1
+            expression = sum(
+                coefficient * symbol ** (degree - index) for index, coefficient in enumerate(coefficients)
+            )
+            return sympy.CRootOf(expression, symbol, node["index"])
+        if kind in {"answers", *OPERATIONS} and set(node) == {"kind", "items"}:
+            if type(node["items"]) is not list or len(node["items"]) > MAX_NODES:
+                raise UnsupportedNode("Invalid symbolic arguments")
+            items = [visit(child, depth + 1) for child in node["items"]]
+            if kind == "answers":
+                return AnswerList(items)
+            if (
+                not items
+                or any(item is None or isinstance(item, AnswerList) for item in items)
+                or kind == "Pow"
+                and len(items) != 2
+            ):
+                raise UnsupportedNode("Invalid operation arguments")
+            if kind in {"Add", "Mul", "Pow"}:
+                return OPERATIONS[kind](*items, evaluate=False)
+            return OPERATIONS[kind](*items)
+        raise UnsupportedNode("Unknown symbolic node")
+
+    return visit(value, 0)
