@@ -0,0 +1,196 @@
+"""Isolated MathArena extraction with trusted source comparison through ScriptSpec."""
+
+import hashlib
+import importlib
+import json
+import math
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import uuid
+
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.spec import ScriptSpec, render_spec
+from lm_eval.verifyit_humaneval import DOCKER, score
+
+
+IMAGE = "sha256:383bbe594b89384d0b1bb9a3f24a936bbf87152e2e3864276e0b383655943805"
+SOURCE_HASHES = {
+    "parser.py": "a39b1d31befdb5414ca4784260d83932516a5940e87aa71284786bb42b2d3ec1",
+    "utils.py": "ac405f70f90b6c4745d41305ccda618462a2697576ac4cc0c671fca41303e6d0",
+    "parse_manual.py": "254e3bdfe5e8c62430fd81fbd9bd0d66a5da74080dbbc1eaa9a165956d2b2549",
+}
+VALUES_HASH = "800d80ab47a13592fdff706ac31a70087e29cba5a527b37f71535e5222b2ad7c"
+PARSER_PROGRAM = """from matharena.parser import extract_answer
+from verifyit_hmmt_values import encode
+
+def parse(raw, list_answer):
+    parsed, warning = extract_answer(raw, False, True, list_answer)
+    return encode(parsed)
+"""
+
+
+def _runtime():
+    directory = str(Path(__file__).resolve().parent.parent / "chat_benchmarks/HMMT")
+    if directory not in sys.path:
+        sys.path.insert(0, directory)
+    return importlib.import_module("matharena.parser"), importlib.import_module("eval.graders.verifyit_hmmt_values")
+
+
+def _validate_gold(reference):
+    parser, values = _runtime()
+    if not isinstance(reference, str) or not reference.strip():
+        raise InvalidTask("HMMT reference must be nonempty text")
+    try:
+        gold, _ = parser.parse_answer(reference)
+        values.encode(gold)
+    except Exception as error:
+        raise InvalidTask("HMMT reference cannot define a supported task") from error
+
+    def valid(value):
+        if value is None:
+            return False
+        if type(value) is parser.AnswerList:
+            return bool(value.answers) and all(valid(item) for item in value.answers)
+        if type(value) is float:
+            return math.isfinite(value)
+        return getattr(value, "is_finite", True) is not False
+
+    if not valid(gold):
+        raise InvalidTask("HMMT reference normalizes to an empty or nonfinite answer")
+    return gold
+
+
+def validate_examples(examples, repeats):
+    if type(repeats) is not int or repeats <= 0 or not isinstance(examples, list) or not examples:
+        raise InvalidTask("HMMT requires a nonempty repeated-score batch")
+    for example in examples:
+        if not isinstance(example, dict) or type(example.get("answer")) not in (str, int, float):
+            raise InvalidTask("Malformed HMMT reference")
+        reference = str(example["answer"])
+        if not reference.strip() or type(example["answer"]) is float and not math.isfinite(example["answer"]):
+            raise InvalidTask("Invalid HMMT reference")
+        outputs = example.get("model_outputs")
+        answers = example.get("model_answers")
+        if (
+            not isinstance(outputs, list)
+            or len(outputs) != repeats
+            or not isinstance(answers, list)
+            or len(answers) != repeats
+        ):
+            raise InvalidTask("HMMT raw outputs must align with source repetitions")
+
+
+def _sources():
+    root = Path(__file__).resolve().parent.parent / "chat_benchmarks/HMMT/matharena"
+    for filename, expected in SOURCE_HASHES.items():
+        if hashlib.sha256((root / filename).read_bytes()).hexdigest() != expected:
+            raise InvalidTask("Trusted MathArena source changed")
+    if hashlib.sha256(Path(__file__).with_name("verifyit_hmmt_values.py").read_bytes()).hexdigest() != VALUES_HASH:
+        raise InvalidTask("HMMT typed transport differs from the pinned image")
+
+
+def _trusted_check(candidate, raw, reference, list_answer, output, parse_only):
+    node = candidate(raw, list_answer)
+    parser, values = _runtime()
+    parsed = values.decode(node)
+    display = parsed if type(parsed) in (int, float, str, type(None)) else str(parsed)
+    Path(output).write_text(json.dumps({"node": node, "output": display}, allow_nan=False))
+    if not parse_only:
+        assert parser.check_answers(parsed, _validate_gold(reference))
+
+
+def grade_response(raw, reference, *, parse_only=False, list_answer=None):
+    _sources()
+    if not parse_only and (not isinstance(reference, str) or not reference.strip()):
+        raise InvalidTask("HMMT reference must be nonempty text")
+    if list_answer is None:
+        list_answer = "," in reference
+    if type(list_answer) is not bool:
+        raise InvalidTask("HMMT list extraction flag must be boolean")
+    if raw is not None and type(raw) is not str:
+        raw = None
+    name = "verifyit-hmmt-" + uuid.uuid4().hex
+    try:
+        with tempfile.TemporaryDirectory(prefix="verifyit-hmmt-") as directory:
+            root = Path(directory)
+            payload = {
+                "raw": raw,
+                "reference": reference,
+                "parse_only": parse_only,
+                "list_answer": list_answer,
+                "name": name,
+            }
+            (root / "input.json").write_text(json.dumps(payload, allow_nan=False))
+            (root / "run.sh").write_text('exec "$@"\n')
+            specification = ScriptSpec(
+                "run.sh",
+                args=(sys.executable, "-m", "eval.graders.verifyit_hmmt", str(root / "input.json")),
+                timeout=50,
+                verdict_file="result.json",
+            )
+            (root / "verifier.toml").write_text(render_spec(specification))
+            verdict = run(root / "verifier.toml", root)
+    finally:
+        if DOCKER:
+            subprocess.run(
+                [DOCKER, "rm", "-f", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10
+            )
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(str(verdict.detail))
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"HMMT verifier failed: {verdict.status}: {verdict.detail}")
+    output = verdict.detail["output"]
+    if type(output) not in (int, float, str, type(None)) or type(output) is float and not math.isfinite(output):
+        raise RuntimeError("Invalid HMMT display result")
+    if isinstance(output, str) and len(output.encode()) > 1048576:
+        raise RuntimeError("Oversized HMMT display result")
+    return bool(verdict.reward), output
+
+
+def parse_response(raw, list_answer):
+    return grade_response(raw, None, parse_only=True, list_answer=list_answer)[1]
+
+
+def main():
+    path = Path(sys.argv[1])
+    payload = json.loads(path.read_text())
+    try:
+        _sources()
+        if not payload["parse_only"]:
+            _validate_gold(payload["reference"])
+        if DOCKER is None:
+            raise RuntimeError("Docker is unavailable")
+        subprocess.run(
+            [DOCKER, "image", "inspect", IMAGE], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
+        )
+        parsed_file = path.parent / "parsed.json"
+        reference = (
+            "from eval.graders.verifyit_hmmt import _trusted_check\n"
+            "def _verifyit_check(candidate):\n"
+            f'    _trusted_check(candidate, {payload["raw"]!r}, {payload["reference"]!r}, {payload["list_answer"]!r}, {str(parsed_file)!r}, {payload["parse_only"]!r})\n'
+            "_verifyit_check(parse)\n"
+        )
+        passed = score(reference, PARSER_PROGRAM, payload["name"], image=IMAGE)
+        parsed = (
+            json.loads(parsed_file.read_text()) if parsed_file.exists() else {"node": {"kind": "none"}, "output": None}
+        )
+        verdict = {
+            "status": "scored",
+            "reward": float(passed),
+            "detail": {
+                "parsed": parsed["node"],
+                "output": parsed["output"],
+                "phase": "parse" if payload["parse_only"] else "compare",
+                "image": IMAGE,
+            },
+        }
+    except InvalidTask as error:
+        verdict = {"status": "invalid_task", "reward": 0.0, "detail": {"error": str(error)}}
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(verdict, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
