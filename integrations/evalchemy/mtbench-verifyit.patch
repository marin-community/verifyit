+"""MTBench score scales, complete match populations and failed-judge artifacts."""
+
+from dataclasses import replace
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import importlib
+import json
+from pathlib import Path
+import threading
+
+import pytest
+from verifyit.grade import InvalidTask
+
+from eval.graders.verifyit_mtbench import evaluate
+
+
+@pytest.fixture
+def matches(monkeypatch):
+    directory = Path(__file__).resolve().parents[2] / "eval/chat_benchmarks/MTBench"
+    monkeypatch.syspath_prepend(str(directory))
+    source = importlib.import_module("fastchat.llm_judge.common")
+    generation = importlib.import_module("fastchat.llm_judge.gen_judgment")
+    prompts = source.load_judge_prompts(directory / "fastchat/llm_judge/data/judge_prompts.jsonl")
+    judges = generation.make_judge_single("gpt-4o-mini-2024-07-18", prompts)
+    question = {"question_id": 1, "category": "writing", "turns": ["Question one", "Question two"]}
+    answer = {"choices": [{"turns": ["Answer one", "Answer two"]}]}
+    return [
+        source.MatchSingle(question, "fixture", answer, judges["default"]),
+        source.MatchSingle(question, "fixture", answer, judges["default-mt"], multi_turn=True),
+    ]
+
+
+@pytest.fixture
+def judge_server(monkeypatch):
+    responses = ["[7.5]", "[[10]]"]
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            self.rfile.read(int(self.headers["Content-Length"]))
+            data = json.dumps(
+                {"choices": [{"finish_reason": "stop", "message": {"content": responses.pop(0)}}]}
+            ).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    monkeypatch.setenv("OPENAI_API_KEY", "fixture")
+    monkeypatch.setenv("OPENAI_BASE_URL", f"http://127.0.0.1:{server.server_port}/v1")
+    try:
+        yield responses
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+def test_fractional_source_rating_and_turn_aggregates(matches, judge_server, tmp_path):
+    output = tmp_path / "judgments.jsonl"
+    result = evaluate(matches, "fixture", 1, output)
+    assert result == {"Turn 1": 7.5, "Turn 2": 10, "Average": 8.75}
+    assert [json.loads(line)["score"] for line in output.read_text().splitlines()] == [7.5, 10]
+
+
+def test_missing_turn_counterpart_rejects_biased_population(matches, tmp_path):
+    second_question = {**matches[1].question, "question_id": 2}
+    incomplete = [matches[0], replace(matches[1], question=second_question)]
+    output = tmp_path / "judgments.jsonl"
+    output.write_text('{"score":10}\n')
+    with pytest.raises(InvalidTask):
+        evaluate(incomplete, "fixture", 1, output)
+    assert not output.exists()
+
+
+def test_failed_judge_aborts_after_success_and_removes_stale_results(matches, judge_server, tmp_path):
+    judge_server[:] = ["[[10]]", "No rating available"]
+    output = tmp_path / "judgments.jsonl"
+    output.write_text('{"score":10}\n')
+    with pytest.raises(RuntimeError):
+        evaluate(matches, "fixture", 1, output)
+    assert not output.exists()
+
+
+def test_blank_candidate_receives_minimum_despite_positive_judge(matches, judge_server, tmp_path):
+    answers = {"choices": [{"turns": ["", "Answer two"]}]}
+    inputs = [replace(match, answer=answers) for match in matches]
+    result = evaluate(inputs, "fixture", 1, tmp_path / "judgments.jsonl")
+    assert result == {"Turn 1": 1, "Turn 2": 10, "Average": 5.5}
