+"""Actual Alpaca Script grading with a local one-token judge fixture.
+
+The source benchmark's cached reference dataset and GLM assets are required.
+No remote model is called.
+"""
+
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import importlib
+import json
+import math
+from pathlib import Path
+import random
+import threading
+
+import pytest
+from verifyit.grade import InvalidTask
+
+from eval.graders import verifyit_alpaca as adapter
+
+
+@pytest.fixture
+def batch(monkeypatch):
+    directory = Path(__file__).resolve().parents[2] / "eval/chat_benchmarks/alpaca_eval/src"
+    monkeypatch.syspath_prepend(str(directory))
+    monkeypatch.setenv("IS_ALPACA_EVAL_2", "True")
+    constants = importlib.import_module("alpaca_eval.constants")
+    monkeypatch.setattr(constants, "IS_ALPACA_EVAL_2", True)
+    data = constants.ALPACAEVAL_REFERENCE_OUTPUTS()
+    indices = sorted(random.Random(20261001).sample(range(len(data)), 20))
+    rows = [
+        {
+            "instruction": data[i]["instruction"],
+            "dataset": data[i]["dataset"],
+            "datasplit": "eval",
+            "generator": "verifyit-test",
+            "output": f"Candidate response {i}.",
+        }
+        for i in indices
+    ]
+    return {"model_identifier": "verifyit-test", "model_outputs": rows}
+
+
+@pytest.fixture
+def judge(monkeypatch):
+    settings = {"fault": None, "requests": 0}
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            self.rfile.read(int(self.headers["Content-Length"]))
+            settings["requests"] += 1
+            token = {
+                "token": "m",
+                "logprob": math.log(0.2),
+                "bytes": [109],
+                "top_logprobs": [{"token": "m", "logprob": math.log(0.2)}, {"token": "M", "logprob": math.log(0.8)}],
+            }
+            choice = {
+                "index": 0,
+                "finish_reason": "length",
+                "message": {"role": "assistant", "content": "m"},
+                "logprobs": {"content": [token]},
+            }
+            # Permit one genuine success before the malformed completion.
+            if settings["requests"] == 2:
+                if settings["fault"] == "missing_token":
+                    token.pop("token")
+                elif settings["fault"] == "missing_logprobs":
+                    choice.pop("logprobs")
+                elif settings["fault"] == "refusal":
+                    choice["message"]["refusal"] = "Cannot judge"
+            data = json.dumps(
+                {
+                    "id": "fixture",
+                    "object": "chat.completion",
+                    "created": 0,
+                    "model": "fixture",
+                    "choices": [choice],
+                    "usage": {"prompt_tokens": 10, "completion_tokens": 1, "total_tokens": 11},
+                }
+            ).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    monkeypatch.setenv("OPENAI_API_KEY", "fixture")
+    monkeypatch.setenv("OPENAI_BASE_URL", f"http://127.0.0.1:{server.server_port}/v1")
+    try:
+        yield settings
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+@pytest.fixture
+def verdicts(monkeypatch):
+    observed = []
+    original = adapter.run
+
+    def run(*args, **kwargs):
+        result = original(*args, **kwargs)
+        observed.append(result)
+        return result
+
+    monkeypatch.setattr(adapter, "run", run)
+    return observed
+
+
+def test_one_token_length_completion_preserves_source_probability(batch, judge, verdicts):
+    result = adapter.evaluate("weighted_alpaca_eval_gpt4_turbo", batch)
+    assert judge["requests"] == 20
+    annotations = verdicts[0].detail["annotations"]
+    expected = sum(row["preference"] - 1 for row in annotations) / len(annotations) * 100
+    assert result["win_rate"] == pytest.approx(expected)
+    assert verdicts[0].reward == result["win_rate"] / 100
+
+
+@pytest.mark.parametrize("fault", ["missing_token", "missing_logprobs", "refusal"])
+def test_malformed_judge_aborts_entire_batch_without_advancing_rng(batch, judge, verdicts, fault):
+    judge["fault"] = fault
+    before = random.getstate()
+    with pytest.raises(RuntimeError):
+        adapter.evaluate("weighted_alpaca_eval_gpt4_turbo", batch)
+    assert random.getstate() == before
+    assert verdicts[0].status.value == "infra_error"
+    assert verdicts[0].reward == 0
+
+
+def test_all_blank_overrides_positive_regularized_length_prediction(batch, judge, verdicts):
+    for row in batch["model_outputs"]:
+        row["output"] = ""
+    result = adapter.evaluate("weighted_alpaca_eval_gpt4_turbo", batch)
+    assert result["win_rate"] == result["discrete_win_rate"] == result["length_controlled_winrate"] == 0
+    detail = verdicts[0].detail
+    assert detail["all_blank_source_predictions"]["length_controlled_winrate"] > 0
+    assert all(row["preference"] == 1 for row in detail["annotations"])
+
+
+def test_mixed_blank_preserves_source_aggregation_after_minimum_correction(batch, judge, verdicts):
+    batch["model_outputs"][0]["output"] = ""
+    result = adapter.evaluate("weighted_alpaca_eval_gpt4_turbo", batch)
+    annotations = verdicts[0].detail["annotations"]
+    assert next(row for row in annotations if not row["output_2"])["preference"] == 1
+    assert result["win_rate"] == pytest.approx(sum(row["preference"] - 1 for row in annotations) * 5)
+    assert verdicts[0].detail["all_blank_source_predictions"] == {}
+
+
+def test_missing_trusted_reference_is_invalid_task_before_judge(batch, judge, verdicts):
+    batch["model_outputs"][0]["instruction"] = "Unmatched fixture instruction"
+    with pytest.raises(InvalidTask):
+        adapter.evaluate("weighted_alpaca_eval_gpt4_turbo", batch)
+    assert judge["requests"] == 0
+    assert verdicts[0].status.value == "invalid_task"
