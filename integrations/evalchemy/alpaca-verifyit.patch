+def _directory():
+    return Path(__file__).resolve().parents[1] / "chat_benchmarks/alpaca_eval/src/alpaca_eval"
+
+
+def _validate_source():
+    directory = _directory()
+    for name, expected in SOURCE_HASHES.items():
+        if hashlib.sha256((directory / name).read_bytes()).hexdigest() != expected:
+            raise InvalidTask("Alpaca source scoring contract changed")
+
+
+def _validate(config, results):
+    if config not in CONFIGS:
+        raise InvalidTask("Unregistered Alpaca annotator configuration")
+    rows = results.get("model_outputs")
+    model = results.get("model_identifier")
+    if not isinstance(rows, list) or not rows or not isinstance(model, str) or not model.strip():
+        raise InvalidTask("Alpaca requires a named model and response rows")
+    instructions = []
+    for row in rows:
+        if not isinstance(row, dict) or not isinstance(row.get("instruction"), str) or not row["instruction"].strip():
+            raise InvalidTask("Alpaca requires nonempty trusted instructions")
+        if row.get("generator") != model or not isinstance(row.get("output"), str):
+            raise InvalidTask("Alpaca requires aligned textual model responses")
+        instructions.append(row["instruction"])
+    if len(set(instructions)) != len(instructions):
+        raise InvalidTask("Alpaca instructions must be unique")
+    total = results.get("total_examples", rows)
+    if not isinstance(total, list) or len(total) < len(rows):
+        raise InvalidTask("Alpaca completion denominator must include every response")
+
+
+def evaluate(config, results):
+    _validate_source()
+    _validate(config, results)
+    constants = importlib.import_module("alpaca_eval.constants")
+    payload = {
+        "config": config,
+        "results": results,
+        "ae2": constants.IS_ALPACA_EVAL_2,
+        "random_state": random.getstate(),
+    }
+    with tempfile.TemporaryDirectory(prefix="verifyit-alpaca-") as directory:
+        root = Path(directory)
+        (root / "input.json").write_text(json.dumps(payload, allow_nan=False))
+        (root / "run.sh").write_text('exec "$@"\n')
+        specification = ScriptSpec(
+            "run.sh",
+            args=(sys.executable, "-m", "eval.graders.verifyit_alpaca", str(root / "input.json")),
+            timeout=900,
+            verdict_file="result.json",
+        )
+        (root / "verifier.toml").write_text(render_spec(specification))
+        verdict = run(root / "verifier.toml", root)
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(str(verdict.detail))
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"Alpaca verifier failed: {verdict.status}: {verdict.detail}")
+    metrics = verdict.detail["metrics"]
+    _validate_metrics(metrics, len(results["model_outputs"]), payload["ae2"])
+    if verdict.reward != metrics["win_rate"] / 100:
+        raise RuntimeError("Alpaca reward differs from source win rate")
+    state = _state(verdict.detail["random_state"])
+    random.setstate(state)
+    return metrics
+
+
+def _validate_metrics(metrics, count, ae2):
+    required = {"win_rate", "standard_error", "discrete_win_rate", "n_total"}
+    if ae2:
+        required.update({"length_controlled_winrate", "lc_standard_error"})
+    if not isinstance(metrics, dict) or not required <= metrics.keys() or metrics["n_total"] != count:
+        raise RuntimeError("Alpaca returned incomplete metrics")
+    for name in required:
+        value = metrics[name]
+        if not isinstance(value, Real) or isinstance(value, bool) or not math.isfinite(value) or value < 0:
+            raise RuntimeError("Alpaca computed metric is nonfinite or invalid")
+    for name in ("win_rate", "discrete_win_rate", *(["length_controlled_winrate"] if ae2 else [])):
+        if metrics[name] > 100:
+            raise RuntimeError("Alpaca win rate is outside its source scale")
+
+
+def _completion(raw, kwargs):
+    response = json.loads(raw.http_response.text, object_pairs_hook=unique_object)
+    json.dumps(response, allow_nan=False)
+    if not isinstance(response, dict) or response.get("error"):
+        raise RuntimeError("Alpaca judge transport returned an error")
+    choices = response.get("choices")
+    if not isinstance(choices, list) or len(choices) != 1:
+        raise RuntimeError("Alpaca requires one judge completion")
+    choice = choices[0]
+    message = choice.get("message")
+    if (
+        not isinstance(message, dict)
+        or message.get("refusal")
+        or message.get("tool_calls")
+        or message.get("function_call")
+        or not isinstance(message.get("content"), str)
+    ):
+        raise RuntimeError("Alpaca judge refused or returned no text")
+    if kwargs.get("logprobs"):
+        if kwargs.get("max_tokens") != 1 or choice.get("finish_reason") not in {"length", "stop"}:
+            raise RuntimeError("Alpaca weighted classifier did not complete its one-token contract")
+        tokens = choice.get("logprobs", {}).get("content")
+        if not isinstance(tokens, list) or len(tokens) != 1:
+            raise RuntimeError("Alpaca weighted classifier requires one token's logprobs")
+        token = tokens[0]
+        if (
+            not isinstance(token, dict)
+            or not isinstance(token.get("token"), str)
+            or not token["token"]
+            or message["content"] != token["token"]
+            or type(token.get("logprob")) not in (int, float)
+            or not math.isfinite(token["logprob"])
+            or token["logprob"] > 0
+        ):
+            raise RuntimeError("Alpaca weighted classifier omitted its complete token observation")
+        alternatives = token.get("top_logprobs")
+        if not isinstance(alternatives, list) or not alternatives:
+            raise RuntimeError("Alpaca weighted classifier omitted alternatives")
+        names = []
+        for alternative in alternatives:
+            if (
+                not isinstance(alternative, dict)
+                or not isinstance(alternative.get("token"), str)
+                or type(alternative.get("logprob")) not in (int, float)
+                or not math.isfinite(alternative["logprob"])
+                or alternative["logprob"] > 0
+            ):
+                raise RuntimeError("Alpaca weighted classifier has invalid logprobs")
+            names.append(alternative["token"])
+        if len(set(names)) != len(names) or not {"m", "M"}.intersection(names):
+            raise RuntimeError("Alpaca weighted classifier has no usable preference alternatives")
+    elif choice.get("finish_reason") != "stop":
+        raise RuntimeError("Alpaca ranking judge returned an incomplete completion")
+    return raw.parse()
+
+
+def _install_transport(source_utils):
+    original = source_utils.get_all_clients
+
+    def clients(*args, **kwargs):
+        values = original(*args, **kwargs)
+        for client in values:
+            raw_create = client.chat.completions.with_raw_response.create
+
+            def create(*, _raw_create=raw_create, **request):
+                return _completion(_raw_create(**request), request)
+
+            client.chat.completions.create = create
+        return values
+
+    source_utils.get_all_clients = clients
+
+
+def _install_annotations(annotators, rows):
+    original = annotators.PairwiseAnnotator.annotate_head2head
+    expected = {row["instruction"]: row["output"] for row in rows}
+
+    def annotate(self, *args, **kwargs):
+        result = original(self, *args, **kwargs)
+        if not isinstance(result, list) or len(result) != len(rows):
+            raise RuntimeError("Alpaca dropped or duplicated annotations")
+        observed = []
+        for row in result:
+            instruction = row.get("instruction")
+            if instruction not in expected or row.get("output_2") != expected[instruction]:
+                raise RuntimeError("Alpaca annotations do not match current responses")
+            if not isinstance(row.get("output_1"), str) or not row["output_1"].strip():
+                raise InvalidTask("Alpaca trusted reference output is empty")
+            preference = row.get("preference")
+            if (
+                not isinstance(preference, Real)
+                or isinstance(preference, bool)
+                or not math.isfinite(preference)
+                or preference not in [0]
+                and not 1 <= preference <= 2
+            ):
+                raise RuntimeError("Alpaca returned an invalid preference")
+            if not row["output_2"].strip():
+                row["preference"] = 1
+            observed.append(instruction)
+        if len(set(observed)) != len(expected):
+            raise RuntimeError("Alpaca annotations do not cover the complete response batch")
