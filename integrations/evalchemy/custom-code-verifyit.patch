diff --git a/eval/graders/verifyit_code.py b/eval/graders/verifyit_code.py
new file mode 100644
--- /dev/null
+++ b/eval/graders/verifyit_code.py
@@ -0,0 +1,234 @@
+"""Source-compatible code metrics with trusted tests outside candidate containers."""
+
+import ast
+import json
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import uuid
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.spec import ScriptSpec, render_spec
+from lm_eval.verifyit_humaneval import entry_point, score as score_python
+from eval.contracts.sample_results import PER_TASK_PASS_RATE_FIELD
+from eval.passk import estimate_pass_at_k
+
+IMAGE = "sha256:c65c33e0fdd600e418f020d233aca4178c79c3a3208657f51a31dfc77c2c22f3"
+DOCKER = shutil.which("docker")
+PRELUDE = "\n".join(
+    [
+        "import math",
+        "import re",
+        "import sys",
+        "import copy",
+        "import datetime",
+        "import itertools",
+        "import collections",
+        "import heapq",
+        "import functools",
+        "import hashlib",
+        "import numpy",
+        "import numpy as np",
+        "import string",
+        "from typing import *",
+        "from collections import *",
+    ]
+)
+
+
+def python_reference(problem, is_mbpp, example_test=False):
+    if is_mbpp:
+        tests = problem.get("test")
+        canonical = problem.get("code")
+        if (
+            not isinstance(tests, list)
+            or not tests
+            or any(not isinstance(x, str) or not x.strip() for x in tests)
+            or not isinstance(canonical, str)
+        ):
+            raise InvalidTask("MBPP requires trusted canonical code and nonempty tests")
+        test = "\n".join(tests)
+        tree = ast.parse(canonical)
+        names = {n.name for n in tree.body if isinstance(n, ast.FunctionDef)}
+        calls = {
+            n.func.id for n in ast.walk(ast.parse(test)) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
+        }
+        entries = names & calls
+        if len(entries) != 1:
+            raise InvalidTask("MBPP tests require one candidate entry point")
+        entry = next(iter(entries))
+        context = ast.Module(
+            body=[n for n in tree.body if not isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))], type_ignores=[]
+        )
+        return (
+            ast.unparse(context)
+            + "\n\ndef _verifyit_check("
+            + entry
+            + "):\n"
+            + "".join("    " + line + "\n" for line in test.splitlines())
+            + "\n_verifyit_check("
+            + entry
+            + ")"
+        )
+    test = problem.get("example_test") if example_test and problem.get("example_test") else problem.get("test")
+    if not isinstance(test, str) or not test.strip():
+        raise InvalidTask("HumanEval requires nonempty trusted tests")
+    entry = entry_point(test)
+    prompt = problem.get("prompt")
+    if not isinstance(prompt, str):
+        raise InvalidTask("HumanEval requires its trusted prompt")
+    tree = ast.parse(prompt)
+    helpers = ast.Module(
+        body=[n for n in tree.body if not isinstance(n, ast.FunctionDef) or n.name != entry], type_ignores=[]
+    )
+    return PRELUDE + "\n" + ast.unparse(helpers) + "\n" + test
+
+
+def grade_completion(problem, generation, *, language, is_mbpp, timeout, example_test=False):
+    if not isinstance(generation, str):
+        raise InvalidTask("Code completion must be a string")
+    if language not in ("python", "sh"):
+        raise InvalidTask("This source installation provides Python and shell contracts")
+    if not isinstance(timeout, (int, float)) or isinstance(timeout, bool) or not 0 < timeout <= 300:
+        raise InvalidTask("Invalid code timeout")
+    reference = python_reference(problem, is_mbpp, example_test) if language == "python" else problem.get("test")
+    if language == "python" and not is_mbpp:
+        generation = PRELUDE + "\n" + generation
+    name = "verifyit-code-" + uuid.uuid4().hex
+    try:
+        with tempfile.TemporaryDirectory(prefix="verifyit-code-") as directory:
+            tests = Path(directory)
+            payload = tests / "input.json"
+            payload.write_text(
+                json.dumps(
+                    {
+                        "reference": reference,
+                        "generation": generation,
+                        "problem": problem,
+                        "language": language,
+                        "name": name,
+                        "timeout": timeout,
+                    }
+                )
+            )
+            (tests / "run.sh").write_text('exec "$@"\n')
+            spec = ScriptSpec(
+                "run.sh",
+                args=(sys.executable, "-m", "eval.graders.verifyit_code", str(payload)),
+                timeout=timeout + 20,
+                verdict_file="result.json",
+            )
+            config = tests / "verifier.toml"
+            config.write_text(render_spec(spec))
+            verdict = run(config, tests)
+    finally:
+        if DOCKER:
+            subprocess.run([DOCKER, "rm", "-f", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(str(verdict.detail))
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"Code verifier failed: {verdict.status}: {verdict.detail}")
+    return bool(verdict.reward)
+
+
+def evaluate_functional_correctness(
+    input_file=None,
+    tmp_dir="./",
+    n_workers=32,
+    timeout=10.0,
+    problem_file=None,
+    out_dir=None,
+    k=(1, 10, 100),
+    test_groundtruth=False,
+    example_test=False,
+    is_mbpp=False,
+    language="python",
+):
+    if test_groundtruth or out_dir is not None:
+        raise InvalidTask("Code grading requires a completion file without output side effects")
+    if DOCKER is None:
+        raise RuntimeError("Docker executable unavailable")
+    subprocess.run(
+        [DOCKER, "image", "inspect", IMAGE],
+        check=True,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        timeout=10,
+    )
+    problems = {}
+    for line in Path(problem_file).read_text().splitlines():
+        if not line.strip():
+            continue
+        row = json.loads(line)
+        identifier = row["task_id"]
+        if identifier in problems:
+            raise InvalidTask("Duplicate trusted task ID")
+        problems[identifier] = row
+    samples = [json.loads(line) for line in Path(input_file).read_text().splitlines() if line.strip()]
+    if not samples:
+        raise InvalidTask("Code evaluation requires completions")
+    results = defaultdict(list)
+    for sample in samples:
+        identifier = sample.get("task_id")
+        if identifier not in problems:
+            raise InvalidTask("Unknown code task ID")
+        result = grade_completion(
+            problems[identifier],
+            sample.get("generation"),
+            language=language,
+            is_mbpp=is_mbpp,
+            timeout=timeout,
+            example_test=example_test,
+        )
+        results[identifier].append(result)
+    total = np.array([len(values) for values in results.values()])
+    correct = np.array([sum(values) for values in results.values()])
+    if not isinstance(k, (list, tuple)) or not k or any(type(x) is not int or x < 1 for x in k):
+        raise InvalidTask("pass@k requires positive integer k values")
+    metrics = {
+        f"pass@{value}": estimate_pass_at_k(total, correct, value).mean() for value in k if (total >= value).all()
+    }
+    metrics[PER_TASK_PASS_RATE_FIELD] = {
+        identifier: sum(values) / len(values) for identifier, values in results.items()
+    }
+    return metrics
+
+
+def main():
+    payload = json.loads(Path(sys.argv[1]).read_text())
+    try:
+        if payload["language"] == "python":
+
+            def expired(signum, frame):
+                raise TimeoutError("Candidate execution deadline exceeded")
+
+            signal.signal(signal.SIGALRM, expired)
+            signal.setitimer(signal.ITIMER_REAL, payload["timeout"])
+            try:
+                passed = score_python(payload["reference"], payload["generation"], payload["name"], image=IMAGE)
+            except TimeoutError:
+                passed = False
+            finally:
+                signal.setitimer(signal.ITIMER_REAL, 0)
+        else:
+            from eval.graders.verifyit_shell import score_shell
+
+            passed = score_shell(payload["problem"], payload["generation"], payload["name"], IMAGE, payload["timeout"])
+        verdict = {
+            "status": "scored",
+            "reward": float(passed),
+            "detail": {"image": IMAGE, "language": payload["language"]},
+        }
+    except InvalidTask as error:
+        verdict = {"status": "invalid_task", "reward": 0, "detail": {"error": str(error)}}
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(verdict, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
