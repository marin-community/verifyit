@@ -0,0 +1,53 @@
+"""Source code contracts through verifyit's isolated ScriptSpec grading."""
+
+import json
+import subprocess
+from pathlib import Path
+import pytest
+from eval.graders.verifyit_code import DOCKER, IMAGE, evaluate_functional_correctness, grade_completion
+from verifyit.grade import InvalidTask
+
+
+@pytest.fixture(scope="module", autouse=True)
+def candidate_image():
+    if DOCKER is None:
+        pytest.skip("Docker is required for isolated code grading")
+    result = subprocess.run([DOCKER, "image", "inspect", IMAGE], capture_output=True, timeout=10)
+    if result.returncode:
+        pytest.skip("Build the pinned verifyit code image before running these tests")
+
+
+@pytest.fixture(scope="module")
+def mbpp():
+    path = Path(__file__).resolve().parents[2] / "eval/chat_benchmarks/MBPP/data/mbpp_test.jsonl"
+    return {row["task_id"]: row for row in map(json.loads, path.read_text().splitlines())}
+
+
+@pytest.mark.parametrize("identifier", [40, 88, 115, 124, 341, 473, 490, 56, 349])
+def test_source_value_types_and_check_named_candidates(mbpp, identifier):
+    row = mbpp[identifier]
+    assert grade_completion(row, row["code"], language="python", is_mbpp=True, timeout=10)
+
+
+def test_invalid_reference_aborts_after_valid_sample(mbpp, tmp_path):
+    problems = tmp_path / "problems.jsonl"
+    samples = tmp_path / "samples.jsonl"
+    problems.write_text("".join(json.dumps(mbpp[i]) + "\n" for i in [81, 367]))
+    samples.write_text("".join(json.dumps({"task_id": i, "generation": mbpp[i]["code"]}) + "\n" for i in [81, 367]))
+    with pytest.raises(InvalidTask, match="Trusted reference failed"):
+        evaluate_functional_correctness(input_file=samples, problem_file=problems, is_mbpp=True)
+
+
+@pytest.mark.parametrize(
+    "body,expected",
+    [("print('ordinary output'); return x + 1", True), ("return None", False), ("while True: pass", False)],
+)
+def test_candidate_output_wrong_type_and_timeout(body, expected):
+    problem = {
+        "prompt": "def example(x):\n    pass\n",
+        "test": "def check(candidate):\n    assert candidate(1) == 2\ncheck(example)",
+    }
+    assert (
+        grade_completion(problem, "def example(x):\n    " + body, language="python", is_mbpp=False, timeout=3)
+        is expected
+    )
