@@ -0,0 +1,29 @@
+"""Container-only shell function worker with no test visibility."""
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+def main():
+    request = json.loads(sys.stdin.buffer.readline(1048577))
+    path = Path("/tmp/candidate.sh")
+    path.write_text(request["code"])
+    print(json.dumps({"ready": True}), flush=True)
+    for line in sys.stdin.buffer:
+        call = json.loads(line)
+        try:
+            result = subprocess.run(
+                ["bash", "-c", 'source /tmp/candidate.sh; "$@"', "--", request["entry"], *call["args"]],
+                capture_output=True,
+                timeout=request["timeout"],
+            )
+            answer = {"stdout": result.stdout.decode("utf-8"), "returncode": result.returncode}
+        except (subprocess.TimeoutExpired, UnicodeDecodeError):
+            answer = {"stdout": "", "returncode": 1}
+        print(json.dumps(answer), flush=True)
+
+
+if __name__ == "__main__":
+    main()
