+++ b/eval/graders/verifyit_shell.py
@@ -0,0 +1,106 @@
+"""Run trusted shell assertions against a separate candidate container."""
+
+import json
+import re
+import shlex
+import shutil
+import socketserver
+import subprocess
+import sys
+import tempfile
+import threading
+from pathlib import Path
+
+from verifyit.grade import InvalidTask
+from lm_eval.verifyit_function_worker import read, write
+
+DOCKER = shutil.which("docker")
+
+
+def score_shell(problem, generation, name, image, timeout):
+    prompt = problem.get("prompt")
+    test = problem.get("test")
+    if not isinstance(prompt, str) or not isinstance(test, str) or not test.startswith("}\n"):
+        raise InvalidTask("Shell reference must close the source function before tests")
+    match = re.search(r"([A-Za-z_][A-Za-z_0-9]*)\(\)\s*\{\s*$", prompt)
+    if match is None:
+        raise InvalidTask("Shell prompt has no source function entry point")
+    entry = match.group(1)
+    worker = Path(__file__).with_name("verifyit_shell_worker.py")
+    proxy = Path(__file__).with_name("verifyit_shell_proxy.py")
+    process = subprocess.Popen(
+        [
+            DOCKER,
+            "run",
+            "--rm",
+            "-i",
+            "--name",
+            name,
+            "--network",
+            "none",
+            "--read-only",
+            "--pids-limit",
+            "64",
+            "--memory",
+            "256m",
+            "--cpus",
+            "1",
+            "--cap-drop",
+            "ALL",
+            "--security-opt",
+            "no-new-privileges",
+            "--user",
+            "65534:65534",
+            "--tmpfs",
+            "/tmp:rw,noexec,nosuid,size=16m",
+            "--mount",
+            f"type=bind,source={worker},target=/worker.py,readonly",
+            image,
+            "python",
+            "-I",
+            "/worker.py",
+        ],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.DEVNULL,
+    )
+    calls = [0]
+    try:
+        write(process.stdin, {"code": generation + "}\n", "entry": entry, "timeout": timeout})
+        if read(process.stdout) != {"ready": True}:
+            raise RuntimeError("Shell worker did not initialize")
+        with tempfile.TemporaryDirectory(prefix="verifyit-shell-") as directory:
+            path = Path(directory)
+            address = str(path / "rpc.sock")
+
+            class Handler(socketserver.StreamRequestHandler):
+                def handle(self):
+                    calls[0] += 1
+                    try:
+                        request = json.loads(self.rfile.readline(1048577))
+                        write(process.stdin, request)
+                        result = read(process.stdout)
+                    except (ValueError, BrokenPipeError, EOFError):
+                        result = {"stdout": "", "returncode": 1}
+                    self.wfile.write(json.dumps(result).encode() + b"\n")
+
+            with socketserver.UnixStreamServer(address, Handler) as server:
+                thread = threading.Thread(target=server.serve_forever, daemon=True)
+                thread.start()
+                try:
+                    invocation = shlex.join([sys.executable, str(proxy), address])
+                    script = path / "tests.sh"
+                    script.write_text(entry + "() { " + invocation + ' "$@"; }\n' + test[2:])
+                    try:
+                        result = subprocess.run(["bash", str(script)], capture_output=True, timeout=timeout)
+                    except subprocess.TimeoutExpired:
+                        return False
+                    if not calls[0]:
+                        raise InvalidTask("Shell trusted tests made no candidate calls")
+                    return result.returncode == 0
+                finally:
+                    server.shutdown()
+                    thread.join(timeout=2)
+    finally:
+        subprocess.run([DOCKER, "rm", "-f", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+        process.wait(timeout=10)
