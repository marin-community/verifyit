+"""Zeroeval source scoring with isolated numeric-expression normalization."""
+
+import hashlib
+import importlib
+import inspect
+import json
+import math
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+import uuid
+
+from lm_eval.verifyit_humaneval import DOCKER, IMAGE, score
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.spec import ScriptSpec, render_spec
+
+TASKS = {"numersense-v2", "math-l5", "crux", "gsm", "mmlu-redux"}
+NUMERIC_TASKS = {"numersense-v2", "math-l5"}
+SOURCE_HASHES = {
+    "math_eval.py": "8b1466bbff3f9b9ce83422904fac5de70e1583a9d9d04c06af9c4402b4be9391",
+    "crux_eval.py": "f012017663d248804e9c47bee2c0fcdaebcc82c560cdeb4bb9c83a42be5e38fc",
+    "eval_utils.py": "b74fd2979f5c423760c41034f66904aa59b951f747c07e32e42611d394285f3d",
+}
+NUMBER = re.compile(r"-?\d+(\.\d+)?")
+
+
+def _source(task):
+    directory = Path(__file__).resolve().parents[1] / "chat_benchmarks/zeroeval/src/evaluation"
+    for name, expected in SOURCE_HASHES.items():
+        if hashlib.sha256((directory / name).read_bytes()).hexdigest() != expected:
+            raise InvalidTask("Zeroeval source scorer changed")
+    name = "math_eval" if task in NUMERIC_TASKS else "crux_eval"
+    return importlib.import_module("eval.chat_benchmarks.zeroeval.src.evaluation." + name)
+
+
+def _validate(task, rows):
+    if task not in TASKS:
+        raise InvalidTask("Zeroeval task has no validated source adapter")
+    if not isinstance(rows, list) or not rows:
+        raise InvalidTask("Zeroeval task must contain samples")
+    for row in rows:
+        if not isinstance(row, dict) or "answer" not in row:
+            raise InvalidTask("Zeroeval requires trusted answer metadata")
+        if task in NUMERIC_TASKS and (not isinstance(row["answer"], str) or not row["answer"].strip()):
+            raise InvalidTask("Zeroeval numeric reference must be nonempty text")
+        if not isinstance(row.get("output"), list) or len(row["output"]) != 1 or not isinstance(row["output"][0], str):
+            raise InvalidTask("Zeroeval requires one textual candidate per sample")
+
+
+def evaluate(tasks, results):
+    temporary = results.get("temp_dir_obj")
+    try:
+        if not isinstance(tasks, list) or not tasks or len(set(tasks)) != len(tasks):
+            raise InvalidTask("Zeroeval task selection must be nonempty and unique")
+        if set(results) != set(tasks) | {"temp_dir_obj"}:
+            raise InvalidTask("Zeroeval requires every selected task result")
+        prepared = {}
+        for task in tasks:
+            rows = json.loads(Path(results[task]).read_text())
+            _validate(task, rows)
+            _source(task)
+            prepared[task] = rows
+        metrics = {}
+        for task, rows in prepared.items():
+            result = grade_batch(task, rows)
+            metrics[task] = float(result["Acc"])
+            metrics[f"{task}_no_answer"] = float(result["No answer"])
+            metrics[f"{task}_reason_lens"] = float(result["Reason Lens"])
+        return metrics
+    finally:
+        if temporary is not None:
+            temporary.cleanup()
+
+
+def grade_batch(task, rows):
+    name = "verifyit-zeroeval-" + uuid.uuid4().hex
+    try:
+        with tempfile.TemporaryDirectory(prefix="verifyit-zeroeval-") as directory:
+            root = Path(directory)
+            (root / "input.json").write_text(json.dumps({"task": task, "rows": rows, "name": name}, allow_nan=False))
+            (root / "run.sh").write_text('exec "$@"\n')
+            specification = ScriptSpec(
+                "run.sh",
+                args=(sys.executable, "-m", "eval.graders.verifyit_zeroeval", str(root / "input.json")),
+                timeout=120,
+                verdict_file="result.json",
+            )
+            (root / "verifier.toml").write_text(render_spec(specification))
+            verdict = run(root / "verifier.toml", root)
+        if verdict.status == Status.INVALID_TASK:
+            raise InvalidTask(str(verdict.detail))
+        if verdict.status != Status.SCORED:
+            raise RuntimeError(f"Zeroeval verifier failed: {verdict.status}")
+        result = verdict.detail["result"]
+        if verdict.reward != float(result["Acc"]) / 100:
+            raise RuntimeError("Zeroeval aggregate and reward disagree")
+        return result
+    finally:
+        if task in NUMERIC_TASKS and DOCKER is not None:
+            subprocess.run([DOCKER, "rm", "-f", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+
+def _numeric_source(candidate, task, rows, output):
+    source = _source(task)
+    trusted_normalize = source.sanitize_math_answers
+    calls = 0
+
+    def normalize(value):
+        nonlocal calls
+        calls += 1
+        # The pinned source normalizes candidate then trusted reference for each parsed row.
+        # Reference values never enter the candidate expression runtime.
+        return candidate(value) if calls % 2 else trusted_normalize(value)
+
+    source.sanitize_math_answers = normalize
+    _source_result(source, rows, output)
+
+
+def _all_missing(source, rows):
+    missing = []
+    for row in rows:
+        prediction = source.extract_first_complete_json(row["output"][0])
+        if prediction is None or "answer" not in prediction:
+            prediction = source.extract_values_from_json(row["output"][0], allow_no_quotes=True)
+        missing.append(prediction is None or "answer" not in prediction)
+    return all(missing)
+
+
+def _source_result(source, rows, output):
+    path = Path(output).with_name("rows.json")
+    path.write_text(json.dumps(rows, allow_nan=False))
+    if _all_missing(source, rows):
+        # Source divides by zero in Reason Lens when no response contains an answer.
+        result = {
+            "Model": "",
+            "Mode": "",
+            "Acc": "0.00",
+            "No answer": "100.00",
+            "Total": len(rows),
+            "Reason Lens": "0.00",
+        }
+        parsed = []
+    else:
+        result, parsed = source.eval_model("%", str(path))
+    for key in ("Acc", "No answer", "Reason Lens"):
+        if not math.isfinite(float(result[key])) or float(result[key]) < 0:
+            raise RuntimeError("Zeroeval source returned an invalid aggregate")
+    Path(output).write_text(json.dumps({"result": result, "parsed": parsed}, allow_nan=False))
+
+
+def main():
+    path = Path(sys.argv[1])
+    payload = json.loads(path.read_text())
+    task, rows = payload["task"], payload["rows"]
+    try:
+        _validate(task, rows)
+        source = _source(task)
+        output = path.with_name("source-result.json")
+        if task in NUMERIC_TASKS:
+            for row in rows:
+                normalized = source.sanitize_math_answers(row["answer"].replace("#", "").strip())
+                match = NUMBER.search(normalized)
+                if match is None or not math.isfinite(float(match.group())):
+                    raise InvalidTask("Zeroeval reference must normalize to a finite number")
+        if task in NUMERIC_TASKS and not _all_missing(source, rows):
+            if DOCKER is None:
+                raise RuntimeError("Docker is unavailable")
+            subprocess.run(
+                [DOCKER, "image", "inspect", IMAGE], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
+            )
+            reference = (
+                "from eval.graders.verifyit_zeroeval import _numeric_source\n"
+                "def check(candidate):\n"
+                f"    _numeric_source(candidate, {task!r}, {rows!r}, {str(output)!r})\n"
+                "check(sanitize_math_answers)\n"
+            )
+            program = inspect.getsource(source.sanitize_math_answers)
+            if not score(reference, program, payload["name"], memory_bytes=None):
+                raise RuntimeError("Zeroeval isolated normalization failed")
+        else:
+            _source_result(source, rows, output)
+        detail = json.loads(output.read_text())
+        verdict = {"status": "scored", "reward": float(detail["result"]["Acc"]) / 100, "detail": detail}
+    except InvalidTask as error:
+        verdict = {"status": "invalid_task", "reward": 0.0, "detail": {"error": str(error)}}
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(verdict, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
