+"""Zeroeval source parity and complete-batch failure behavior."""
+
+import json
+from pathlib import Path
+import tempfile
+
+import pytest
+from verifyit.grade import InvalidTask
+
+from eval.graders.verifyit_zeroeval import evaluate, grade_batch
+
+
+def row(answer, response):
+    return {"id": "fixture", "answer": answer, "output": [response]}
+
+
+def test_fraction_normalization_and_source_first_number_contract():
+    result = grade_batch(
+        "math-l5",
+        [row("0.5", '{"answer":"1/2", "reasoning":"fraction"}'), row("2", '{"answer":"3"}')],
+    )
+    assert result["Acc"] == "50.00"
+    assert result["No answer"] == "0.00"
+    assert result["Reason Lens"] == "4.00"
+
+
+@pytest.mark.parametrize("task", ["crux", "gsm", "mmlu-redux"])
+def test_literal_dispatch_does_not_upgrade_to_math_equivalence(task):
+    result = grade_batch(task, [row("0.5", '{"answer":"1/2"}'), row("1/2", '{"answer":"1/2"}')])
+    assert result["Acc"] == "50.00"
+
+
+def test_missing_selected_task_aborts_and_cleans_up():
+    directory = tempfile.TemporaryDirectory()
+    path = Path(directory.name) / "crux.json"
+    path.write_text(json.dumps([row("2", '{"answer":"2"}')]))
+    with pytest.raises(InvalidTask):
+        evaluate(["crux", "gsm"], {"temp_dir_obj": directory, "crux": str(path)})
+    assert not Path(directory.name).exists()
+
+
+def test_invalid_numeric_reference_aborts_after_valid_task():
+    directory = tempfile.TemporaryDirectory()
+    inputs = {"temp_dir_obj": directory}
+    for task, rows in {
+        "crux": [row("2", '{"answer":"2"}')],
+        "math-l5": [row("no numeric reference", '{"answer":"2"}')],
+    }.items():
+        path = Path(directory.name) / (task + ".json")
+        path.write_text(json.dumps(rows))
+        inputs[task] = str(path)
+    with pytest.raises(InvalidTask):
+        evaluate(["crux", "math-l5"], inputs)
+    assert not Path(directory.name).exists()
+
+
+def test_all_missing_answers_cannot_emit_partial_accuracy():
+    directory = tempfile.TemporaryDirectory()
+    inputs = {"temp_dir_obj": directory}
+    for task, rows in {"crux": [row("2", '{"answer":"2"}')], "gsm": [row("2", "No answer.")]}.items():
+        path = Path(directory.name) / (task + ".json")
+        path.write_text(json.dumps(rows))
+        inputs[task] = str(path)
+    result = evaluate(["crux", "gsm"], inputs)
+    assert result["crux"] == 100.0
+    assert result["gsm"] == 0.0
+    assert result["gsm_no_answer"] == 100.0
+    assert result["gsm_reason_lens"] == 0.0
+    assert not Path(directory.name).exists()
+
+
+def test_numeric_all_missing_answers_score_zero():
+    result = grade_batch("math-l5", [row("2", "No answer.")])
+    assert result["Acc"] == "0.00"
+    assert result["No answer"] == "100.00"
+    assert result["Reason Lens"] == "0.00"
