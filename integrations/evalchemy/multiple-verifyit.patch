+"""Real compiler regressions for MultiPL-E source scoring failures."""
+
+import json
+from pathlib import Path
+import tempfile
+
+import pytest
+from verifyit.grade import InvalidTask
+
+from eval.chat_benchmarks.MultiPLE.eval_instruct import MultipleBenchmark
+
+
+@pytest.mark.parametrize(
+    "language,task_id,body,wrong,image,platform",
+    [
+        (
+            "go",
+            "mbpp_770_odd_num_sum",
+            "sum := 0; for i := 1; i <= n; i++ { x := 2*i-1; sum += x*x*x*x }; return sum\n}",
+            "return 0;\n}",
+            "verifyit-evalchemy-multiple:source-v1",
+            "linux/amd64",
+        ),
+        (
+            "cs",
+            "mbpp_14_find_Volume",
+            "return l * b * h / 2;",
+            "return 0;",
+            "verifyit-evalchemy-multiple-native:source-v1",
+            "linux/arm64",
+        ),
+        (
+            "clj",
+            "mbpp_726_multiply_elements",
+            "(mapv (fn [[a b]] (* a b)) (partition 2 1 test_tup)))",
+            "[])",
+            "verifyit-evalchemy-multiple:source-v1",
+            "linux/amd64",
+        ),
+    ],
+)
+def test_real_trusted_assertions_reject_wrong_completion(language, task_id, body, wrong, image, platform, monkeypatch):
+    root = Path(__file__).resolve().parents[2] / "eval/chat_benchmarks/MultiPLE/data"
+    tasks = json.loads((root / f"multipl-e-{language}.json").read_text())
+    task = next(row for row in tasks if row["task_id"] == task_id)
+    monkeypatch.setenv("VERIFYIT_MULTIPLE_IMAGE", image)
+    monkeypatch.setenv("VERIFYIT_MULTIPLE_PLATFORM", platform)
+    scorer = MultipleBenchmark(languages=[language], data_dir=str(root), timeout=60, verifyit_enabled=True)
+    for completion, expected in [(body, 1.0), (wrong, 0.0)]:
+        directory = tempfile.TemporaryDirectory()
+        responses = {
+            language: [{"task_id": task_id, "prompt": task["prompt"], "generation": task["prompt"] + completion}],
+            "temp_dir_obj": directory,
+        }
+        assert scorer.evaluate_responses(responses) == {f"{language}_pass@1": expected}
+        assert not Path(directory.name).exists()
+
+
+def test_later_invalid_suite_discards_prior_positive_aggregate(tmp_path, monkeypatch):
+    monkeypatch.setenv("VERIFYIT_MULTIPLE_IMAGE", "verifyit-evalchemy-multiple:source-v1")
+    valid = {"task_id": "valid", "prompt": "", "test": "if (candidate(2)!==2) throw Error('wrong');"}
+    invalid = {"task_id": "invalid", "prompt": "", "test": ""}
+    (tmp_path / "multipl-e-js.json").write_text(json.dumps([valid]))
+    (tmp_path / "multipl-e-lua.json").write_text(json.dumps([invalid]))
+    directory = tempfile.TemporaryDirectory()
+    responses = {
+        "js": [{"task_id": "valid", "prompt": "", "generation": "function candidate(x){return x;}"}],
+        "lua": [{"task_id": "invalid", "prompt": "", "generation": "function candidate(x) return x end"}],
+        "temp_dir_obj": directory,
+    }
+    scorer = MultipleBenchmark(languages=["js", "lua"], data_dir=str(tmp_path), timeout=60, verifyit_enabled=True)
+    with pytest.raises(InvalidTask, match="nonempty trusted test"):
+        scorer.evaluate_responses(responses)
+    assert not Path(directory.name).exists()
+
+
+def test_mixed_completions_preserve_pass_at_k_and_ignore_stale_file(tmp_path, monkeypatch):
+    monkeypatch.setenv("VERIFYIT_MULTIPLE_IMAGE", "verifyit-evalchemy-multiple:source-v1")
+    task = {"task_id": "identity", "prompt": "", "test": "if(candidate(2)!==2) throw Error('wrong');"}
+    (tmp_path / "multipl-e-js.json").write_text(json.dumps([task]))
+    directory = tempfile.TemporaryDirectory()
+    good = {"task_id": "identity", "prompt": "", "generation": "function candidate(x){return x;}"}
+    bad = {**good, "generation": "function candidate(x){return 0;}"}
+    (Path(directory.name) / "generated_js.jsonl").write_text((json.dumps(good) + "\n") * 10)
+    responses = {"js": [good, bad] * 5, "temp_dir_obj": directory}
+    scorer = MultipleBenchmark(languages=["js"], data_dir=str(tmp_path), timeout=60, verifyit_enabled=True)
+    assert scorer.evaluate_responses(responses) == {"js_pass@1": 0.5, "js_pass@10": 1.0}
+    assert not Path(directory.name).exists()
