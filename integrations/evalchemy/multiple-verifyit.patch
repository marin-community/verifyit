diff --git a/eval/graders/verifyit_multiple.py b/eval/graders/verifyit_multiple.py
new file mode 100644
--- /dev/null
+++ b/eval/graders/verifyit_multiple.py
@@ -0,0 +1,209 @@
+"""MultiPL-E source execution and pass@k behind the existing ScriptSpec boundary.
+
+Candidate code shares the original grader runtime and trusted tests. This client
+preserves source language runtimes; it does not claim assertion isolation.
+"""
+
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import uuid
+
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.spec import ScriptSpec, render_spec
+
+IMAGE = "verifyit-evalchemy-multiple:source-v1"
+NATIVE_IMAGE = "verifyit-evalchemy-multiple-native:source-v1"
+DATA_ALIASES = {"ruby": "rb", "dlang": "d", "ocaml": "ml"}
+
+LANGUAGES = frozenset(
+    (
+        "js",
+        "java",
+        "cpp",
+        "cs",
+        "go",
+        "hs",
+        "php",
+        "r",
+        "rs",
+        "sh",
+        "swift",
+        "ts",
+        "clj",
+        "dart",
+        "elixir",
+        "julia",
+        "lua",
+        "racket",
+        "ruby",
+        "dlang",
+        "ocaml",
+        "adb",
+        "pl",
+        "scala",
+    )
+)
+
+
+def problem_path(data_dir, language):
+    return Path(data_dir) / f"multipl-e-{DATA_ALIASES.get(language, language)}.json"
+
+
+def source_root():
+    root = Path(__file__).resolve().parents[1] / "chat_benchmarks/MultiPLE"
+    hashes = json.loads(Path(__file__).with_name("multiple_runtime").joinpath("source-hashes.json").read_text())
+    for relative, expected in hashes.items():
+        if hashlib.sha256((root / relative).read_bytes()).hexdigest() != expected:
+            raise InvalidTask(f"MultiPL-E source implementation changed: {relative}")
+    return root
+
+
+def grade(task_id, sample, language, timeout, tmp_dir, completion_id):
+    if language not in LANGUAGES:
+        raise InvalidTask("MultiPL-E language has no complete bundled source contract")
+    if type(timeout) not in (int, float) or not math.isfinite(timeout) or timeout <= 0:
+        raise InvalidTask("MultiPL-E timeout must be positive and finite")
+    source = source_root()
+    name = "verifyit-multiple-" + uuid.uuid4().hex
+    with tempfile.TemporaryDirectory(prefix="verifyit-multiple-") as directory:
+        root = Path(directory)
+        payload = dict(
+            task_id=task_id,
+            sample=sample,
+            language=language,
+            timeout=timeout,
+            completion_id=completion_id,
+            container=name,
+            source=str(source),
+        )
+        (root / "input.json").write_text(json.dumps(payload, allow_nan=False))
+        (root / "run.sh").write_text('exec "$@"\n')
+        spec = ScriptSpec(
+            "run.sh",
+            args=(sys.executable, "-m", "eval.graders.verifyit_multiple", str(root / "input.json")),
+            timeout=timeout + 60,
+            verdict_file="result.json",
+        )
+        (root / "verifier.toml").write_text(render_spec(spec))
+        try:
+            verdict = run(root / "verifier.toml", root)
+        finally:
+            subprocess.run(["docker", "rm", "-f", name], capture_output=True, timeout=30, check=False)
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(str(verdict.detail))
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"MultiPL-E verifier failed: {verdict.status}: {verdict.detail}")
+    result = verdict.detail["source_result"]
+    if type(result.get("passed")) is not bool or verdict.reward != float(result["passed"]):
+        raise RuntimeError("MultiPL-E returned inconsistent sample scoring")
+    return result
+
+
+def evaluate(benchmark, results):
+    source = source_root()
+    original_temp = results.get("temp_dir_obj") if isinstance(results, dict) else None
+    try:
+        if (
+            not isinstance(results, dict)
+            or not benchmark.languages
+            or len(set(benchmark.languages)) != len(benchmark.languages)
+        ):
+            raise InvalidTask("MultiPL-E requires a nonempty distinct language population")
+        if any(language not in LANGUAGES for language in benchmark.languages):
+            raise InvalidTask("MultiPL-E selected language lacks bundled data or source dispatch")
+        specification = importlib.util.spec_from_file_location(
+            "multiple._verifyit_evaluation", source / "multiple/evaluation.py"
+        )
+        runtime = importlib.util.module_from_spec(specification)
+        specification.loader.exec_module(runtime)
+        runtime.check_code_correctness = grade
+        metrics = {}
+        with tempfile.TemporaryDirectory(prefix="verifyit-multiple-batch-") as directory:
+            for language in benchmark.languages:
+                problem_file = problem_path(benchmark.data_dir, language)
+                problems = runtime.read_dataset(str(problem_file))
+                rows = results.get(language)
+                if not isinstance(rows, list) or not rows:
+                    raise InvalidTask("MultiPL-E requires current responses for every selected language")
+                clean_rows = []
+                for original in rows:
+                    if not isinstance(original, dict) or original.get("task_id") not in problems:
+                        raise InvalidTask("MultiPL-E response has no trusted problem")
+                    row = dict(original)
+                    problem = problems[row["task_id"]]
+                    if not isinstance(problem.get("test"), str) or not problem["test"].strip():
+                        raise InvalidTask("MultiPL-E requires a nonempty trusted test suite")
+                    if not isinstance(row.get("generation"), str) or not isinstance(row.get("prompt"), str):
+                        raise InvalidTask("MultiPL-E generation and prompt must be text")
+                    if row["prompt"] != problem.get("prompt"):
+                        raise InvalidTask("MultiPL-E response prompt differs from its trusted problem")
+                    clean_rows.append(row)
+                path = Path(directory) / f"{language}.jsonl"
+                path.write_text("".join(json.dumps(row, allow_nan=False) + "\n" for row in clean_rows))
+                values = runtime.evaluate_functional_correctness(
+                    input_file=str(path),
+                    tmp_dir=directory,
+                    n_workers=benchmark.num_workers,
+                    timeout=benchmark.timeout,
+                    problem_file=str(problem_file),
+                    language=language,
+                )
+                if not values or any(
+                    not math.isfinite(float(value)) or not 0 <= float(value) <= 1 for value in values.values()
+                ):
+                    raise RuntimeError("MultiPL-E returned invalid aggregate metrics")
+                metrics.update({f"{language}_{key}": value for key, value in values.items()})
+        return metrics
+    finally:
+        if original_temp is not None:
+            original_temp.cleanup()
+
+
+def main():
+    path = Path(sys.argv[1])
+    payload = json.loads(path.read_text())
+    source_root()
+    native = payload["language"] in {"cs", "racket"}
+    command = [
+        "docker",
+        "run",
+        "--rm",
+        "--platform",
+        os.environ.get("VERIFYIT_MULTIPLE_PLATFORM", "linux/arm64" if native else "linux/amd64"),
+        "--name",
+        payload["container"],
+        "-v",
+        f"{path.parent}:/input:ro",
+        "-v",
+        f"{payload['source']}:/source:ro",
+        "-v",
+        f"{Path(__file__).with_name('verifyit_multiple_worker.py')}:/worker.py:ro",
+        "--entrypoint",
+        "python",
+        os.environ.get("VERIFYIT_MULTIPLE_IMAGE", NATIVE_IMAGE if native else IMAGE),
+        "/worker.py",
+    ]
+    result = subprocess.run(command, capture_output=True, text=True, timeout=payload["timeout"] + 40, check=False)
+    if result.returncode != 0:
+        raise RuntimeError(f"MultiPL-E runtime failed: {result.stderr[-4096:]}")
+    runtime_result = json.loads(result.stdout)
+    source_result = runtime_result["source_result"]
+    if type(source_result.get("passed")) is not bool:
+        raise RuntimeError("MultiPL-E runtime omitted its sample outcome")
+    verdict = {
+        "status": "scored",
+        "reward": float(source_result["passed"]),
+        "detail": {"source_result": source_result, "execution_receipts": runtime_result["execution_receipts"]},
+    }
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(verdict, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/eval/graders/verifyit_multiple_worker.py b/eval/graders/verifyit_multiple_worker.py
new file mode 100644
--- /dev/null
+++ b/eval/graders/verifyit_multiple_worker.py
@@ -0,0 +1,89 @@
+"""Execute the untouched MultiPL-E sample scorer in its documented dependency image."""
+
+import contextlib
+import json
+import multiprocessing
+from pathlib import Path
+import shutil
+import sys
+
+sys.path.insert(0, "/source")
+from multiple import execution
+from multiple import containerized_eval, eval_pl, eval_scala
+
+TOOLS = {
+    "js": ("node",),
+    "java": ("javac", "java"),
+    "cpp": ("g++",),
+    "cs": ("csc", "mono"),
+    "go": ("go",),
+    "hs": ("runghc",),
+    "php": ("php",),
+    "r": ("Rscript",),
+    "rs": ("rustc",),
+    "sh": ("bash",),
+    "swift": ("swiftc",),
+    "ts": ("tsc", "node"),
+    "clj": ("clojure",),
+    "dart": ("dart",),
+    "elixir": ("elixir",),
+    "julia": ("julia",),
+    "lua": ("lua",),
+    "racket": ("racket",),
+    "ruby": ("ruby",),
+    "dlang": ("dmd",),
+    "ocaml": ("ocaml",),
+    "adb": ("gnatchop", "gnatmake"),
+    "pl": ("perl",),
+    "scala": ("scalac", "scala"),
+}
+
+payload = json.loads(Path("/input/input.json").read_text())
+for tool in TOOLS[payload["language"]]:
+    if shutil.which(tool) is None:
+        raise RuntimeError(f"MultiPL-E trusted runtime is unavailable: {tool}")
+if payload["language"] == "java" and not Path("/usr/multiple/javatuples-1.2.jar").is_file():
+    raise RuntimeError("MultiPL-E javatuples dependency is unavailable")
+containerized_eval.EVALUATORS.update({"pl": (eval_pl.eval_script, ".pl"), "scala": (eval_scala.eval_script, ".scala")})
+# Go only discovers Test* functions in a _test.go file. The source .go suffix
+# compiles but reports no tests, even for a wrong candidate.
+containerized_eval.EVALUATORS["go"] = (containerized_eval.EVALUATORS["go"][0], "_test.go")
+failures_manager = multiprocessing.Manager()
+launch_failures = failures_manager.list()
+execution_receipts = failures_manager.list()
+original_execute = execution.eval_string_script
+runtime_aliases = {"ruby": "rb", "dlang": "d", "ocaml": "ml", "adb": "ada"}
+
+
+def execute(language, program, tmpdir):
+    try:
+        result = original_execute(runtime_aliases.get(language, language), program, tmpdir)
+        execution_receipts.append({key: result[key] for key in ("status", "exit_code", "stdout", "stderr")})
+        # Every supported source callback uses OK for successful execution.
+        # Mono can exit zero after a failed assertion; its source callback
+        # reports Exception but retains that original exit code.
+        if result["status"] != "OK" and result["exit_code"] == 0:
+            result = {**result, "exit_code": 1}
+        return result
+    except (OSError, ImportError) as error:
+        launch_failures.append(f"{type(error).__name__}: {error}")
+        raise
+
+
+execution.eval_string_script = execute
+try:
+    with contextlib.redirect_stdout(sys.stderr):
+        result = execution.check_code_correctness(
+            payload["task_id"],
+            payload["sample"],
+            payload["language"],
+            payload["timeout"],
+            "/tmp",
+            payload["completion_id"],
+        )
+    if launch_failures:
+        raise RuntimeError("MultiPL-E runtime launch failed: " + "; ".join(launch_failures))
+    receipts = list(execution_receipts)
+finally:
+    failures_manager.shutdown()
+print(json.dumps({"source_result": result, "execution_receipts": receipts}, allow_nan=False))
