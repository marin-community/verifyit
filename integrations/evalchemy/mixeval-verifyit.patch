+"""MixEval fresh scoring, count metadata and deterministic interpretation failures."""
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from types import SimpleNamespace
+
+import pytest
+from verifyit.grade import InvalidTask
+
+from eval.graders.verifyit_mixeval import evaluate
+
+
+def args(**changes):
+    values = dict(
+        benchmark="mixeval",
+        version="2024-06-01",
+        model_name="llama_3_8b",
+        output_dir="unused",
+        free_form_parser="rule",
+        multi_choice_parser="rule",
+        api_parallel_num=1,
+        extract_base_model_response=False,
+        compute_score_from_judged_file=False,
+        freeform_judge="fixture",
+        multichoice_judge="fixture",
+        verbose=False,
+    )
+    values.update(changes)
+    return SimpleNamespace(**values)
+
+
+def responses(freeform_target="2.35", freeform_response="The answer is 2.345", mc_response="A"):
+    return {
+        "close_freeform": [
+            {
+                "id": "ff",
+                "prompt": "Number?",
+                "target": [freeform_target],
+                "response": freeform_response,
+                "benchmark_name": "numeric",
+            }
+        ],
+        "close_multichoice": [
+            {
+                "id": "mc",
+                "prompt": "Color?",
+                "options": ["red", "blue"],
+                "target": [0],
+                "response": mc_response,
+                "benchmark_name": "choice",
+            }
+        ],
+    }
+
+
+def test_rule_profiles_keep_source_numeric_rounding_and_complete_counts():
+    result = evaluate(args(), responses())
+    assert result["fixture"]["metrics"] == {"overall": 1.0, "numeric": 1.0, "choice": 1.0}
+    assert result["samples"]["judge_answers"]["close_freeform"][0]["eval_result"] is True
+
+
+def test_no_interpretable_choice_scores_zero_instead_of_random_credit():
+    result = evaluate(args(), responses(mc_response="unrecognized"))
+    assert result["fixture"]["metrics"]["choice"] == 0
+    assert result["samples"]["judge_answers"]["close_multichoice"][0]["parsed_result"] == "-1"
+
+
+def test_hard_benchmark_accepts_actual_generator_split_names():
+    result = evaluate(args(benchmark="mixeval_hard"), responses())
+    assert result["fixture"]["metrics"]["overall"] == 1
+    assert set(result["samples"]["model_answers"]) == {"close_freeform", "close_multichoice"}
+
+
+def test_source_single_character_boundaries_remain_significant():
+    result = evaluate(args(), responses(freeform_target="a", freeform_response="cat"))
+    assert result["fixture"]["metrics"]["numeric"] == 0
+
+
+@pytest.mark.parametrize("reference", ["", "  "])
+def test_empty_reference_aborts_instead_of_vacuous_substring_credit(reference):
+    with pytest.raises(InvalidTask):
+        evaluate(args(), responses(freeform_target=reference, freeform_response="wrong"))
+
+
+def test_nonfinite_normalized_reference_preserves_invalid_task_status():
+    with pytest.raises(InvalidTask, match="nonfinite"):
+        evaluate(args(), responses(freeform_target="inf", freeform_response="infinity"))
+
+
+def test_reserved_aggregate_category_cannot_replace_sample_counts():
+    rows = responses()
+    rows["close_multichoice"][0]["benchmark_name"] = "overall"
+    with pytest.raises(InvalidTask):
+        evaluate(args(), rows)
+
+
+def test_empty_model_judgments_ignore_stale_positive_score_cache(tmp_path, monkeypatch):
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            body = json.dumps(
+                {
+                    "id": "fixture",
+                    "object": "chat.completion",
+                    "created": 0,
+                    "model": request["model"],
+                    "choices": [
+                        {
+                            "index": 0,
+                            "finish_reason": "stop",
+                            "message": {"role": "assistant", "content": "[[1]] [[A]]"},
+                        }
+                    ],
+                }
+            ).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *_):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    monkeypatch.setenv("MODEL_PARSER_API", "fixture")
+    settings = args(
+        output_dir=str(tmp_path),
+        free_form_parser="model",
+        multi_choice_parser="model",
+        api_base_url=f"http://127.0.0.1:{server.server_port}/v1",
+    )
+    cache = tmp_path / settings.model_name / settings.benchmark / settings.version
+    cache.mkdir(parents=True)
+    (cache / "score_fixture.json").write_text(json.dumps({"overall": 1.0}))
+    try:
+        result = evaluate(settings, responses(freeform_response="", mc_response=""))
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+    assert result["fixture"]["metrics"]["overall"] == 0
+    assert result["samples"]["judge_answers"]["close_freeform"][0]["judge_score"] == 0
+    assert result["samples"]["judge_answers"]["close_multichoice"][0]["judge_option"] == "-1"
