+"""DROP script boundary regressions for references and source score semantics."""
+
+import pytest
+
+from lm_eval.verifyit_drop import process_results
+
+
+@pytest.mark.parametrize("reference", ["the", "!!!", "", "   "])
+def test_empty_normalized_reference_aborts(reference):
+    with pytest.raises(RuntimeError, match="invalid_task"):
+        process_results({"answers": [[reference]]}, [""])
+
+
+@pytest.mark.parametrize(
+    "references,responses,expected",
+    [
+        ([["red blue"]], ["red"], {"em": 0.0, "f1": 0.67}),
+        ([["20"]], ["21"], {"em": 0.0, "f1": 0.0}),
+        ([["North", "South"]], ["North"], {"em": 0.0, "f1": 0.5}),
+        ([["incorrect"], ["correct"]], ["correct"], {"em": 1.0, "f1": 1.0}),
+        ([["valid"]], [""], {"em": 0.0, "f1": 0.0}),
+    ],
+)
+def test_source_comparison_through_script(references, responses, expected):
+    assert process_results({"answers": references}, responses) == expected
