@@ -0,0 +1,128 @@
+"""Execute the pinned DROP multi-span scorer through verifyit's script mode."""
+
+import hashlib
+import json
+import math
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.spec import ScriptSpec, render_spec
+
+from lm_eval.tasks.drop import utils as source
+
+
+SOURCE_HASH = "a5782ee7d2e537968a5b83976195ae2b9b6e2a565a0bfb5c24d221b4d61a04f5"
+
+
+def validate_source():
+    path = Path(__file__).resolve().parent / "tasks/drop/utils.py"
+    if (
+        Path(source.__file__).resolve() != path
+        or hashlib.sha256(path.read_bytes()).hexdigest() != SOURCE_HASH
+    ):
+        raise InvalidTask("DROP source scorer differs from the audited installation")
+    return path
+
+
+def enable(config):
+    validate_source()
+    callback = config.get("process_results")
+    if (
+        not callable(callback)
+        or getattr(callback, "__code__", None) != source.process_results.__code__
+    ):
+        raise InvalidTask("DROP requires the pinned source process_results callback")
+    if config.get("output_type") != "generate_until" or config.get("class") is not None:
+        raise InvalidTask("DROP requires its generation task")
+    metrics = config.get("metric_list")
+    expected = [
+        {"metric": name, "aggregation": "mean", "higher_is_better": True}
+        for name in ("em", "f1")
+    ]
+    if metrics != expected:
+        raise InvalidTask("DROP requires source EM and F1 mean metrics")
+    config["process_results"] = process_results
+
+
+def score(doc, results):
+    validate_source()
+    answers = doc.get("answers")
+    if not isinstance(answers, list) or not answers:
+        raise InvalidTask("DROP requires nonempty reference alternatives")
+    for alternative in answers:
+        if not isinstance(alternative, (list, tuple)) or not alternative:
+            raise InvalidTask("DROP requires nonempty reference spans")
+        if any(
+            not isinstance(span, str) or not source._normalize(span)
+            for span in alternative
+        ):
+            raise InvalidTask("DROP reference spans must be nonempty strings")
+    if (
+        not isinstance(results, list)
+        or not results
+        or any(not isinstance(x, str) for x in results)
+    ):
+        raise InvalidTask("DROP responses must be a nonempty string list")
+    metrics = source.process_results(doc, results)
+    if set(metrics) != {"em", "f1"} or any(
+        isinstance(value, bool)
+        or not isinstance(value, (int, float))
+        or not math.isfinite(value)
+        or not 0 <= value <= 1
+        for value in metrics.values()
+    ):
+        raise InvalidTask("DROP source returned invalid scores")
+    return metrics
+
+
+def process_results(doc, results):
+    validate_source()
+    with tempfile.TemporaryDirectory(prefix="verifyit-drop-") as directory:
+        tests = Path(directory)
+        payload = tests / "input.json"
+        payload.write_text(
+            json.dumps({"doc": doc, "results": results}, allow_nan=False)
+        )
+        (tests / "run.sh").write_text('exec "$@"\n')
+        spec = ScriptSpec(
+            "run.sh",
+            args=(sys.executable, "-m", "lm_eval.verifyit_drop", str(payload)),
+            timeout=30,
+            verdict_file="drop.json",
+        )
+        config = tests / "verifier.toml"
+        config.write_text(render_spec(spec))
+        verdict = run(config, tests)
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"DROP verifier failed: {verdict.status}: {verdict.detail}")
+    metrics = verdict.detail.get("metrics")
+    if not isinstance(metrics, dict) or set(metrics) != {"em", "f1"}:
+        raise RuntimeError("DROP verifier omitted named scores")
+    return metrics
+
+
+def main():
+    payload = json.loads(Path(sys.argv[1]).read_text())
+    try:
+        metrics = score(payload["doc"], payload["results"])
+        verdict = {
+            "status": "scored",
+            "reward": metrics["f1"],
+            "detail": {"metrics": metrics, "source_sha256": SOURCE_HASH},
+        }
+    except InvalidTask as error:
+        verdict = {
+            "status": "invalid_task",
+            "reward": 0,
+            "detail": {"error": str(error)},
+        }
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "drop.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
+
+
+if __name__ == "__main__":
+    main()
