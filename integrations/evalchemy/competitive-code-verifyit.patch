+"""Competitive-code source semantics and ordinary execution-failure regressions."""
+
+import subprocess
+
+import pytest
+
+from eval.graders import livecodebench
+from eval.graders.verifyit_competitive_code import DOCKER, IMAGE, grade_problem
+from verifyit.grade import InvalidTask
+
+
+@pytest.fixture(scope="module", autouse=True)
+def candidate_image():
+    if DOCKER is None:
+        pytest.skip("Docker is required for isolated candidate grading")
+    if subprocess.run([DOCKER, "image", "inspect", IMAGE], capture_output=True, timeout=10).returncode:
+        pytest.skip("Load the pinned candidate image")
+
+
+def functional(tests):
+    return {"test": [{**test, "testtype": "functional"} for test in tests]}
+
+
+def test_function_state_persists_across_tests():
+    tests = functional([{"input": [], "output": 1}, {"input": [], "output": 2}])
+    candidate = "count=0\ndef next_value():\n global count\n count+=1\n return count"
+    assert grade_problem("lcb", tests, candidate)
+
+
+def test_function_keyword_arguments_and_printed_output():
+    tests = functional([{"input": {"a": 2, "b": 3}, "output": 5}])
+    assert grade_problem("lcb", tests, 'def add(a,b):\n print("working")\n return a+b')
+
+
+def test_lossless_list_coercion_and_truncating_source_false_positive():
+    tests = functional([{"input": [], "output": [1.1]}])
+    assert livecodebench._score([1.9], [1.1])
+    assert not grade_problem("lcb", tests, "def answer(): return [1.9]")
+    assert grade_problem("lcb", tests, "def answer(): return [1.1]")
+    integral = functional([{"input": [], "output": [1, 2]}])
+    assert grade_problem("lcb", integral, 'def answer(): return ("1", 2.0)')
+
+
+@pytest.mark.parametrize("profile", ["codeelo", "codeforces"])
+def test_legacy_stdin_strips_reference_marker_and_keeps_exact_comparison(profile):
+    problem = (
+        {"examples": [["", "5-\n"]]} if profile == "codeelo" else {"official_tests": [{"input": "", "output": "5-\n"}]}
+    )
+    assert grade_problem(profile, problem, 'if __name__ == "__main__":\n print(5)')
+    assert not grade_problem(profile, problem, 'print("5.0")')
+
+
+def test_lcb_stdin_retains_numeric_string_comparison():
+    problem = {"test": [{"input": "", "output": "5", "testtype": "stdin"}]}
+    assert grade_problem("lcb", problem, 'print("5.0")')
+    assert not grade_problem("lcb", problem, 'print("6.0")')
+
+
+def test_candidate_timeout_scores_zero_and_removes_container():
+    before = subprocess.check_output(
+        [DOCKER, "ps", "-aq", "--filter", "name=verifyit-competitive-"], text=True
+    ).splitlines()
+    tests = functional([{"input": [], "output": 1}])
+    assert not grade_problem("lcb", tests, "def answer():\n while True: pass", timeout=0.1)
+    after = subprocess.check_output(
+        [DOCKER, "ps", "-aq", "--filter", "name=verifyit-competitive-"], text=True
+    ).splitlines()
+    assert set(after) <= set(before)
+
+
+def test_empty_tests_cannot_award_vacuous_pass():
+    with pytest.raises(InvalidTask):
+        grade_problem("lcb", {"test": []}, "def answer(): return 1")
+
+
+def test_missing_repetitions_cannot_return_partial_positive_metrics():
+    from eval.chat_benchmarks.LiveCodeBench.eval_instruct import LiveCodeBenchBenchmark
+
+    benchmark = LiveCodeBenchBenchmark(verifyit_enabled=True)
+    code = "def answer(): return 1"
+    example = {
+        "difficulty": "Easy",
+        "is_stdin": False,
+        "test": [{"input": [], "output": 1, "testtype": "functional"}],
+        "model_outputs": [code],
+        "model_answers": [[code]],
+    }
+    with pytest.raises(InvalidTask):
+        benchmark.evaluate_responses({"examples": [example]})
+
+
+def test_missing_execution_runtime_aborts_batch(monkeypatch, tmp_path):
+    from eval.chat_benchmarks.LiveCodeBench.eval_instruct import LiveCodeBenchBenchmark
+
+    benchmark = LiveCodeBenchBenchmark(verifyit_enabled=True)
+    code = "def answer(): return 1"
+    example = {
+        "difficulty": "Easy",
+        "is_stdin": False,
+        "test": [{"input": [], "output": 1, "testtype": "functional"}],
+        "model_outputs": [code] * benchmark.n_repeat,
+        "model_answers": [[code]] * benchmark.n_repeat,
+    }
+    monkeypatch.setenv("PATH", str(tmp_path))
+    with pytest.raises(RuntimeError):
+        benchmark.evaluate_responses({"examples": [example]})
+
+
+def test_source_memory_budget_accepts_candidate_above_old_rpc_default():
+    size = 600 * 1024 * 1024
+    tests = functional([{"input": [], "output": size}])
+    candidate = (
+        f"def answer():\n value=bytearray({size})\n for i in range(0,len(value),4096): value[i]=1\n return len(value)"
+    )
+    assert grade_problem("lcb", tests, candidate)
+
+
+@pytest.mark.parametrize("profile", ["codeelo", "codeforces"])
+def test_legacy_profiles_inherit_environment_memory_budget(profile):
+    size = 600 * 1024 * 1024
+    problem = (
+        {"examples": [["", str(size)]]}
+        if profile == "codeelo"
+        else {"official_tests": [{"input": "", "output": str(size)}]}
+    )
+    assert grade_problem(
+        profile, problem, f"value=bytearray({size})\nfor i in range(0,len(value),4096): value[i]=1\nprint(len(value))"
+    )
+
+
+def test_lcb_source_address_space_limit_rejects_sparse_allocation():
+    size = 1536 * 1024 * 1024
+    tests = functional([{"input": [], "output": size}])
+    candidate = f"def answer():\n import mmap\n value=mmap.mmap(-1,{size})\n return len(value)"
+    assert not grade_problem("lcb", tests, candidate)
+    legacy = {"examples": [["", str(size)]]}
+    assert grade_problem("codeelo", legacy, f"import mmap\nvalue=mmap.mmap(-1,{size})\nprint(len(value))")
