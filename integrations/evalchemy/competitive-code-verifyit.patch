diff --git a/eval/graders/verifyit_competitive_code.py b/eval/graders/verifyit_competitive_code.py
new file mode 100644
--- /dev/null
+++ b/eval/graders/verifyit_competitive_code.py
@@ -0,0 +1,256 @@
+"""Source competitive-programming contracts with candidate-only execution."""
+
+import hashlib
+import importlib
+import json
+import math
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+
+from lm_eval.verifyit_humaneval import DOCKER, score
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.spec import ScriptSpec, render_spec
+
+from eval.graders.verifyit_code import IMAGE
+
+SOURCE_HASHES = {
+    "eval/graders/livecodebench.py": "7039dc9679475c19ce60a84b4f4f0348e74114eb4d17f16e315bb441a79ce04c",
+    "eval/chat_benchmarks/CodeElo/codeelo_utils.py": "854a5deaf66458d05c7496546fb29df760da81fcad4698d4aa14b30b873ce8ae",
+    "eval/chat_benchmarks/CodeForces/codeforces_utils.py": "9bdaf3a16965156de24355d67c8dcecd1e818452dea27f8a733b1a4be30c0f72",
+}
+PROFILES = {"lcb", "codeelo", "codeforces"}
+
+
+def _sources():
+    root = Path(__file__).resolve().parents[2]
+    for name, expected in SOURCE_HASHES.items():
+        if hashlib.sha256((root / name).read_bytes()).hexdigest() != expected:
+            raise InvalidTask("Competitive-code source contract changed")
+
+
+def prepare_tests(profile, problem):
+    _sources()
+    if profile not in PROFILES or not isinstance(problem, dict):
+        raise InvalidTask("Unknown competitive-code task profile")
+    try:
+        if profile == "lcb":
+            tests = problem["test"]
+            if isinstance(tests, str):
+                tests = json.loads(tests)
+            stdin_mode = bool(tests) and tests[0].get("testtype") != "functional"
+        elif profile == "codeelo":
+            tests = [{"input": pair[0], "output": pair[1]} for pair in problem["examples"]]
+            stdin_mode = True
+        else:
+            tests = problem["official_tests"]
+            stdin_mode = True
+        if not isinstance(tests, list) or not tests:
+            raise InvalidTask("Competitive-code task has no tests")
+        normalized = []
+        for test in tests:
+            if not isinstance(test, dict) or "input" not in test or "output" not in test or test["output"] is None:
+                raise InvalidTask("Malformed competitive-code test")
+            expected = test["output"]
+            if stdin_mode and not isinstance(test["input"], str):
+                raise InvalidTask("Stdin test input must be text")
+            if profile != "lcb":
+                if not isinstance(expected, str):
+                    raise InvalidTask("Legacy stdin reference must be text")
+                expected = expected.strip()
+                if expected.endswith("-"):
+                    expected = expected[: expected.rfind("-")].rstrip()
+            normalized.append({"input": test["input"], "output": expected})
+        json.dumps(normalized, allow_nan=False)
+    except (KeyError, TypeError, ValueError, IndexError, AttributeError) as error:
+        raise InvalidTask("Malformed competitive-code test contract") from error
+    return normalized, stdin_mode
+
+
+def validate_batch(profile, examples, expected_repeats):
+    if not isinstance(examples, list) or not examples:
+        raise InvalidTask("Competitive-code evaluation requires samples")
+    repeats = None
+    for example in examples:
+        prepare_tests(profile, example)
+        outputs, answers = example.get("model_outputs"), example.get("model_answers")
+        if (
+            not isinstance(outputs, list)
+            or not outputs
+            or not isinstance(answers, list)
+            or len(outputs) != len(answers)
+        ):
+            raise InvalidTask("Competitive-code outputs must align with parsed answers")
+        if repeats is not None and repeats != len(outputs):
+            raise InvalidTask("Competitive-code repetitions must align across samples")
+        if len(outputs) != expected_repeats:
+            raise InvalidTask("Competitive-code batch omitted configured repetitions")
+        repeats = len(outputs)
+        if profile != "lcb":
+            limit = example.get("time_limit_ms" if profile == "codeelo" else "time_limit")
+            rating = example.get("rating")
+            if type(limit) not in (int, float) or not math.isfinite(limit) or limit <= 0:
+                raise InvalidTask("Legacy competitive-code task has an invalid time limit")
+            if "rating" not in example or not (
+                profile == "codeforces" and rating is None or type(rating) in (int, float) and math.isfinite(rating)
+            ):
+                raise InvalidTask("Legacy competitive-code task has invalid rating metadata")
+        if not isinstance(example.get("difficulty"), str) or not example["difficulty"]:
+            raise InvalidTask("Competitive-code sample lacks difficulty metadata")
+
+
+def _timeout(signum, frame):
+    raise TimeoutError("Candidate execution exceeded its source deadline")
+
+
+def _compare(source, actual, expected):
+    if not source._score(actual, expected):
+        return False
+    if actual == expected:
+        return True
+    if isinstance(actual, (list, tuple)) and isinstance(expected, (list, tuple)):
+        # Source integer coercion truncates non-integral floats and can award wrong answers.
+        try:
+            return all(float(value) == int(value) for value in [*actual, *expected])
+        except (TypeError, ValueError, OverflowError):
+            return False
+    return True
+
+
+def _check(candidate, tests, profile, stdin_mode, timeout, deadline):
+    source = importlib.import_module("eval.graders.livecodebench") if profile == "lcb" else None
+    for test in tests:
+        signal.setitimer(
+            signal.ITIMER_REAL,
+            max(0.001, min(timeout if profile == "lcb" else float("inf"), deadline - time.monotonic())),
+        )
+        value = test["input"]
+        if stdin_mode:
+            actual = candidate(value)
+        elif isinstance(value, (list, tuple)):
+            actual = candidate(*value)
+        elif isinstance(value, dict):
+            actual = candidate(**value)
+        else:
+            actual = candidate(value)
+        signal.setitimer(signal.ITIMER_REAL, max(0.001, deadline - time.monotonic()))
+        assert _compare(source, actual, test["output"]) if source else actual == test["output"]
+
+
+def grade_problem(profile, problem, completion, timeout=6):
+    tests, stdin_mode = prepare_tests(profile, problem)
+    if not isinstance(completion, str) or not completion.strip():
+        return False
+    if type(timeout) not in (int, float) or not math.isfinite(timeout) or timeout <= 0:
+        raise InvalidTask("Invalid candidate timeout")
+    deadline = (
+        max(timeout * 2, 30) if profile == "lcb" else (timeout + 1) * len(tests) + (5 if profile == "codeelo" else 60)
+    )
+    name = "verifyit-competitive-" + uuid.uuid4().hex
+    try:
+        with tempfile.TemporaryDirectory(prefix="verifyit-competitive-") as directory:
+            root = Path(directory)
+            payload = {
+                "profile": profile,
+                "tests": tests,
+                "stdin_mode": stdin_mode,
+                "completion": completion,
+                "timeout": timeout,
+                "deadline": deadline,
+                "name": name,
+            }
+            (root / "input.json").write_text(json.dumps(payload, allow_nan=False))
+            (root / "run.sh").write_text('exec "$@"\n')
+            specification = ScriptSpec(
+                "run.sh",
+                args=(sys.executable, "-m", "eval.graders.verifyit_competitive_code", str(root / "input.json")),
+                timeout=deadline + 15,
+                verdict_file="result.json",
+            )
+            (root / "verifier.toml").write_text(render_spec(specification))
+            verdict = run(root / "verifier.toml", root)
+    finally:
+        if DOCKER:
+            subprocess.run(
+                [DOCKER, "rm", "-f", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10
+            )
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(str(verdict.detail))
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"Competitive-code verifier failed: {verdict.status}: {verdict.detail}")
+    return bool(verdict.reward)
+
+
+def main():
+    payload = json.loads(Path(sys.argv[1]).read_text())
+    _sources()
+    if DOCKER is None:
+        raise RuntimeError("Docker is unavailable")
+    subprocess.run(
+        [DOCKER, "image", "inspect", IMAGE],
+        check=True,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        timeout=10,
+    )
+    completion = payload["completion"]
+    if payload["stdin_mode"]:
+        if payload["profile"] != "lcb" and '__name__ == "__main__"' in completion:
+            completion = '__name__ = "__main__"\n' + completion
+        prediction = (
+            "import contextlib, io, sys\n"
+            "def _verifyit_entry(raw):\n"
+            "    output = io.StringIO()\n"
+            "    saved = sys.stdin\n"
+            "    try:\n"
+            "        sys.stdin = io.StringIO(raw)\n"
+            "        with contextlib.redirect_stdout(output):\n"
+            f"            exec({completion!r}, {{}})\n"
+            "        return output.getvalue().strip()\n"
+            "    finally:\n"
+            "        sys.stdin = saved\n"
+        )
+    else:
+        name = completion.split("(")[0].split()[-1]
+        prediction = completion + f"\n_verifyit_entry = {name}\n"
+    deadline = time.monotonic() + payload["deadline"]
+    reference = (
+        "from eval.graders.verifyit_competitive_code import _check\n"
+        "def _verifyit_check(candidate):\n"
+        f"    _check(candidate, {payload['tests']!r}, {payload['profile']!r}, {payload['stdin_mode']!r}, {payload['timeout']!r}, {deadline!r})\n"
+        "_verifyit_check(_verifyit_entry)\n"
+    )
+    signal.signal(signal.SIGALRM, _timeout)
+    signal.setitimer(signal.ITIMER_REAL, payload["deadline"])
+    try:
+        passed = score(
+            reference,
+            prediction,
+            payload["name"],
+            image=IMAGE,
+            memory_bytes=1024 * 1024 * 1024 if payload["profile"] == "lcb" else None,
+            resource_limit_bytes=1024 * 1024 * 1024 if payload["profile"] == "lcb" else None,
+        )
+    except TimeoutError:
+        passed = False
+    finally:
+        signal.setitimer(signal.ITIMER_REAL, 0)
+    verdict = {
+        "status": "scored",
+        "reward": float(passed),
+        "detail": {"profile": payload["profile"], "tests": len(payload["tests"]), "image": IMAGE},
+    }
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(verdict))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except InvalidTask as error:
+        verdict = {"status": "invalid_task", "reward": 0.0, "detail": {"error": str(error)}}
+        (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(verdict))
