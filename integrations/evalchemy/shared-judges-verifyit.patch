diff --git a/eval/graders/verifyit_judges.py b/eval/graders/verifyit_judges.py
new file mode 100644
--- /dev/null
+++ b/eval/graders/verifyit_judges.py
@@ -0,0 +1,196 @@
+"""Preserve Evalchemy judge protocols through ScriptSpec and strict label grading."""
+
+import asyncio
+import dataclasses
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+from openai import AsyncOpenAI
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.json_objects import unique_object
+from verifyit.modes.grade_exact import grade_exact_candidate
+from verifyit.spec import ExactSpec, ScriptSpec, render_spec
+
+from eval.graders.answer_equivalence import (
+    DEFAULT_NUM_WORKERS,
+    JUDGE_PROMPT,
+    JUDGE_TOKEN_BUDGETS,
+    EquivalenceJudgment,
+    EquivalenceMethod,
+    EquivalenceResult,
+    JudgeLabel,
+    _parse_judgment,
+    math_answers_equivalent,
+)
+from eval.graders.simpleqa import SIMPLEQA_GRADER_TEMPLATE, _parse_simpleqa_judgment
+
+
+def _judge_one(prompt, config, profile):
+    with tempfile.TemporaryDirectory(prefix="verifyit-judge-") as directory:
+        tests = Path(directory)
+        payload = tests / "input.json"
+        payload.write_text(
+            json.dumps(
+                {
+                    "prompt": prompt,
+                    "model": config.model,
+                    "base_url": config.base_url,
+                    "api_key": config.api_key,
+                    "profile": profile,
+                }
+            )
+        )
+        (tests / "run.sh").write_text('exec "$@"\n')
+        specification = ScriptSpec(
+            "run.sh",
+            args=(sys.executable, "-m", "eval.graders.verifyit_judges", str(payload)),
+            timeout=5500,
+            verdict_file="result.json",
+        )
+        spec = tests / "verifier.toml"
+        spec.write_text(render_spec(specification))
+        verdict = run(spec, tests)
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(str(verdict.detail))
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(f"Judge verifier failed: {verdict.status}: {verdict.detail}")
+    raw = verdict.detail["raw"]
+    parsed = _parse_simpleqa_judgment(raw) if profile == "simpleqa" else EquivalenceJudgment(_parse_judgment(raw), raw)
+    label = JudgeLabel.CORRECT if verdict.reward == 1 else parsed.label
+    if verdict.reward not in (0, 1) or (parsed.label == JudgeLabel.CORRECT) != (verdict.reward == 1):
+        raise RuntimeError("Judge label and verifier score disagree")
+    return EquivalenceJudgment(label, raw)
+
+
+async def _judge(prompts, config, profile, num_workers):
+    if type(num_workers) is not int or num_workers < 1:
+        raise InvalidTask("Judge concurrency must be a positive integer")
+    semaphore = asyncio.Semaphore(num_workers)
+
+    async def one(prompt):
+        async with semaphore:
+            return await asyncio.to_thread(_judge_one, prompt, config, profile)
+
+    outcomes = await asyncio.gather(*(one(prompt) for prompt in prompts), return_exceptions=True)
+    for outcome in outcomes:
+        if isinstance(outcome, BaseException):
+            raise outcome
+    return outcomes
+
+
+def _required(value, description):
+    if not isinstance(value, str) or not value.strip():
+        raise InvalidTask(description + " must be a nonempty string")
+
+
+async def judge_simpleqa(requests, config, num_workers=DEFAULT_NUM_WORKERS):
+    prompts = []
+    for request in requests:
+        _required(request.question, "Question")
+        _required(request.target, "Reference")
+        if not isinstance(request.predicted_answer, str):
+            raise InvalidTask("Candidate must be a string")
+        prompts.append(
+            SIMPLEQA_GRADER_TEMPLATE.format(
+                question=request.question, target=request.target, predicted_answer=request.predicted_answer
+            )
+        )
+    return await _judge(prompts, config, "simpleqa", num_workers)
+
+
+async def grade_math_equivalence(requests, config, num_workers=DEFAULT_NUM_WORKERS):
+    outcomes = []
+    pending = []
+    positions = []
+    for request in requests:
+        _required(request.question, "Question")
+        if not request.reference_answers:
+            raise InvalidTask("Math judge requires reference answers")
+        for reference in request.reference_answers:
+            _required(reference, "Reference")
+        if not isinstance(request.candidate_answer, str):
+            raise InvalidTask("Candidate must be a string")
+        if math_answers_equivalent(request.candidate_answer, request.reference_answers):
+            outcomes.append(EquivalenceResult(True, EquivalenceMethod.MINERVA))
+        elif config is None:
+            outcomes.append(EquivalenceResult(False, EquivalenceMethod.MINERVA))
+        else:
+            positions.append(len(outcomes))
+            outcomes.append(None)
+            pending.append(
+                JUDGE_PROMPT.format(
+                    question=request.question,
+                    reference_answers=json.dumps(request.reference_answers, ensure_ascii=False),
+                    candidate_answer=request.candidate_answer,
+                )
+            )
+    if pending:
+        judgments = await _judge(pending, config, "equivalence", num_workers)
+        for position, judgment in zip(positions, judgments, strict=True):
+            outcomes[position] = EquivalenceResult(
+                judgment.label == JudgeLabel.CORRECT, EquivalenceMethod.LLM_JUDGE, judgment
+            )
+    return outcomes
+
+
+async def _complete(payload):
+    async with AsyncOpenAI(
+        api_key=payload["api_key"], base_url=payload["base_url"], timeout=300.0, max_retries=5
+    ) as client:
+        for budget in JUDGE_TOKEN_BUDGETS:
+            raw_response = await client.chat.completions.with_raw_response.create(
+                model=payload["model"],
+                max_tokens=budget,
+                temperature=0,
+                messages=[{"role": "user", "content": payload["prompt"]}],
+            )
+            transport = json.loads(raw_response.http_response.text, object_pairs_hook=unique_object)
+            json.dumps(transport, allow_nan=False)
+            if not isinstance(transport, dict) or transport.get("error") is not None:
+                raise RuntimeError("Judge transport returned an error")
+            response = raw_response.parse()
+            if len(response.choices) != 1:
+                raise RuntimeError("Judge returned no completion choices")
+            choice = response.choices[0]
+            message = choice.message
+            if message.refusal or message.tool_calls or message.function_call:
+                raise RuntimeError("Judge returned refusal or tool calls")
+            if choice.finish_reason not in ("stop", "length"):
+                raise RuntimeError("Judge returned an unsupported completion state")
+            raw = (message.content or "").strip()
+            if not raw:
+                continue
+            if choice.finish_reason != "stop":
+                raise RuntimeError("Judge returned an incomplete completion")
+            return raw
+    raise RuntimeError("Judge exhausted source token budgets without text")
+
+
+def main():
+    payload = json.loads(Path(sys.argv[1]).read_text())
+    raw = asyncio.run(_complete(payload))
+    if payload["profile"] == "simpleqa":
+        label = _parse_simpleqa_judgment(raw).label
+    elif payload["profile"] == "equivalence":
+        label = _parse_judgment(raw)
+    else:
+        raise InvalidTask("Unsupported source judge profile")
+    exact = grade_exact_candidate(
+        ExactSpec(expected=("correct",), ignore_case=False, ignore_whitespace=False, strip_outer_whitespace=False),
+        label.value,
+    )
+    if exact.status != Status.SCORED:
+        raise RuntimeError("Label verifier did not score")
+    verdict = {
+        "status": "scored",
+        "reward": exact.reward,
+        "detail": {"raw": raw, "label": label.value, "exact_verdict": dataclasses.asdict(exact)},
+    }
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "result.json").write_text(json.dumps(verdict, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
