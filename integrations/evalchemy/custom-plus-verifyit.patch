diff --git a/eval/graders/verifyit_code_plus.py b/eval/graders/verifyit_code_plus.py
new file mode 100644
--- /dev/null
+++ b/eval/graders/verifyit_code_plus.py
@@ -0,0 +1,72 @@
+"""Retain EvalPlus trusted assertions and metrics through isolated code grading."""
+
+import ast
+import json
+import hashlib
+import tempfile
+from pathlib import Path
+
+from verifyit.grade import InvalidTask
+from eval.graders.verifyit_code import evaluate_functional_correctness as evaluate_code
+
+
+PRESENCE_ASSERTION_HASHES = {
+    737: "74405e35394154c44545aa457b123c9e41cb6972fda22a4aa2107b0b4e8af99b",
+    787: "fee15f5bffad1cf37dabcf1f575665be513e7372815b74e450277da20b20a1ae",
+    794: "0ede41f1c212910df382eccc3e2ce580961736f1dc87ecb134d2c035d894a866",
+}
+
+
+def problem_reference(problem, *, mbpp):
+    if not mbpp:
+        return {**problem, "_verifyit_max_rpc_bytes": 16 * 1048576}
+    test = problem.get("test")
+    canonical = problem.get("code")
+    if not isinstance(test, str) or not test.strip() or not isinstance(canonical, str):
+        raise InvalidTask("MBPPPlus requires trusted code and assertion program")
+    test_tree = ast.parse(test)
+    observation = "identity"
+    if problem.get("task_id") in PRESENCE_ASSERTION_HASHES:
+        if hashlib.sha256(test.encode()).hexdigest() != PRESENCE_ASSERTION_HASHES[problem["task_id"]]:
+            raise InvalidTask("MBPPPlus presence assertion profile changed")
+        assertion = next(n for n in test_tree.body if isinstance(n, ast.FunctionDef) and n.name == "assertion")
+        assertion.body.append(ast.Assert(test=ast.Name(id="exact_match", ctx=ast.Load()), msg=None))
+        test = ast.unparse(ast.fix_missing_locations(test_tree))
+        observation = "bool_or_presence"
+    names = {n.name for n in ast.parse(canonical).body if isinstance(n, ast.FunctionDef)}
+    defined = {n.name for n in ast.walk(test_tree) if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
+    called = {n.func.id for n in ast.walk(test_tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)}
+    entries = (names & called) - defined
+    if len(entries) != 1:
+        raise InvalidTask("MBPPPlus trusted assertions require one candidate entry point")
+    entry = next(iter(entries))
+    reference = (
+        "def _verifyit_check("
+        + entry
+        + "):\n"
+        + "".join("    " + line + "\n" for line in test.splitlines())
+        + "\n_verifyit_check("
+        + entry
+        + ")"
+    )
+    return {
+        **problem,
+        "prompt": canonical,
+        "test": reference,
+        "_verifyit_result_observation": observation,
+        "_verifyit_max_rpc_bytes": 16 * 1048576,
+    }
+
+
+def evaluate_functional_correctness(*, mbpp=False, **options):
+    if options.get("language", "python") != "python" or options.get("is_mbpp", False):
+        raise InvalidTask("Plus source contract requires Python assertion programs")
+    source = Path(options["problem_file"])
+    rows = [json.loads(line) for line in source.read_text().splitlines() if line.strip()]
+    samples = [json.loads(line) for line in Path(options["input_file"]).read_text().splitlines() if line.strip()]
+    with tempfile.TemporaryDirectory(prefix="verifyit-plus-") as directory:
+        problems = Path(directory) / "problems.jsonl"
+        problems.write_text("".join(json.dumps(problem_reference(row, mbpp=mbpp)) + "\n" for row in rows))
+        result = evaluate_code(**{**options, "problem_file": problems})
+    result["scored_count"] = len(samples)
+    return result
diff --git a/tests/graders/test_verifyit_code_plus.py b/tests/graders/test_verifyit_code_plus.py
new file mode 100644
--- /dev/null
+++ b/tests/graders/test_verifyit_code_plus.py
@@ -0,0 +1,74 @@
+"""Plus assertion regressions and typed candidate values through real grading."""
+
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from eval.graders.verifyit_code import DOCKER, IMAGE, grade_completion
+from eval.graders.verifyit_code_plus import evaluate_functional_correctness, problem_reference
+from verifyit.grade import InvalidTask
+
+
+@pytest.fixture(scope="module", autouse=True)
+def candidate_image():
+    if DOCKER is None:
+        pytest.skip("Docker is required for isolated code grading")
+    if subprocess.run([DOCKER, "image", "inspect", IMAGE], capture_output=True, timeout=10).returncode:
+        pytest.skip("Load the pinned verifyit candidate image")
+
+
+@pytest.fixture(scope="module")
+def problems():
+    path = Path(__file__).resolve().parents[2] / "eval/chat_benchmarks/MBPPPlus/data/mbppplus.jsonl"
+    return {row["task_id"]: row for row in map(json.loads, path.read_text().splitlines())}
+
+
+@pytest.mark.parametrize("identifier", [737, 787, 794])
+def test_presence_assertions_reject_wrong_output(problems, identifier):
+    row = problems[identifier]
+    translated = problem_reference(row, mbpp=True)
+    assert grade_completion(translated, row["code"], language="python", is_mbpp=False, timeout=10)
+    import ast
+
+    entry = next(n.name for n in ast.parse(row["code"]).body if isinstance(n, ast.FunctionDef))
+    wrong = "def " + entry + "(*args): return None"
+    assert not grade_completion(translated, wrong, language="python", is_mbpp=False, timeout=10)
+
+
+def test_presence_profile_drift_aborts_batch(problems, tmp_path):
+    rows = [problems[17], {**problems[737], "test": problems[737]["test"] + "\n"}]
+    source = tmp_path / "problems.jsonl"
+    samples = tmp_path / "samples.jsonl"
+    source.write_text("".join(json.dumps(row) + "\n" for row in rows))
+    samples.write_text(
+        "".join(json.dumps({"task_id": row["task_id"], "generation": row["code"]}) + "\n" for row in rows)
+    )
+    with pytest.raises(InvalidTask, match="presence assertion profile changed"):
+        evaluate_functional_correctness(mbpp=True, input_file=samples, problem_file=source)
+
+
+def test_large_integers_and_nonfinite_values_are_data_not_rewards():
+    row = {
+        "prompt": "def echo(x):\n    pass\n",
+        "test": 'import math\ndef check(candidate):\n    assert candidate(1 << 20000) == 1 << 20000\n    assert candidate(float("inf")) == float("inf")\n    assert candidate(float("-inf")) == float("-inf")\n    assert math.isnan(candidate(float("nan")))\ncheck(echo)',
+    }
+    assert grade_completion(row, "def echo(x): return x", language="python", is_mbpp=False, timeout=10)
+    assert not grade_completion(row, 'def echo(x): return float("nan")', language="python", is_mbpp=False, timeout=10)
+
+
+@pytest.mark.parametrize(
+    "bound,size,expected",
+    [(1048576, 2 * 1048576, False), (16 * 1048576, 2 * 1048576, True), (16 * 1048576, 17 * 1048576, False)],
+)
+def test_trusted_plus_frame_bound_and_oversized_output(bound, size, expected):
+    row = {
+        "prompt": "def output():\n    pass\n",
+        "test": f"def check(candidate):\n    assert len(candidate()) == {size}\ncheck(output)",
+        "_verifyit_max_rpc_bytes": bound,
+    }
+    assert (
+        grade_completion(row, f'def output(): return "x" * {size}', language="python", is_mbpp=False, timeout=10)
+        is expected
+    )
