+def compute_score(gold, resp, question_type, *, verifyit_enabled=False):
+    """Opt in to native verifyit composition; preserve the source baseline by default."""
+    if not isinstance(verifyit_enabled, bool):
+        raise ValueError("verifyit_enabled must be a boolean")
+    if not verifyit_enabled:
+        return _native_compute_score(gold, resp, question_type)
+    from verifyit.adapters.evalchemy_jee import grade_jee_answer
+    from verifyit.grade import Status
+
+    verdict = grade_jee_answer(gold, resp, question_type)
+    if verdict.status != Status.SCORED:
+        raise ValueError(f"Unscored JEEBench sample: {verdict.status.value}: {verdict.detail}")
+    return verdict.reward
