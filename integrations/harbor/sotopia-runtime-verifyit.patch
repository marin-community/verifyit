+"""Ordinary Sotopia participant identity regressions with a local provider."""
+
+import asyncio
+import importlib.util
+import json
+import shutil
+import sys
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+pytestmark = pytest.mark.runtime
+
+ROOT = Path(__file__).parents[2]
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"Cannot load runtime module: {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def modules(monkeypatch):
+    monkeypatch.syspath_prepend(str(ROOT / "adapters/sotopia"))
+    runner = load_module(
+        "run_sotopia_agent", ROOT / "adapters/sotopia/run_sotopia_agent.py"
+    )
+    wrapper = load_module(
+        "sotopia_score",
+        ROOT / "adapters/sotopia/src/sotopia/task-template/tests/verifyit_score.py",
+    )
+    return runner, wrapper
+
+
+@pytest.fixture
+def provider():
+    state: dict[str, Any] = {"mode": "reverse", "requests": []}
+    dimensions = [
+        "believability",
+        "relationship",
+        "knowledge",
+        "secret",
+        "social_rules",
+        "financial_and_material_benefits",
+        "goal",
+    ]
+    scores = {
+        name: dict(zip(dimensions, [["Reason", score] for score in values]))
+        for name, values in [
+            ("agent_1", [8, -3, 6, -7, -2, 1, 9]),
+            ("agent_2", [2, 4, 3, -1, -8, -4, 1]),
+        ]
+    }
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            state["requests"].append(
+                json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            )
+            values = {"agent_2": scores["agent_2"], "agent_1": scores["agent_1"]}
+            if state["mode"] == "missing":
+                values.pop("agent_2")
+            content = json.dumps({"evaluations": values})
+            if state["mode"] == "duplicate":
+                content = content.replace('"agent_1":', '"agent_1": {}, "agent_1":', 1)
+            message = {"role": "assistant", "content": content}
+            if (
+                state["mode"] in {"producer-refusal", "producer-malformed"}
+                and state["requests"][-1]["model"] != "judge"
+            ):
+                message["content"] = (
+                    "{}"
+                    if state["mode"] == "producer-malformed"
+                    else json.dumps({"action_type": "none", "argument": ""})
+                )
+            if state["mode"] in {"refusal", "producer-refusal"}:
+                message["refusal"] = "Unable to evaluate"
+            response: dict[str, Any] = {
+                "id": "test",
+                "object": "chat.completion",
+                "created": 1,
+                "model": "judge",
+                "choices": [
+                    {
+                        "index": 0,
+                        "message": message,
+                        "finish_reason": "length"
+                        if state["mode"] == "truncated"
+                        else "stop",
+                    }
+                ],
+            }
+            status = 200
+            if (
+                state["mode"] == "producer-failure"
+                and state["requests"][-1]["model"] != "judge"
+            ):
+                status = 400
+                response = {
+                    "error": {
+                        "type": "invalid_request_error",
+                        "message": "Ordinary provider failure",
+                        "code": "fixture",
+                    }
+                }
+            data = json.dumps(response).encode()
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield state, f"custom/judge@http://127.0.0.1:{server.server_port}/v1"
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+def terminal_input():
+    return {
+        "turn_number": 1,
+        "messages": [
+            {"sender": "Environment", "message": "Alex and Blair have distinct goals."},
+            {"sender": "Alex", "message": 'said: "Agreed."'},
+            {"sender": "Blair", "message": "left the conversation"},
+        ],
+        "history": "",
+        "temperature": 0.0,
+    }
+
+
+def test_reversed_participant_keys_preserve_named_scores_and_source_request(
+    modules, provider
+):
+    runner, wrapper = modules
+    state, model = provider
+    messages = importlib.import_module("sotopia.messages.message_classes")
+
+    terminal = terminal_input()
+    original = asyncio.run(
+        runner.CapturingEpisodeEvaluator(model).__acall__(
+            turn_number=1,
+            messages=[
+                (item["sender"], messages.SimpleMessage(message=item["message"]))
+                for item in terminal["messages"]
+            ],
+        )
+    )
+    corrected = asyncio.run(wrapper.evaluate_terminal(terminal, model, runner, {}))
+    source = runner.unweighted_aggregate_evaluate(original)
+    result = runner.unweighted_aggregate_evaluate(corrected)
+    assert source.p1_rate[1]["goal"] == 1
+    assert source.p2_rate[1]["goal"] == 9
+    assert result.p1_rate[1] == {
+        "believability": 8,
+        "relationship": -3,
+        "knowledge": 6,
+        "secret": -7,
+        "social_rules": -2,
+        "financial_and_material_benefits": 1,
+        "goal": 9,
+        "overall_score": 12 / 7,
+    }
+    assert result.p2_rate[1]["goal"] == 1
+    assert state["requests"][0] == state["requests"][1]
+
+
+@pytest.mark.parametrize("mode", ["missing", "duplicate", "truncated", "refusal"])
+def test_invalid_participant_decisions_exhaust_native_retry_without_credit(
+    modules, provider, mode
+):
+    runner, wrapper = modules
+    state, model = provider
+    state["mode"] = mode
+    diagnostics = {}
+    with pytest.raises(ValueError, match="after 5 attempts"):
+        asyncio.run(
+            wrapper.evaluate_terminal(terminal_input(), model, runner, diagnostics)
+        )
+    assert len(state["requests"]) == 5
+    assert (
+        all(call.get("error") for call in diagnostics["judge_calls"])
+        if mode != "missing"
+        else len(diagnostics["parsed_evaluations"]) == 5
+    )
+
+
+@pytest.mark.parametrize(
+    "mode", ["producer-failure", "producer-refusal", "producer-malformed"]
+)
+def test_failed_conversation_provider_cannot_receive_native_fallback_credit(
+    modules, provider, tmp_path, monkeypatch, mode
+):
+    runner, wrapper = modules
+    state, model = provider
+    state["mode"] = mode
+    config = {
+        "source": {"combo_id": "fixture-combo"},
+        "environment": {
+            "env_id": "fixture-env",
+            "scenario": "Two colleagues plan a meeting.",
+            "agent_goals": ["Meet on Monday.", "Meet on Tuesday."],
+            "relationship": 1,
+        },
+        "agents": [
+            {"agent_id": "fixture-alex", "first_name": "Alex", "last_name": "Example"},
+            {
+                "agent_id": "fixture-blair",
+                "first_name": "Blair",
+                "last_name": "Example",
+            },
+        ],
+        "evaluated_agent_index": 0,
+    }
+    models = {
+        "target_model": model.replace("custom/judge@", "custom/target@"),
+        "partner_model": model.replace("custom/judge@", "custom/partner@"),
+        "evaluator_model": model,
+    }
+    source = asyncio.run(runner.run_episode(config, **models))
+    candidate = asyncio.run(runner.run_episode(config, defer_evaluation=True, **models))
+    assert source["scores"][0]["goal"] == 1
+    assert candidate["producer_errors"]
+    (tmp_path / "task_config.json").write_text(json.dumps(config))
+    artifact = tmp_path / "conversation.json"
+    artifact.write_text(json.dumps(candidate))
+    shutil.copy2(
+        ROOT / "adapters/sotopia/src/sotopia/task-template/tests/verify.py",
+        tmp_path / "verify.py",
+    )
+    monkeypatch.syspath_prepend(str(tmp_path))
+    monkeypatch.setitem(sys.modules, "run_sotopia_agent", runner)
+    monkeypatch.setenv("SOTOPIA_EVALUATOR_MODEL", model)
+    verdict = wrapper.score(tmp_path, artifact)
+    assert verdict["status"] == "infra_error"
+    assert verdict["reward"] == 0
+    assert "judge_calls" not in verdict["detail"]
