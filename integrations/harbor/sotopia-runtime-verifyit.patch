--- /dev/null
+++ b/adapters/sotopia/src/sotopia/task-template/tests/verifyit_score.py
@@ -0,0 +1,311 @@
+"""Judge native Sotopia terminal inputs in the separate verifier runtime."""
+
+import asyncio
+import importlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+from provider_protocol import observed_completion
+
+
+class InvalidTask(ValueError):
+    pass
+
+
+class InvalidCandidate(ValueError):
+    pass
+
+
+def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"Duplicate judge field: {key}")
+        result[key] = value
+    return result
+
+
+def validate_response(response: dict[str, Any]) -> None:
+    choices = response.get("choices")
+    if response.get("error") or not isinstance(choices, list) or len(choices) != 1:
+        raise ValueError("Judge must return one complete choice")
+    choice = choices[0]
+    message = choice.get("message", {})
+    if (
+        choice.get("finish_reason") != "stop"
+        or message.get("role") != "assistant"
+        or message.get("refusal")
+        or message.get("tool_calls")
+        or message.get("function_call")
+        or not isinstance(message.get("content"), str)
+        or not message["content"].strip()
+    ):
+        raise ValueError("Incomplete judge text response")
+    content = message["content"].strip()
+    if content.startswith("```json"):
+        content = content[7:].strip().removesuffix("```").strip()
+    try:
+        parsed = json.loads(content, object_pairs_hook=unique_object)
+    except json.JSONDecodeError:
+        # Preserve the source's explicit format-repair request for malformed JSON.
+        return
+    if not isinstance(parsed, dict):
+        return
+    evaluations = parsed.get("properties", parsed).get("evaluations")
+    if not isinstance(evaluations, dict):
+        return
+    for dimensions in evaluations.values():
+        if not isinstance(dimensions, dict):
+            continue
+        for value in dimensions.values():
+            if (
+                isinstance(value, list)
+                and len(value) == 2
+                and type(value[1]) is not int
+            ):
+                raise ValueError("Judge scores must be integers, without coercion")
+
+
+def validate_config(config: dict[str, Any]) -> None:
+    if not isinstance(config, dict):
+        raise InvalidTask("Task configuration must be an object")
+    if type(config.get("evaluated_agent_index")) is not int or config[
+        "evaluated_agent_index"
+    ] not in (0, 1):
+        raise InvalidTask("Invalid evaluated participant")
+    agents = config.get("agents")
+    environment = config.get("environment")
+    if (
+        not isinstance(agents, list)
+        or len(agents) != 2
+        or not isinstance(environment, dict)
+    ):
+        raise InvalidTask("Expected two trusted participant profiles")
+    for profile in agents:
+        if not isinstance(profile, dict) or any(
+            not isinstance(profile.get(key), str) or not profile[key].strip()
+            for key in ("agent_id", "first_name", "last_name")
+        ):
+            raise InvalidTask("Malformed participant profile")
+    goals = environment.get("agent_goals")
+    if (
+        not isinstance(goals, list)
+        or len(goals) != 2
+        or any(not isinstance(goal, str) or not goal.strip() for goal in goals)
+    ):
+        raise InvalidTask("Expected both trusted goals")
+    if (
+        not isinstance(environment.get("env_id"), str)
+        or not isinstance(environment.get("scenario"), str)
+        or not environment["scenario"].strip()
+    ):
+        raise InvalidTask("Malformed environment profile")
+    source = config.get("source")
+    if (
+        not isinstance(source, dict)
+        or not isinstance(source.get("combo_id"), str)
+        or not source["combo_id"]
+    ):
+        raise InvalidTask("Missing trusted combination identity")
+
+
+def validate_candidate(
+    config: dict[str, Any], candidate: dict[str, Any], runner: Any
+) -> dict[str, Any]:
+    if not isinstance(candidate, dict):
+        raise InvalidCandidate("Conversation artifact must be an object")
+    expected = {
+        "combo_id": config["source"]["combo_id"],
+        "environment_id": config["environment"]["env_id"],
+        "agent_ids": [profile["agent_id"] for profile in config["agents"]],
+        "evaluated_agent_index": config["evaluated_agent_index"],
+    }
+    if any(candidate.get(key) != value for key, value in expected.items()):
+        raise InvalidCandidate("Episode participant or task identity mismatch")
+    terminal = candidate.get("evaluator_input")
+    if (
+        not isinstance(terminal, dict)
+        or terminal.get("history") != ""
+        or terminal.get("temperature") != 0.0
+    ):
+        raise InvalidCandidate("Missing native terminal input")
+    turn = terminal.get("turn_number")
+    messages = terminal.get("messages")
+    if (
+        type(turn) is not int
+        or not 1 <= turn <= 20
+        or not isinstance(messages, list)
+        or len(messages) != 1 + 3 * turn
+    ):
+        raise InvalidCandidate("Incomplete native conversation")
+    try:
+        profiles = [
+            runner.AgentProfile(**runner._profile(profile, "agent_id"))
+            for profile in config["agents"]
+        ]
+        agents = runner.Agents(
+            {
+                agent.agent_name: agent
+                for agent in [
+                    runner.LLMAgent(agent_profile=profile) for profile in profiles
+                ]
+            }
+        )
+        env = runner.ParallelSotopiaEnv(
+            env_profile=runner.EnvironmentProfile(
+                **runner._profile(config["environment"], "env_id")
+            ),
+            action_order="round-robin",
+        )
+        env.reset(agents=agents)
+    except (ValueError, TypeError, KeyError) as error:
+        raise InvalidTask(f"Malformed trusted profile: {error}") from error
+    if len(agents) != 2:
+        raise InvalidTask("Trusted participants must have distinct names")
+    background = {
+        "sender": env.inbox[0][0],
+        "message": env.inbox[0][1].to_natural_language(),
+    }
+    if messages[0] != background:
+        raise InvalidCandidate("Conversation background differs from trusted profiles")
+    names = list(agents)
+    for index, message in enumerate(messages[1:]):
+        if (
+            not isinstance(message, dict)
+            or message.get("sender") != (["Environment"] + names)[index % 3]
+            or not isinstance(message.get("message"), str)
+            or not message["message"]
+        ):
+            raise InvalidCandidate("Conversation participant ordering is incomplete")
+        if index % 3 == 0 and message["message"] != f"Turn #{index // 3 + 1}":
+            raise InvalidCandidate("Conversation turn marker mismatch")
+    return terminal
+
+
+async def evaluate_terminal(
+    terminal: dict[str, Any], model: str, runner: Any, diagnostics: dict[str, Any]
+) -> list:
+    evaluators: Any = importlib.import_module("sotopia.envs.evaluators")
+    generation: Any = importlib.import_module("sotopia.generation_utils.generate")
+    messages_module = importlib.import_module("sotopia.messages.message_classes")
+    original_generate = evaluators.agenerate
+    original_completion = generation.acompletion
+    diagnostics["judge_calls"] = []
+    diagnostics["parsed_evaluations"] = []
+
+    async def checked_completion(**kwargs: Any) -> Any:
+        record = {
+            "request": {
+                key: (
+                    value.model_json_schema()
+                    if key == "response_format" and isinstance(value, type)
+                    else value
+                )
+                for key, value in kwargs.items()
+                if key != "api_key"
+            }
+        }
+        diagnostics["judge_calls"].append(record)
+        try:
+            response = await observed_completion(original_completion, kwargs, record)
+            record["response"] = response.model_dump(mode="json")
+            validate_response(record["response"])
+            return response
+        except Exception as error:
+            record["error"] = f"{type(error).__name__}: {error}"
+            raise
+
+    async def named_generate(**kwargs: Any) -> Any:
+        response = await original_generate(**kwargs)
+        evaluations = response.evaluations
+        diagnostics["parsed_evaluations"].append(response.model_dump(mode="json"))
+        if set(evaluations) != {"agent_1", "agent_2"}:
+            raise ValueError("Judge omitted or renamed a participant")
+        # Native evaluator enumerates values; canonical order preserves named identity.
+        response.evaluations = {key: evaluations[key] for key in ("agent_1", "agent_2")}
+        return response
+
+    setattr(evaluators, "agenerate", named_generate)
+    setattr(generation, "acompletion", checked_completion)
+    try:
+        evaluator = runner.CapturingEpisodeEvaluator(model)
+        return await evaluator.__acall__(
+            turn_number=terminal["turn_number"],
+            messages=[
+                (
+                    message["sender"],
+                    messages_module.SimpleMessage(message=message["message"]),
+                )
+                for message in terminal["messages"]
+            ],
+            history=terminal["history"],
+            temperature=terminal["temperature"],
+        )
+    finally:
+        setattr(evaluators, "agenerate", original_generate)
+        setattr(generation, "acompletion", original_completion)
+
+
+def score(
+    tests: Path = Path("/tests"),
+    candidate_path: Path = Path("/logs/agent/sotopia-summary.json"),
+) -> dict[str, Any]:
+    diagnostics: dict[str, Any] = {}
+    status = "infra_error"
+    reward = 0.0
+    try:
+        try:
+            config = json.loads((tests / "task_config.json").read_text())
+            validate_config(config)
+        except (json.JSONDecodeError, InvalidTask, TypeError, KeyError) as error:
+            raise InvalidTask(str(error)) from error
+        runner = importlib.import_module("run_sotopia_agent")
+        native = importlib.import_module("verify")
+        if not candidate_path.exists():
+            raise InvalidCandidate("Missing conversation artifact")
+        try:
+            candidate = json.loads(candidate_path.read_text())
+            terminal = validate_candidate(config, candidate, runner)
+        except (json.JSONDecodeError, TypeError, KeyError) as error:
+            raise InvalidCandidate(str(error)) from error
+        if candidate.get("producer_errors"):
+            raise RuntimeError(
+                f"Conversation provider failed: {candidate['producer_errors']}"
+            )
+        model = os.environ["SOTOPIA_EVALUATOR_MODEL"]
+        response = asyncio.run(evaluate_terminal(terminal, model, runner, diagnostics))
+        evaluation = runner.unweighted_aggregate_evaluate(response)
+        rates = [evaluation.p1_rate, evaluation.p2_rate]
+        if any(rate is None for rate in rates):
+            raise ValueError("Missing participant rating")
+        scores = [
+            {key: value for key, value in rate[1].items() if key != "overall_score"}
+            for rate in rates
+        ]
+        metrics = [native.normalized_scores(value) for value in scores]
+        diagnostics.update(
+            scores=scores,
+            overall_scores=[rate[0] for rate in rates],
+            participant_metrics=metrics,
+            reasoning=evaluation.comments,
+        )
+        reward = metrics[config["evaluated_agent_index"]]["reward"]
+        diagnostics["native_metrics"] = metrics[config["evaluated_agent_index"]]
+        status = "scored"
+    except InvalidCandidate as error:
+        status = "scored"
+        diagnostics["error"] = str(error)
+    except InvalidTask as error:
+        status = "invalid_task"
+        diagnostics["error"] = str(error)
+    except Exception as error:
+        diagnostics["error"] = f"{type(error).__name__}: {error}"
+    return {"status": status, "reward": reward, "detail": diagnostics}
+
+
+if __name__ == "__main__":
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(score(), allow_nan=False) + "\n"
+    )
