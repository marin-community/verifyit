diff --git a/adapters/sotopia/provider_protocol.py b/adapters/sotopia/provider_protocol.py
new file mode 100644
index 0000000..ac119d4
--- /dev/null
+++ b/adapters/sotopia/provider_protocol.py
@@ -0,0 +1,84 @@
+"""Observe native provider replies before LiteLLM discards protocol fields."""
+
+import importlib
+from typing import Any
+
+OPENAI_PROTOCOLS = frozenset(
+    {"openai", "azure", "openrouter", "together_ai", "hosted_vllm"}
+)
+
+
+def validate_completion(response: dict[str, Any]) -> None:
+    choices = response.get("choices")
+    if response.get("error") or not isinstance(choices, list) or len(choices) != 1:
+        raise ValueError("Provider must return one complete choice")
+    choice = choices[0]
+    message = choice.get("message", {})
+    if (
+        choice.get("finish_reason") != "stop"
+        or message.get("role") != "assistant"
+        or message.get("refusal")
+        or message.get("tool_calls")
+        or message.get("function_call")
+        or not isinstance(message.get("content"), str)
+        or not message["content"].strip()
+    ):
+        raise ValueError("Incomplete provider text response")
+
+
+async def observed_completion(
+    completion: Any, kwargs: dict[str, Any], record: dict[str, Any]
+) -> Any:
+    litellm = importlib.import_module("litellm")
+    httpx: Any = importlib.import_module("httpx")
+    provider = litellm.get_llm_provider(model=kwargs["model"])[1]
+    record["provider"] = provider
+    record["raw_protocol_validation"] = (
+        "openai_compatible" if provider in OPENAI_PROTOCOLS else "normalized_only"
+    )
+    record["raw_responses"] = []
+    # This adapter fixes round-robin actions and supplies both goals: inactive
+    # agents return before generation, and judge/repair calls are sequential.
+    original_send = httpx.AsyncClient.send
+    raw_errors: list[str] = []
+
+    async def observed_send(
+        client: Any, request: Any, *args: Any, **options: Any
+    ) -> Any:
+        response = await original_send(client, request, *args, **options)
+        if (
+            provider not in OPENAI_PROTOCOLS
+            or request.method != "POST"
+            or not request.url.path.rstrip("/").endswith("/chat/completions")
+            or not 200 <= response.status_code < 300
+        ):
+            return response
+        # Native agenerate requests nonstreaming completions. Reading their body
+        # leaves the same cached response for the SDK and preserves its lifecycle.
+        await response.aread()
+        try:
+            payload = response.json()
+        except (ValueError, UnicodeError):
+            return response
+        raw = {"response": payload}
+        record["raw_responses"].append(raw)
+        try:
+            validate_completion(payload)
+        except (ValueError, TypeError, AttributeError) as error:
+            raw["error"] = str(error)
+            raw_errors.append(str(error))
+        return response
+
+    setattr(httpx.AsyncClient, "send", observed_send)
+    try:
+        response = await completion(**kwargs)
+        if raw_errors:
+            raise ValueError("Invalid raw provider envelope: " + "; ".join(raw_errors))
+        if provider in OPENAI_PROTOCOLS and not record["raw_responses"]:
+            raise ValueError("Native provider returned no observable HTTP completion")
+        normalized = response.model_dump(mode="json")
+        record["response"] = normalized
+        validate_completion(normalized)
+        return response
+    finally:
+        setattr(httpx.AsyncClient, "send", original_send)
