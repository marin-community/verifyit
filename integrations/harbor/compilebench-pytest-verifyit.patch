diff --git a/adapters/compilebench/tests/test_verifyit.py b/adapters/compilebench/tests/test_verifyit.py
new file mode 100644
index 0000000..a7caf90
--- /dev/null
+++ b/adapters/compilebench/tests/test_verifyit.py
@@ -0,0 +1,53 @@
+"""The optional verifier declaration stays bound to the reviewed upstream task."""
+
+import tomllib
+from hashlib import sha256
+from pathlib import Path
+
+import pytest
+
+from compilebench import adapter
+
+
+def make_task(tmp_path: Path) -> Path:
+    task = tmp_path / "cowsay"
+    (task / "tests").mkdir(parents=True)
+    (task / "environment").mkdir()
+    (task / "tests/test.sh").write_text("#!/bin/bash\npytest /tests/test_outputs.py\n")
+    (task / "environment/Dockerfile").write_text(
+        "FROM --platform=linux/amd64 ubuntu:22.04\nWORKDIR /workdir\n"
+    )
+    (task / "task.toml").write_text("[verifier]\ntimeout_sec = 900.0\n")
+    return task
+
+
+def test_reviewed_task_gets_binary_pytest_contract(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    task = make_task(tmp_path)
+    monkeypatch.setattr(
+        adapter,
+        "SOURCE_TEST_HASHES",
+        {sha256((task / "tests/test.sh").read_bytes()).hexdigest()},
+    )
+
+    adapter.CompileBenchAdapter._enable_verifyit(task)
+
+    with (task / "tests/verifier.toml").open("rb") as spec_file:
+        spec = tomllib.load(spec_file)
+    assert spec["mode"] == "pytest"
+    assert spec["paths"] == ["/tests/test_outputs.py"]
+    assert spec["args"][:2] == ["--ctrf", "/logs/verifier/ctrf.json"]
+    assert "must_pass" not in spec  # Whole-suite binary policy.
+    assert spec["timeout"] == 900.0
+    image = (task / "environment/Dockerfile").read_text()
+    assert f"verifyit@{adapter.VERIFYIT_REVISION}" in image
+
+
+def test_unreviewed_source_script_fails_before_wiring(tmp_path: Path) -> None:
+    task = make_task(tmp_path)
+
+    with pytest.raises(ValueError, match="Unreviewed CompileBench test script"):
+        adapter.CompileBenchAdapter._enable_verifyit(task)
+
+    assert not (task / "tests/verifier.toml").exists()
