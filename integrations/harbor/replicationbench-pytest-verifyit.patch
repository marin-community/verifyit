+def _validate_finite(value):
+    if isinstance(value, bool) or value is None or isinstance(value, str):
+        return
+    if isinstance(value, (int, float)):
+        if not math.isfinite(value):
+            raise ValueError("expected output contains a nonfinite number")
+        return
+    if isinstance(value, list):
+        for item in value:
+            _validate_finite(item)
+        return
+    if isinstance(value, dict):
+        for item in value.values():
+            _validate_finite(item)
+        return
+    raise ValueError("expected output contains an unsupported value")
+
+
+def _validate_tolerance(value):
+    if value is None:
+        return
+    if isinstance(value, bool):
+        raise ValueError("tolerance must be numeric")
+    if isinstance(value, (int, float)):
+        if not math.isfinite(value) or value < 0:
+            raise ValueError("tolerance must be finite and nonnegative")
+        return
+    if isinstance(value, list):
+        for item in value:
+            _validate_tolerance(item)
+        return
+    if isinstance(value, dict):
+        for item in value.values():
+            _validate_tolerance(item)
+        return
+    raise ValueError("tolerance has an unsupported value")
+
+
+def _validate_tolerance_shape(expected, tolerance):
+    if isinstance(expected, (int, float)) and not isinstance(expected, bool):
+        value = tolerance[0] if isinstance(tolerance, list) and tolerance else (
+            0.0 if isinstance(tolerance, list) else tolerance
+        )
+        if isinstance(tolerance, list) and tolerance and value is None:
+            raise ValueError("numeric tolerance list contains null first element")
+        if value is not None and (isinstance(value, (dict, list, bool))
+                                  or not isinstance(value, (int, float))):
+            raise ValueError("numeric tolerance has incompatible shape")
+        return
+    if isinstance(expected, list):
+        if isinstance(tolerance, list):
+            if len(tolerance) != len(expected):
+                raise ValueError("list tolerance length does not match expected output")
+            for item, item_tolerance in zip(expected, tolerance):
+                _validate_tolerance_shape(item, item_tolerance)
+        else:
+            for item in expected:
+                _validate_tolerance_shape(item, tolerance)
+        return
+    if isinstance(expected, dict):
+        for key, item in expected.items():
+            item_tolerance = (tolerance.get(key, 0.0)
+                              if isinstance(tolerance, dict) else tolerance)
+            _validate_tolerance_shape(item, item_tolerance)
+
+
+def validate_config(config):
+    """Reject malformed trusted references before candidate tests run."""
+    if not isinstance(config, dict) or "expected_output" not in config:
+        raise ValueError("config must include expected_output")
+    if "tolerance" not in config or config["tolerance"] is None:
+        raise ValueError("config must include tolerance")
+    _validate_finite(config["expected_output"])
+    _validate_tolerance(config["tolerance"])
+    _validate_tolerance_shape(config["expected_output"], config["tolerance"])
+    return config
+
