diff --git a/adapters/deepsynth/tests/test_verifier.py b/adapters/deepsynth/tests/test_verifier.py
new file mode 100644
index 0000000..37fd468
--- /dev/null
+++ b/adapters/deepsynth/tests/test_verifier.py
@@ -0,0 +1,79 @@
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def scorer():
+    path = (
+        Path(__file__).parents[1] / "src/deepsynth/task-template/tests/test_outputs.py"
+    )
+    spec = importlib.util.spec_from_file_location("deepsynth_scorer", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize("reference", ["[]", "null", '{"value":NaN}', "not JSON"])
+def test_malformed_reference_is_rejected(scorer, reference):
+    scorer.EXPECTED_ANSWER = reference
+    with pytest.raises(ValueError):
+        scorer.validate_reference()
+
+
+def test_empty_dictionary_reference_remains_valid(scorer):
+    scorer.EXPECTED_ANSWER = "{}"
+    scorer.validate_reference()
+    assert scorer.compute_f1({}, {}) == 1.0
+
+
+def test_source_json_repairs_and_partial_f1_are_preserved(scorer):
+    reference = scorer.parse_json_string(
+        '<Answer>: {"value", 3, "label": "North\nAmerica"'
+    )
+    assert scorer.compute_f1(reference, {"value": 3}) == pytest.approx(2 / 3)
+    assert scorer.compute_f1(reference, {"value": 4}) == 0.0
+
+
+@pytest.mark.parametrize("stop_reason", ["end_turn", "max_tokens"])
+def test_single_token_judge_label_can_finish_at_token_limit(scorer, stop_reason):
+    assert (
+        scorer.validate_judge_response(
+            {
+                "type": "message",
+                "role": "assistant",
+                "stop_reason": stop_reason,
+                "content": [{"type": "text", "text": "A"}],
+            }
+        )
+        == "A"
+    )
+
+
+@pytest.mark.parametrize(
+    "response",
+    [
+        {"stop_reason": "refusal", "content": [{"type": "text", "text": "A"}]},
+        {
+            "stop_reason": "end_turn",
+            "content": [{"type": "text", "text": "A"}, {"type": "text", "text": "B"}],
+        },
+        {
+            "stop_reason": "tool_use",
+            "content": [
+                {"type": "tool_use", "name": "answer", "input": {"label": "A"}}
+            ],
+        },
+        {
+            "stop_reason": "end_turn",
+            "content": [{"type": "text", "text": "A"}],
+            "error": {"message": "incomplete"},
+        },
+    ],
+)
+def test_incomplete_or_conflicting_judge_envelope_is_rejected(scorer, response):
+    with pytest.raises(ValueError):
+        scorer.validate_judge_response(
+            {"type": "message", "role": "assistant", **response}
+        )
