diff --git a/adapters/scicode/tests/test_verifyit_route.py b/adapters/scicode/tests/test_verifyit_route.py
new file mode 100644
index 0000000..acf99e7
--- /dev/null
+++ b/adapters/scicode/tests/test_verifyit_route.py
@@ -0,0 +1,78 @@
+"""Ordinary task-validation regressions for the source Script route."""
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+ADAPTER_PATH = Path(__file__).parents[1] / "adapter.py"
+spec = importlib.util.spec_from_file_location(
+    "scicode_adapter_under_test", ADAPTER_PATH
+)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+@pytest.mark.parametrize(
+    "problem_id,steps",
+    [
+        ("101", [{"test_cases": []}]),
+        ("101", [{"test_cases": "assert True"}]),
+        ("101", [{"test_cases": {"assert True": 1}}]),
+        ("101", [{"test_cases": ["   "]}]),
+        ("62", [{"test_cases": []}]),
+    ],
+)
+def test_empty_evaluated_contract_cannot_generate_positive_task(
+    tmp_path, problem_id, steps
+):
+    dataset = module.SciCodeDataset()
+    dataset._records = {problem_id: {"problem_id": problem_id, "sub_steps": steps}}
+    adapter = module.SciCodeAdapter(tmp_path, dataset=dataset, verifyit_enabled=True)
+    with pytest.raises(ValueError, match="requires nonempty tests"):
+        adapter.generate_task(problem_id)
+    assert not (tmp_path / f"scicode-{problem_id}").exists()
+
+
+def test_prewritten_step_is_excluded_before_validating_remaining_steps(tmp_path):
+    dataset = module.SciCodeDataset()
+    dataset._records = {
+        "62": {
+            "problem_id": "62",
+            "sub_steps": [{"test_cases": []}, {"test_cases": ["assert True"]}],
+        }
+    }
+    adapter = module.SciCodeAdapter(tmp_path, dataset=dataset, verifyit_enabled=True)
+    # A valid remaining contract reaches the real data resolution boundary;
+    # invalid evaluated contracts above fail before creating the task directory.
+    adapter._test_data_path = tmp_path / "missing-reference.h5"
+    with pytest.raises(FileNotFoundError):
+        adapter.generate_task("62")
+    assert (tmp_path / "scicode-62/tests/test_outputs.py").exists()
+
+
+def test_source_empty_step_credit_is_rejected_by_cutover(tmp_path):
+    record = {"problem_id": "101", "sub_steps": [{"test_cases": []}]}
+    dataset = module.SciCodeDataset()
+    dataset._records = {"101": record}
+    adapter = module.SciCodeAdapter(tmp_path / "source", dataset=dataset)
+    task = tmp_path / "source" / "scicode-101"
+    (task / "tests").mkdir(parents=True)
+    adapter._write_test_outputs(task, record)
+    adapter._write_problem_data(task, record)
+    harness_spec = importlib.util.spec_from_file_location(
+        "scicode_empty_step", task / "tests/test_outputs.py"
+    )
+    harness = importlib.util.module_from_spec(harness_spec)
+    harness_spec.loader.exec_module(harness)
+    harness.SOLUTION_PATH = tmp_path / "solution.py"
+    harness.SOLUTION_PATH.write_text("# No implementation\n")
+    harness.REWARD_PATH = tmp_path / "logs" / "reward.json"
+    harness.evaluate()
+    assert json.loads(harness.REWARD_PATH.read_text())["reward"] == 1.0
+    cutover = module.SciCodeAdapter(
+        tmp_path / "cutover", dataset=dataset, verifyit_enabled=True
+    )
+    with pytest.raises(ValueError, match="requires nonempty tests"):
+        cutover.generate_task("101")
