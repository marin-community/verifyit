diff --git a/tests/unit/test_verifyit_ineqmath_runtime.py b/tests/unit/test_verifyit_ineqmath_runtime.py
new file mode 100644
index 0000000..f905346
--- /dev/null
+++ b/tests/unit/test_verifyit_ineqmath_runtime.py
@@ -0,0 +1,47 @@
+"""IneqMath extraction failures cannot receive random or vacuous credit."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@pytest.fixture
+def grader(monkeypatch):
+    path = ROOT / "adapters/ineqmath/template/tests/test_outputs.py"
+    spec = importlib.util.spec_from_file_location("ineqmath_grader", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    monkeypatch.setenv("VERIFYIT_JUDGE_RUNTIME", "1")
+    monkeypatch.setattr(module, "EXTRACTION_RELATION_PROMPT_PATH", str(path))
+    return module
+
+
+def test_invalid_relation_extraction_is_unscored(grader, monkeypatch):
+    monkeypatch.setattr(grader, "query_openai", lambda prompt: "Cannot determine")
+    with pytest.raises(ValueError, match="valid relation label"):
+        grader.extract_relation_answer("The first option seems plausible")
+
+
+@pytest.mark.parametrize("letter", list("ABCDEF"))
+def test_relation_shortcuts_preserve_source_labels(grader, letter):
+    answer = grader.CHOICES_DICT[letter]
+    assert grader.verify_relation_answer(answer, grader.extract_relation_answer(answer))
+
+
+def test_empty_normalized_reference_is_invalid(grader):
+    with pytest.raises(ValueError, match="Empty normalized trusted bound"):
+        grader.verify_bound_answer("$ $", "")
+
+
+def test_bound_judge_failure_remains_unscored(grader, monkeypatch):
+    monkeypatch.setattr(grader, "VERIFICATION_BOUND_PROMPT_PATH", grader.__file__)
+
+    def failed_judge(*args, **kwargs):
+        raise RuntimeError("Judge service unavailable")
+
+    monkeypatch.setattr(grader, "query_openai", failed_judge)
+    with pytest.raises(RuntimeError, match="service unavailable"):
+        grader.verify_bound_answer("C=1", "C=2/2")
