diff --git a/adapters/mmau/src/mmau/task-template/tests/validate_reference.py b/adapters/mmau/src/mmau/task-template/tests/validate_reference.py
new file mode 100644
index 0000000..50982d0
--- /dev/null
+++ b/adapters/mmau/src/mmau/task-template/tests/validate_reference.py
@@ -0,0 +1,30 @@
+"""Validate MMAU's trusted token-comparison inputs before candidate scoring."""
+
+import json
+import re
+from pathlib import Path
+
+
+def load_reference(path: Path) -> dict:
+    info = json.loads(path.read_text())
+    answer = info.get("answer")
+    choices = info.get("choices")
+    if not isinstance(answer, str) or not re.findall(r"\w+", answer):
+        raise ValueError("MMAU answer must contain word tokens")
+    if not isinstance(choices, list) or len(choices) < 2:
+        raise ValueError("MMAU choices must contain at least two answers")
+    if any(
+        not isinstance(choice, str) or not re.findall(r"\w+", choice)
+        for choice in choices
+    ):
+        raise ValueError("MMAU choices must contain word tokens")
+    answer_tokens = set(re.findall(r"\w+", answer.lower()))
+    if not any(
+        set(re.findall(r"\w+", choice.lower())) == answer_tokens for choice in choices
+    ):
+        raise ValueError("MMAU answer must match a choice")
+    return info
+
+
+if __name__ == "__main__":
+    load_reference(Path("/tests/data/info.json"))
diff --git a/adapters/mmau/tests/test_reference.py b/adapters/mmau/tests/test_reference.py
new file mode 100644
index 0000000..7fac58e
--- /dev/null
+++ b/adapters/mmau/tests/test_reference.py
@@ -0,0 +1,37 @@
+"""Reject vacuous or malformed trusted MMAU references before grading."""
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+PATH = Path(__file__).parents[1] / "src/mmau/task-template/tests/validate_reference.py"
+SPEC = importlib.util.spec_from_file_location("mmau_reference", PATH)
+assert SPEC is not None and SPEC.loader is not None
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+@pytest.mark.parametrize(
+    "info",
+    [
+        {"answer": "", "choices": ["cat", "dog"]},
+        {"answer": "...", "choices": ["...", "dog"]},
+        {"answer": "cat", "choices": ["cat", 3]},
+        {"answer": "cat", "choices": ["dog", "bird"]},
+        {"answer": "cat", "choices": []},
+    ],
+)
+def test_invalid_reference_rejected(tmp_path, info):
+    path = tmp_path / "info.json"
+    path.write_text(json.dumps(info))
+    with pytest.raises(ValueError):
+        MODULE.load_reference(path)
+
+
+def test_reference_keeps_source_token_equivalence(tmp_path):
+    info = {"answer": "The CAT!", "choices": ["the cat", "the dog"]}
+    path = tmp_path / "info.json"
+    path.write_text(json.dumps(info))
+    assert MODULE.load_reference(path) == info
