diff --git a/adapters/qcircuitbench/src/qcircuitbench/task-template/tests/verifyit_score.py b/adapters/qcircuitbench/src/qcircuitbench/task-template/tests/verifyit_score.py
new file mode 100644
index 0000000..4911dde
--- /dev/null
+++ b/adapters/qcircuitbench/src/qcircuitbench/task-template/tests/verifyit_score.py
@@ -0,0 +1,157 @@
+"""Retain generated QCircuitBench scoring and expose non-scoring failures."""
+
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+
+RESULT_NAMES = (
+    "qasm_syntax",
+    "code_syntax",
+    "semantic_score",
+    "gate_count_ratio",
+    "shot_ratio",
+    "time_ratio",
+)
+
+
+def native_result_details(results, has_post_processing: bool) -> dict:
+    if not isinstance(results, (tuple, list)) or len(results) != 6:
+        raise ValueError("Native checker must return its six scoring channels")
+    raw = dict(zip(RESULT_NAMES, results))
+    numeric = {name: float(value) for name, value in raw.items()}
+    if not math.isfinite(numeric["semantic_score"]):
+        raise ValueError(
+            f"Native semantic score {raw['semantic_score']!r} is nonfinite before source normalization"
+        )
+    nonfinite = {}
+    for name, value in numeric.items():
+        if math.isfinite(value):
+            continue
+        if (
+            not math.isnan(value)
+            or name in {"qasm_syntax", "semantic_score"}
+            or (name == "code_syntax" and has_post_processing)
+        ):
+            raise ValueError(f"Unexpected nonfinite native channel: {name}")
+        nonfinite[name] = {
+            "raw": str(raw[name]),
+            "reason": "Native auxiliary channel is unavailable or not applicable",
+        }
+        numeric[name] = None
+    return {"native_results": numeric, "nonfinite_auxiliary": nonfinite}
+
+
+def score(tests: Path, candidates: list[Path]) -> dict:
+    try:
+        config = json.loads((tests / "verifyit_reference.json").read_text())
+        if not isinstance(config, dict) or not isinstance(
+            config.get("has_post_processing"), bool
+        ):
+            raise ValueError("Malformed QCircuitBench reference metadata")
+        reference_name = config.get("reference")
+        if (
+            not isinstance(reference_name, str)
+            or Path(reference_name).name != reference_name
+        ):
+            raise ValueError("Reference must name the generated QASM asset")
+        reference = (tests / reference_name).read_bytes()
+        if not reference.strip() or hashlib.sha256(reference).hexdigest() != config.get(
+            "sha256"
+        ):
+            raise ValueError("Trusted QASM differs from generated reference")
+    except OSError as error:
+        return {"status": "infra_error", "reward": 0.0, "detail": {"error": str(error)}}
+    except (ValueError, TypeError) as error:
+        return {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+
+    try:
+        spec = importlib.util.spec_from_file_location(
+            "qcircuit_native", tests / "native_score.py"
+        )
+        if spec is None or spec.loader is None:
+            raise ImportError("Native QCircuitBench verifier is unavailable")
+        native = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(native)
+        candidate = next((path for path in candidates if path.is_file()), None)
+        if candidate is None:
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"missing_solution": True},
+            }
+        vars(native)["SOLUTION_PATH"] = candidate
+        detail = {}
+        failures = []
+        rewards = []
+        check_model = native._call_check_model
+        write_reward = native._write_reward
+        load_solution = native._load_solution
+
+        def observed_check(*args):
+            try:
+                results = check_model(*args)
+                detail.update(
+                    native_result_details(results, config["has_post_processing"])
+                )
+                return results
+            except Exception as error:
+                failures.append(f"{type(error).__name__}: {error}")
+                raise
+
+        def observed_load():
+            try:
+                return load_solution()
+            except Exception as error:
+                detail["candidate_error"] = f"{type(error).__name__}: {error}"
+                raise
+
+        def observed_reward(value, metrics):
+            if not math.isfinite(float(value)):
+                failures.append("Nonfinite primary score before source clamp")
+                return
+            rewards.append(native._clamp(value))
+            detail["native_metrics"] = {
+                name: native._clamp(item) for name, item in metrics.items()
+            }
+            write_reward(value, metrics)
+
+        vars(native).update(
+            _call_check_model=observed_check,
+            _write_reward=observed_reward,
+            _load_solution=observed_load,
+        )
+        native.main()
+        if failures or len(rewards) != 1:
+            return {
+                "status": "infra_error",
+                "reward": 0.0,
+                "detail": {**detail, "errors": failures},
+            }
+        return {"status": "scored", "reward": rewards[0], "detail": detail}
+    except Exception as error:
+        return {
+            "status": "infra_error",
+            "reward": 0.0,
+            "detail": {"error": f"{type(error).__name__}: {error}"},
+        }
+
+
+if __name__ == "__main__":
+    verdict = score(
+        Path("/tests"),
+        [
+            Path("/app/solution.py"),
+            Path("/solution/solution.py"),
+            Path("/home/agent/workspace/solution.py"),
+        ],
+    )
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
