index 0000000..67d006d
--- /dev/null
+++ b/tests/unit/test_verifyit_qcircuitbench_runtime.py
@@ -0,0 +1,37 @@
+"""Regressions for native nonfinite scores before source normalization."""
+
+import importlib.util
+import math
+from pathlib import Path
+
+import pytest
+
+PATH = (
+    Path(__file__).parents[2]
+    / "adapters/qcircuitbench/src/qcircuitbench/task-template/tests/verifyit_score.py"
+)
+SPEC = importlib.util.spec_from_file_location("qcircuit_verifyit", PATH)
+assert SPEC is not None and SPEC.loader is not None
+scorer = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(scorer)
+
+
+@pytest.mark.parametrize("value", [math.nan, math.inf, -math.inf])
+def test_nonfinite_semantic_score_cannot_receive_clamped_credit(value):
+    with pytest.raises(ValueError, match="nonfinite before source normalization"):
+        scorer.native_result_details((1, 1, value, 1, 1, 1), True)
+
+
+def test_legitimate_unused_auxiliary_keeps_finite_fractional_score():
+    result = scorer.native_result_details(
+        (1, math.nan, 1 / 3, 0.5, math.nan, math.nan), False
+    )
+    assert result["native_results"]["semantic_score"] == 1 / 3
+    assert result["native_results"]["gate_count_ratio"] == 0.5
+    assert result["native_results"]["code_syntax"] is None
+    assert set(result["nonfinite_auxiliary"]) == {
+        "code_syntax",
+        "shot_ratio",
+        "time_ratio",
+    }
+    assert result["nonfinite_auxiliary"]["code_syntax"]["raw"] == "nan"
