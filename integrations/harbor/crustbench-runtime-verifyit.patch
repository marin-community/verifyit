diff --git a/adapters/crustbench/cargo_result.py b/adapters/crustbench/cargo_result.py
new file mode 100644
index 0000000..6c3df39
--- /dev/null
+++ b/adapters/crustbench/cargo_result.py
@@ -0,0 +1,38 @@
+"""Interpret the source Cargo test completion summary without rewarding empty suites."""
+
+import re
+import sys
+from pathlib import Path
+
+
+def completed_test_counts(output: str) -> tuple[int, int]:
+    summaries = re.findall(
+        r"^test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed;",
+        output,
+        re.MULTILINE,
+    )
+    return sum(int(passed) for passed, _ in summaries), sum(
+        int(failed) for _, failed in summaries
+    )
+
+
+def validate_completion(status: int, output: str) -> None:
+    passed, failed = completed_test_counts(output)
+    if status == 0:
+        if passed == 0 or failed:
+            raise ValueError("Source Cargo run has no nonempty successful test result")
+        return
+    if status == 1 and failed:
+        # The source fail() already wrote reward0. Only a completed failing test
+        # summary distinguishes this from an unknown build or setup failure.
+        return
+    raise SystemExit(status or 1)
+
+
+def main() -> None:
+    log = Path("/tmp/cargo_test.log")
+    validate_completion(int(sys.argv[1]), log.read_text() if log.exists() else "")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapters/crustbench/tests/test_cargo_result.py b/adapters/crustbench/tests/test_cargo_result.py
new file mode 100644
index 0000000..b69277c
--- /dev/null
+++ b/adapters/crustbench/tests/test_cargo_result.py
@@ -0,0 +1,35 @@
+"""Cargo completion must report executed tests before positive source credit."""
+
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1]))
+from cargo_result import validate_completion
+
+
+@pytest.mark.parametrize(
+    "output",
+    ["", "test result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out;"],
+)
+def test_success_without_executed_tests_is_unscored(output):
+    with pytest.raises(ValueError):
+        validate_completion(0, output)
+
+
+def test_completed_candidate_failure_is_distinct_from_setup_failure():
+    validate_completion(
+        1,
+        "test result: FAILED. 0 passed; 6 failed; 0 ignored; 0 measured; 0 filtered out;",
+    )
+    with pytest.raises(SystemExit) as error:
+        validate_completion(1, "error: linker could not be found")
+    assert error.value.code == 1
+
+
+def test_empty_library_suite_does_not_hide_nonempty_binary_suite():
+    validate_completion(
+        0,
+        "test result: ok. 0 passed; 0 failed;\ntest result: ok. 6 passed; 0 failed;\n",
+    )
