diff --git a/adapters/lawbench/template/tests/verifyit_score.py b/adapters/lawbench/template/tests/verifyit_score.py
new file mode 100644
index 0000000..8e5917b
--- /dev/null
+++ b/adapters/lawbench/template/tests/verifyit_score.py
@@ -0,0 +1,115 @@
+"""Retain LawBench metrics while distinguishing task and runtime failures."""
+
+import importlib
+import json
+import math
+import os
+from pathlib import Path
+
+EVAL_MODULE = "{EVAL_MODULE}"
+EVAL_FUNC = "{EVAL_FUNC}"
+
+
+def score(tests: Path, candidates: list[Path]) -> dict:
+    try:
+        references = json.loads((tests / "ground_truths.json").read_text())
+        if not isinstance(references, list) or not references:
+            raise ValueError("LawBench requires nonempty reference records")
+        if any(
+            not isinstance(row, dict)
+            or not isinstance(row.get("refr"), str)
+            or (not row["refr"].strip() and EVAL_MODULE != "xxcq")
+            or not isinstance(row.get("origin_prompt"), str)
+            for row in references
+        ):
+            raise ValueError("Malformed LawBench reference record")
+    except OSError as error:
+        return {"status": "infra_error", "reward": 0.0, "detail": {"error": str(error)}}
+    except ValueError as error:
+        return {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+
+    try:
+        answers = {}
+        answer_file = next((path for path in candidates if path.is_file()), None)
+        if answer_file is None:
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"missing_answer": True},
+            }
+        for line in answer_file.read_text().splitlines():
+            try:
+                row = json.loads(line)
+            except ValueError:
+                continue
+            if (
+                isinstance(row, dict)
+                and "id" in row
+                and isinstance(row.get("answer"), str)
+            ):
+                answers[str(row["id"])] = row["answer"]
+        if not any(str(index) in answers for index in range(len(references))):
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"missing_answer": True},
+            }
+        for index, row in enumerate(references):
+            prediction = answers.get(str(index), "")
+            row["prediction"] = prediction if isinstance(prediction, str) else ""
+        if all(
+            str(index) in answers and row["prediction"] == row["refr"]
+            for index, row in enumerate(references)
+        ):
+            return {"status": "scored", "reward": 1.0, "detail": {"exact_match": True}}
+        module = importlib.import_module(f"evaluation_functions.{EVAL_MODULE}")
+        metrics = getattr(module, EVAL_FUNC)(references)
+        reward = metrics["score"]
+        if isinstance(reward, bool) or not isinstance(reward, (int, float)):
+            raise ValueError("LawBench score must be numeric")
+        if (
+            not math.isfinite(reward)
+            or reward > 1
+            or (reward < 0 and EVAL_MODULE != "ljp_imprison")
+        ):
+            raise ValueError("LawBench score must be finite and in [0, 1]")
+        json.dumps(metrics, allow_nan=False)
+        missing_empty_references = sum(
+            str(index) not in answers and not row["refr"].strip()
+            for index, row in enumerate(references)
+        )
+        detail = {"native_metrics": metrics}
+        if missing_empty_references:
+            # Entity F1 averages one point for each matching empty entity map.
+            # Omitted answers must not receive that explicit-empty-answer credit.
+            reward -= missing_empty_references / len(references)
+            detail["missing_empty_references"] = missing_empty_references
+        return {
+            "status": "scored",
+            "reward": max(0.0, reward),
+            "detail": detail,
+        }
+    except Exception as error:
+        return {
+            "status": "infra_error",
+            "reward": 0.0,
+            "detail": {"error": f"{type(error).__name__}: {error}"},
+        }
+
+
+if __name__ == "__main__":
+    verdict = score(
+        Path("/tests"),
+        [
+            Path("/app/answer.jsonl"),
+            Path("/root/app/answer.jsonl"),
+            Path("/root/answer.jsonl"),
+        ],
+    )
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
diff --git a/tests/unit/test_verifyit_lawbench_runtime.py b/tests/unit/test_verifyit_lawbench_runtime.py
new file mode 100644
index 0000000..d570c99
--- /dev/null
+++ b/tests/unit/test_verifyit_lawbench_runtime.py
@@ -0,0 +1,66 @@
+"""LawBench candidate omissions differ from broken trusted task data."""
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@pytest.fixture
+def grader():
+    path = ROOT / "adapters/lawbench/template/tests/verifyit_score.py"
+    spec = importlib.util.spec_from_file_location("lawbench_grader", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize(
+    "candidate", [None, "", "not json\n", '{"id":"9","answer":"A"}\n', '{"id":"0"}\n']
+)
+def test_missing_usable_answer_scores_zero(grader, tmp_path, candidate):
+    (tmp_path / "ground_truths.json").write_text(
+        json.dumps([{"origin_prompt": "Choose A or B", "refr": "A"}])
+    )
+    answer = tmp_path / "answer.jsonl"
+    if candidate is not None:
+        answer.write_text(candidate)
+    verdict = grader.score(tmp_path, [answer])
+    assert (verdict["status"], verdict["reward"]) == ("scored", 0.0)
+
+
+def test_reference_validation_precedes_exact_match(grader, tmp_path):
+    reference = tmp_path / "ground_truths.json"
+    answer = tmp_path / "answer.jsonl"
+    reference.write_text(json.dumps([{"origin_prompt": "Choose A or B", "refr": "A"}]))
+    answer.write_text('{"id":"0","answer":"A"}\n')
+    verdict = grader.score(tmp_path, [answer])
+    assert (verdict["status"], verdict["reward"]) == ("scored", 1.0)
+    reference.write_text("[]")
+    verdict = grader.score(tmp_path, [answer])
+    assert (verdict["status"], verdict["reward"]) == ("invalid_task", 0.0)
+
+
+def test_unavailable_reference_is_infrastructure_failure(grader, tmp_path):
+    verdict = grader.score(tmp_path, [tmp_path / "answer.jsonl"])
+    assert (verdict["status"], verdict["reward"]) == ("infra_error", 0.0)
+
+
+@pytest.mark.parametrize(
+    "module, status, reward", [("jec_kd", "invalid_task", 0.0), ("xxcq", "scored", 1.0)]
+)
+def test_empty_entity_reference_differs_from_missing_classification_reference(
+    grader, tmp_path, module, status, reward
+):
+    grader.EVAL_MODULE = module
+    (tmp_path / "ground_truths.json").write_text(
+        json.dumps([{"origin_prompt": "Extract entities", "refr": ""}])
+    )
+    answer = tmp_path / "answer.jsonl"
+    answer.write_text('{"id":"0","answer":""}\n')
+    verdict = grader.score(tmp_path, [answer])
+    assert (verdict["status"], verdict["reward"]) == (status, reward)
