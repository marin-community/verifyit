diff --git a/adapters/llmsr_bench/template/tests/check_reference.py b/adapters/llmsr_bench/template/tests/check_reference.py
new file mode 100644
index 0000000..a38ca39
--- /dev/null
+++ b/adapters/llmsr_bench/template/tests/check_reference.py
@@ -0,0 +1,57 @@
+"""Validate protected numerical data before reading a candidate expression."""
+
+import csv
+import json
+import math
+import os
+from pathlib import Path
+
+
+def validate_data(directory: Path) -> None:
+    expected = None
+    for name in ("train_data.csv", "test_data.csv", "ood_test_data.csv"):
+        path = directory / name
+        if name == "ood_test_data.csv" and not path.exists():
+            continue
+        with path.open(newline="") as stream:
+            rows = list(csv.reader(stream))
+        if len(rows) < 2 or len(rows[0]) < 2:
+            raise ValueError(f"{name} requires named inputs, target and data rows")
+        columns = rows[0]
+        if any(not value.strip() for value in columns) or len(set(columns)) != len(
+            columns
+        ):
+            raise ValueError(f"{name} has empty or duplicate column names")
+        if expected is not None and columns != expected:
+            raise ValueError(f"{name} columns differ from training data")
+        expected = columns
+        for row in rows[1:]:
+            if len(row) != len(columns) or not all(
+                math.isfinite(float(value)) for value in row
+            ):
+                raise ValueError(
+                    f"{name} contains malformed or nonfinite reference data"
+                )
+
+
+def main() -> int:
+    try:
+        validate_data(Path("/data"))
+    except (OSError, ValueError) as error:
+        status = "invalid_task" if isinstance(error, ValueError) else "infra_error"
+        private = Path(os.environ["VERIFYIT_LOGS_DIR"])
+        (private / "native-verdict.json").write_text(
+            json.dumps(
+                {
+                    "status": status,
+                    "reward": 0.0,
+                    "detail": {"error": str(error)},
+                }
+            )
+        )
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/adapters/llmsr_bench/tests/test_verifyit_scores.py b/adapters/llmsr_bench/tests/test_verifyit_scores.py
new file mode 100644
index 0000000..dcf2a76
--- /dev/null
+++ b/adapters/llmsr_bench/tests/test_verifyit_scores.py
@@ -0,0 +1,66 @@
+"""Numerical regressions for retained LLMSR scoring."""
+
+import ast
+import importlib.util
+import math
+import os
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+
+@pytest.fixture
+def scorer():
+    source = Path(__file__).parents[1] / "template/tests/test.sh"
+    body = source.read_text().split("python3 << 'PY'\n", 1)[1].split("\nPY\n", 1)[0]
+    tree = ast.parse(body)
+    functions = [
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name
+        in {
+            "compute_output_base_metrics",
+            "write_reward",
+            "eval_on_df",
+            "safe_eval_expr",
+        }
+    ]
+    namespace = {"np": np, "pd": pd, "os": os, "math": math}
+    exec(
+        compile(ast.Module(body=functions, type_ignores=[]), str(source), "exec"),
+        namespace,
+    )
+    return namespace
+
+
+def test_domain_failure_is_rejected_before_metric_computation(scorer):
+    frame = pd.DataFrame({"x": [-1.0, 0.0, 1.0], "y": [0.0, 0.0, 1.0]})
+    assert scorer["eval_on_df"](frame, "y", ["x"], "sqrt(x)", {}) == (None, None, None)
+
+
+def test_negative_r2_becomes_minimum_without_losing_diagnostic(
+    scorer, monkeypatch, tmp_path
+):
+    monkeypatch.setenv("VERIFYIT_LLMSR_STRICT", "1")
+    result = scorer["compute_output_base_metrics"](
+        np.array([3.0, 3.0]), np.array([0.0, 1.0])
+    )
+    output = tmp_path / "reward.txt"
+    scorer["REWARD_PATH"] = output
+    scorer["write_reward"](result["r2"])
+    assert float(output.read_text()) == 0.0
+    assert result["r2"] == -25.0
+
+
+def test_reference_schema_failure_is_not_candidate_failure(tmp_path):
+    source = Path(__file__).parents[1] / "template/tests/check_reference.py"
+    spec = importlib.util.spec_from_file_location("llmsr_reference", source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    (tmp_path / "train_data.csv").write_text("x,y\n0,1\n")
+    (tmp_path / "test_data.csv").write_text("x,y\n0,nan\n")
+    with pytest.raises(ValueError, match="nonfinite reference"):
+        module.validate_data(tmp_path)
