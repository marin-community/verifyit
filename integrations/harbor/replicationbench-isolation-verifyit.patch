@@ -0,0 +1,105 @@
+"""Regression tests for protected ReplicationBench comparison contracts."""
+
+import importlib.util
+import os
+from pathlib import Path
+
+import pytest
+
+
+TEST_SOURCE = (
+    Path(__file__).parents[1]
+    / "src/replicationbench/task-template/tests/test_outputs.py"
+)
+SPEC = importlib.util.spec_from_file_location("replication_comparator", TEST_SOURCE)
+assert SPEC is not None and SPEC.loader is not None
+COMPARATOR = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(COMPARATOR)
+
+
+@pytest.mark.parametrize(
+    ("actual", "expected", "tolerance"),
+    [
+        (True, 1, 0),
+        (1, True, 0),
+        (float("inf"), float("inf"), 0),
+        (float("nan"), 0, 0),
+        ([1.0, float("inf")], [1.0, float("inf")], [0, 0]),
+        ({"value": True}, {"value": 1}, {"value": 0}),
+    ],
+)
+def test_invalid_candidate_values_do_not_match(actual, expected, tolerance):
+    assert not COMPARATOR._compare_values(actual, expected, tolerance)
+
+
+def test_valid_nested_tolerance_and_explicit_null():
+    actual = [[1.05, "a"], [3.0, None]]
+    expected = [[1.0, "a"], [3.0, None]]
+    tolerance = [[0.1, 0], [0, 0]]
+    assert COMPARATOR._compare_values(actual, expected, tolerance)
+    assert COMPARATOR._compare_values(None, None, 0)
+    assert COMPARATOR._compare_values(True, True, 0)
+
+
+def test_missing_reference_differs_from_explicit_null():
+    with pytest.raises(ValueError, match="expected_output"):
+        COMPARATOR.validate_config({"tolerance": 0})
+    assert COMPARATOR.validate_config({"expected_output": None, "tolerance": 0})
+
+
+@pytest.mark.parametrize("value", [float("nan"), float("inf"), -0.1, True])
+def test_invalid_trusted_tolerance_is_rejected(value):
+    with pytest.raises(ValueError, match="tolerance"):
+        COMPARATOR.validate_config({"expected_output": 1, "tolerance": value})
+
+
+def test_nonfinite_trusted_reference_is_rejected():
+    with pytest.raises(ValueError, match="nonfinite"):
+        COMPARATOR.validate_config(
+            {"expected_output": {"x": [float("inf")]}, "tolerance": 0}
+        )
+
+
+@pytest.mark.parametrize(
+    ("expected", "tolerance"),
+    [
+        (1, {"x": 0.1}),
+        ([1, 2], [0.1]),
+        ([1, 2], {"first": 0.1}),
+        (1, [None]),
+    ],
+)
+def test_incompatible_trusted_tolerance_shape_is_rejected(expected, tolerance):
+    with pytest.raises(ValueError, match="tolerance"):
+        COMPARATOR.validate_config(
+            {"expected_output": expected, "tolerance": tolerance}
+        )
+
+
+def test_scalar_list_and_missing_dictionary_key_tolerances_remain_supported():
+    assert COMPARATOR.validate_config({"expected_output": 1, "tolerance": [0.1, 0.2]})
+    assert COMPARATOR.validate_config(
+        {"expected_output": {"x": 1, "y": 2}, "tolerance": {"x": 0.1}}
+    )
+    assert COMPARATOR.validate_config({"expected_output": {"x": 1}, "tolerance": [0.1]})
+    assert COMPARATOR.validate_config(
+        {"expected_output": [{"x": 1}], "tolerance": {"x": 0.1}}
+    )
+
+
+def test_result_reader_rejects_redirected_and_special_artifacts(tmp_path: Path):
+    result = tmp_path / "result.json"
+    target = tmp_path / "trusted.json"
+    target.write_text('{"value": null}')
+    result.symlink_to(target)
+    with pytest.raises(OSError):
+        COMPARATOR._read_result_json(result)
+
+    result.unlink()
+    os.mkfifo(result)
+    with pytest.raises(ValueError, match="regular file"):
+        COMPARATOR._read_result_json(result)
+
+    result.unlink()
+    result.write_text('{"value": null}')
+    assert COMPARATOR._read_result_json(result) == {"value": None}
