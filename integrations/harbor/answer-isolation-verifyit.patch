@@ -0,0 +1,106 @@
+"""Place answer-file references in a dedicated verifyit grader image."""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+VERIFYIT_REVISION = "ca7fce7c50f61a3b4b26fe1f9609853effadb87c"
+OLD_AGENT_VERIFYIT_REVISION = "08c14eaf912a940fc4e0401698f95b85250b0006"
+
+ANSWER_ROUTES = {
+    "aime": (
+        "expected_answer.txt",
+        "/app/answer.txt",
+        "f189d140c831bfb7a543b5fca2f5c37a5c6ac633c2eab359a7175b378abe3239",
+    ),
+    "gaia": (
+        "expected_answer.txt",
+        "/app/answer.txt",
+        "e3677ca079ca9e5c8d961be1d6c9a021b87b531c0514b8911f4994d67ddb1d22",
+    ),
+    "gpqa-diamond": (
+        "expected_answer.txt",
+        "/app/answer.txt",
+        "73d3f92672c9a0ed4131d39bb0db6411b24f2c984c4539e8be5211db8b41b29b",
+    ),
+    "satbench": (
+        "ground_truth.json",
+        "/workspace/solution.txt",
+        "b882cfbec52e6944fbc186f1c2c4c7004c0d06f6cb4eb6e5dceaffc24a8a3f11",
+    ),
+}
+
+
+def isolate_answer_verifier(task_dir: Path, mode: str) -> None:
+    """Keep the generated agent image, but grade in a clean reference image."""
+    if mode not in ANSWER_ROUTES:
+        raise ValueError(f"unknown answer route {mode!r}")
+    expected_name, answer_path, source_hash = ANSWER_ROUTES[mode]
+    tests = task_dir / "tests"
+    script = tests / "test.sh"
+    expected = tests / expected_name
+    if hashlib.sha256(script.read_bytes()).hexdigest() != source_hash:
+        raise ValueError(f"unreviewed {mode} test script")
+    if not expected.is_file() or expected.is_symlink():
+        raise ValueError(f"missing or redirected {mode} reference")
+    agent_dockerfile = task_dir / "environment" / "Dockerfile"
+    agent_lines = agent_dockerfile.read_text().splitlines(keepends=True)
+    matches = [
+        index
+        for index, line in enumerate(agent_lines)
+        if OLD_AGENT_VERIFYIT_REVISION in line
+    ]
+    if len(matches) != 1:
+        raise ValueError(f"unreviewed {mode} agent Dockerfile")
+    end = matches[0]
+    start = end
+    while start >= 0 and not agent_lines[start].startswith("RUN "):
+        start -= 1
+    if (
+        start < 0
+        or end + 1 >= len(agent_lines)
+        or "rm -rf /var/lib/apt/lists/*" not in agent_lines[end + 1]
+    ):
+        raise ValueError(f"unreviewed {mode} verifier install block")
+    config_path = task_dir / "task.toml"
+    config = config_path.read_text()
+    if (
+        config.count("[verifier]\n") != 1
+        or "artifacts =" in config
+        or "[verifier.environment]" in config
+    ):
+        raise ValueError(f"unreviewed {mode} task configuration")
+    agent_dockerfile.write_text("".join(agent_lines[:start] + agent_lines[end + 2 :]))
+    config_path.write_text(
+        f'artifacts = ["{answer_path}"]\n'
+        + config.replace(
+            "[verifier]\n", '[verifier]\nenvironment_mode = "separate"\n', 1
+        )
+        + "\n[verifier.environment]\n"
+        + "build_timeout_sec = 300.0\n"
+        + "cpus = 1\n"
+        + "memory_mb = 1024\n"
+        + "storage_mb = 2048\n"
+        + "gpus = 0\n"
+        + "allow_internet = false\n"
+    )
+    script.write_text(
+        "#!/bin/bash\n"
+        "exec /opt/verifyit/bin/python -m verifyit.adapters.harbor_answers "
+        f"{mode} /tests/{expected_name} {answer_path} --logs-dir /logs/verifier\n"
+    )
+    script.chmod(0o755)
+    (tests / "Dockerfile").write_text(
+        "FROM python:3.11-slim\n"
+        "WORKDIR /app\n"
+        f"RUN mkdir -p {Path(answer_path).parent}\n"
+        "RUN apt-get update && apt-get install -y --no-install-recommends git "
+        "&& rm -rf /var/lib/apt/lists/* \\\n"
+        "    && python -m venv /opt/verifyit \\\n"
+        "    && /opt/verifyit/bin/pip install --no-cache-dir "
+        f"'verifyit @ git+https://github.com/marin-community/verifyit@{VERIFYIT_REVISION}'\n"
+        f"COPY {expected_name} /tests/{expected_name}\n"
+        "COPY test.sh /tests/test.sh\n"
+        f"RUN chmod 0444 /tests/{expected_name} && chmod 0555 /tests/test.sh\n"
+    )
diff --git a/tests/unit/test_verifyit_answer_isolation.py b/tests/unit/test_verifyit_answer_isolation.py
new file mode 100644
index 0000000..f2c72b9
--- /dev/null
+++ b/tests/unit/test_verifyit_answer_isolation.py
@@ -0,0 +1,86 @@
+"""Generated answer tasks keep references in a dedicated verifier image."""
+
+from pathlib import Path
+
+import pytest
+
+from harbor.models.task.config import VerifierEnvironmentMode
+from harbor.models.task.task import Task
+from harbor.tasks.verifyit_answer_isolation import isolate_answer_verifier
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@pytest.mark.parametrize(
+    ("mode", "source_script", "expected_name", "answer_path"),
+    [
+        (
+            "aime",
+            "adapters/aime/src/aime/task-template/tests/test.sh",
+            "expected_answer.txt",
+            "/app/answer.txt",
+        ),
+        (
+            "gaia",
+            "adapters/gaia/template/tests/test.sh",
+            "expected_answer.txt",
+            "/app/answer.txt",
+        ),
+        (
+            "gpqa-diamond",
+            "adapters/gpqa-diamond/template/tests/test.sh",
+            "expected_answer.txt",
+            "/app/answer.txt",
+        ),
+        (
+            "satbench",
+            "adapters/satbench/src/satbench/task-template/tests/test.sh",
+            "ground_truth.json",
+            "/workspace/solution.txt",
+        ),
+    ],
+)
+def test_answer_route_separates_protected_reference(
+    tmp_path: Path, mode: str, source_script: str, expected_name: str, answer_path: str
+) -> None:
+    task = tmp_path / "task"
+    tests = task / "tests"
+    tests.mkdir(parents=True)
+    (task / "instruction.md").write_text("Answer the question.\n")
+    environment = task / "environment"
+    environment.mkdir()
+    (environment / "Dockerfile").write_bytes(
+        (
+            ROOT / source_script.replace("/tests/test.sh", "/environment/Dockerfile")
+        ).read_bytes()
+    )
+    (tests / "test.sh").write_bytes((ROOT / source_script).read_bytes())
+    (tests / expected_name).write_text("A")
+    (task / "task.toml").write_text('version = "1.0"\n[verifier]\ntimeout_sec = 30.0\n')
+
+    isolate_answer_verifier(task, mode)
+
+    parsed = Task(task).config
+    assert parsed.verifier.environment_mode == VerifierEnvironmentMode.SEPARATE
+    assert parsed.artifacts == [answer_path]
+    assert (tests / "Dockerfile").exists()
+    assert (
+        f"RUN mkdir -p {Path(answer_path).parent}" in (tests / "Dockerfile").read_text()
+    )
+    assert (
+        "08c14eaf912a940fc4e0401698f95b85250b0006"
+        not in (environment / "Dockerfile").read_text()
+    )
+
+
+def test_answer_route_rejects_redirected_reference(tmp_path: Path) -> None:
+    tests = tmp_path / "tests"
+    tests.mkdir()
+    (tests / "test.sh").write_bytes(
+        (ROOT / "adapters/gaia/template/tests/test.sh").read_bytes()
+    )
+    (tests / "expected_answer.txt").symlink_to(tests / "test.sh")
+    (tmp_path / "task.toml").write_text('version = "1.0"\n[verifier]\n')
+
+    with pytest.raises(ValueError, match="reference"):
+        isolate_answer_verifier(tmp_path, "gaia")
