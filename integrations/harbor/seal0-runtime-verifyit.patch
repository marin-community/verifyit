diff --git a/adapters/seal0/src/seal0/task-template/tests/verifyit_score.py b/adapters/seal0/src/seal0/task-template/tests/verifyit_score.py
new file mode 100644
index 0000000..469d936
--- /dev/null
+++ b/adapters/seal0/src/seal0/task-template/tests/verifyit_score.py
@@ -0,0 +1,205 @@
+"""Run the retained Seal-0 scorer without hiding configured judge failures."""
+
+import importlib
+import json
+import os
+import math
+import re
+import unicodedata
+from decimal import Decimal, InvalidOperation
+from pathlib import Path
+from typing import Any
+
+
+def validate_response(response: dict) -> str:
+    blocks = response.get("content")
+    if (
+        response.get("error")
+        or response.get("type") != "message"
+        or response.get("role") != "assistant"
+        or not isinstance(blocks, list)
+        or len(blocks) != 1
+        or blocks[0].get("type") != "text"
+        or not isinstance(blocks[0].get("text"), str)
+    ):
+        raise ValueError("Judge must return one complete text decision")
+    decision = blocks[0]["text"].strip().upper()
+    if decision not in {"A", "B", "C"}:
+        raise ValueError("Judge decision must be exactly A, B, or C")
+    stop = response.get("stop_reason")
+    # The source requests one token for its complete single-letter grammar.
+    tokens = response.get("usage", {}).get("output_tokens")
+    if stop == "max_tokens" and type(tokens) is int and tokens == 1:
+        return decision
+    if stop != "end_turn":
+        raise ValueError("Judge response did not complete its decision")
+    return decision
+
+
+NUMBER = re.compile(
+    r"[-+]?(?:(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?",
+    re.ASCII,
+)
+
+
+def numeric_guard(predicted: str, expected: str) -> dict | None:
+    candidate = unicodedata.normalize("NFKD", predicted).strip()
+    reference = unicodedata.normalize("NFKD", expected).strip()
+    if not NUMBER.fullmatch(candidate) or not NUMBER.fullmatch(reference):
+        return None
+    try:
+        actual = Decimal(candidate.replace(",", ""))
+        target = Decimal(reference.replace(",", ""))
+    except InvalidOperation:
+        return {"reward": 0.0, "reason": "unrepresentable_numeric_literal"}
+    if not actual.is_finite() or not target.is_finite():
+        return {"reward": 0.0, "reason": "nonfinite_numeric_literal"}
+    detail = {"expected": str(target), "candidate": str(actual)}
+    if actual != target:
+        return {"reward": 0.0, "reason": "unequal_numeric_literals", **detail}
+    # Decimal comparison prevents both float overflow equality and loss of low digits.
+    # Preserve equal finite decimals outside the existing float primitive's domain.
+    if not math.isfinite(float(target)):
+        return {"reward": 1.0, "reason": "equal_decimal_outside_float_domain", **detail}
+    spec_module = importlib.import_module("verifyit.spec")
+    numeric = importlib.import_module("verifyit.modes.grade_math")
+    result = numeric.grade_numeric_candidate(
+        spec_module.NumericSpec(
+            expected=float(target), tolerance_abs=0, tolerance_rel=0
+        ),
+        float(actual),
+    )
+    return {"reward": result.reward, "reason": "numeric_exact", **detail}
+
+
+def score(tests: Path, answer: Path) -> dict:
+    try:
+        task = json.loads((tests / "task_data.json").read_text())
+        if not isinstance(task, dict) or any(
+            not isinstance(task.get(name), str) or not task[name].strip()
+            for name in ("question", "answer")
+        ):
+            raise ValueError("Trusted question and answer must be nonempty text")
+    except OSError as error:
+        return {"status": "infra_error", "reward": 0.0, "detail": {"error": str(error)}}
+    except (ValueError, TypeError) as error:
+        return {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+
+    try:
+        native: Any = importlib.import_module("test_outputs")
+        if not native.normalize(task["answer"]):
+            return {
+                "status": "invalid_task",
+                "reward": 0.0,
+                "detail": {"error": "Trusted answer normalizes to empty text"},
+            }
+        if not answer.exists():
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"missing_answer": True},
+            }
+        try:
+            predicted = answer.read_text().strip()
+        except (OSError, UnicodeError) as error:
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"unreadable_answer": str(error)},
+            }
+        if not predicted:
+            return {"status": "scored", "reward": 0.0, "detail": {"empty_answer": True}}
+
+        configured = bool(os.environ.get("ANTHROPIC_API_KEY", ""))
+        failures = []
+        responses = []
+        judge_results = []
+        requests = []
+        original_judge = native.llm_judge
+        original_answer = native.ANSWER_FILE
+        original_task = native.TASK_DATA_FILE
+        provider: Any = None
+        original_client = None
+
+        def tracked_judge(*args, **kwargs):
+            result = original_judge(*args, **kwargs)
+            judge_results.append(result)
+            if configured and result is None:
+                failures.append("Configured source judge returned no decision")
+            return result
+
+        try:
+            if configured:
+                provider = importlib.import_module("anthropic")
+                original_client = provider.Anthropic
+
+                def tracked_client(*args, **kwargs):
+                    client = original_client(*args, **kwargs)
+                    create = client.messages.create
+
+                    def checked_create(*args, **kwargs):
+                        requests.append(kwargs)
+                        response = create(*args, **kwargs)
+                        raw = response.model_dump()
+                        responses.append(raw)
+                        try:
+                            validate_response(raw)
+                        except (ValueError, TypeError, AttributeError) as error:
+                            failures.append(str(error))
+                        return response
+
+                    client.messages.create = checked_create
+                    return client
+
+                provider.Anthropic: Any = tracked_client
+            native.ANSWER_FILE: str = str(answer)
+            native.TASK_DATA_FILE: str = str(tests / "task_data.json")
+            native.llm_judge: Any = tracked_judge
+            result = native.test_answer()
+        finally:
+            native.ANSWER_FILE = original_answer
+            native.TASK_DATA_FILE = original_task
+            native.llm_judge = original_judge
+            if provider is not None and original_client is not None:
+                provider.Anthropic: Any = original_client
+        detail = {
+            "native_reward": float(result),
+            "source_judge_results": judge_results,
+            "route": "configured_judge"
+            if configured
+            else "unconfigured_string_fallback",
+            "judge_requests": requests,
+            "judge_responses": responses,
+        }
+        if failures:
+            return {
+                "status": "infra_error",
+                "reward": 0.0,
+                "detail": {**detail, "judge_failures": failures},
+            }
+        if result and not configured:
+            correction = numeric_guard(predicted, task["answer"])
+            if correction is not None:
+                return {
+                    "status": "scored",
+                    "reward": correction["reward"],
+                    "detail": {**detail, "numeric_guard": correction},
+                }
+        return {"status": "scored", "reward": float(result), "detail": detail}
+    except Exception as error:
+        return {
+            "status": "infra_error",
+            "reward": 0.0,
+            "detail": {"error": f"{type(error).__name__}: {error}"},
+        }
+
+
+if __name__ == "__main__":
+    verdict = score(Path("/tests"), Path("/app/answer.txt"))
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
