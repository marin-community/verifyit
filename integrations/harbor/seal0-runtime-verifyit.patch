@@ -0,0 +1,93 @@
+"""Regression coverage for lossy numeric fallback and one-token judge decisions."""
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+SOURCE = Path(__file__).parents[2] / "adapters/seal0/src/seal0/task-template/tests"
+SPEC = importlib.util.spec_from_file_location(
+    "seal0_verifyit", SOURCE / "verifyit_score.py"
+)
+assert SPEC is not None and SPEC.loader is not None
+scorer = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(scorer)
+
+
+@pytest.mark.parametrize(
+    "expected,predicted,reward",
+    [
+        ("8.7", "87", 0),
+        ("87", "8.7", 0),
+        ("-10", "10", 0),
+        ("-1e-400", "1e-400", 0),
+        ("8.7", "8.70000000000000000001", 0),
+        ("1e400", "1e4000", 0),
+        ("1e400", "1e400", 1),
+        ("7,874", "7874", 1),
+        ("8.70", "8.7", 1),
+    ],
+)
+def test_positive_fallback_retains_native_result_and_rejects_unequal_numbers(
+    tmp_path, monkeypatch, expected, predicted, reward
+):
+    monkeypatch.syspath_prepend(str(SOURCE))
+    monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+    (tmp_path / "task_data.json").write_text(
+        json.dumps({"question": "What is the value?", "answer": expected})
+    )
+    answer = tmp_path / "answer.txt"
+    answer.write_text(predicted)
+    result = scorer.score(tmp_path, answer)
+    assert result["status"] == "scored"
+    assert result["detail"]["native_reward"] == 1
+    assert result["reward"] == reward
+
+
+def test_text_containment_and_source_negative_are_unchanged(tmp_path, monkeypatch):
+    monkeypatch.syspath_prepend(str(SOURCE))
+    monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+    answer = tmp_path / "answer.txt"
+    for expected, predicted, reward in [
+        ("St. John's College", "John", 1),
+        ("3 seconds", "3", 1),
+        ("1000", "1e3", 0),
+        ("answer", " !!! ", 0),
+    ]:
+        (tmp_path / "task_data.json").write_text(
+            json.dumps({"question": "What is the answer?", "answer": expected})
+        )
+        answer.write_text(predicted)
+        result = scorer.score(tmp_path, answer)
+        assert (result["status"], result["reward"]) == ("scored", reward)
+        assert "numeric_guard" not in result["detail"]
+
+
+@pytest.mark.parametrize(
+    "stop,tokens,text,valid",
+    [
+        ("end_turn", 1, "A", True),
+        ("end_turn", 1, "B", True),
+        ("end_turn", 1, "C", True),
+        ("max_tokens", 1, "A", True),
+        ("max_tokens", True, "A", False),
+        ("max_tokens", 1, "A or B", False),
+        ("tool_use", 1, "A", False),
+    ],
+)
+def test_single_letter_judge_grammar_respects_one_token_contract(
+    stop, tokens, text, valid
+):
+    response = {
+        "type": "message",
+        "role": "assistant",
+        "content": [{"type": "text", "text": text}],
+        "stop_reason": stop,
+        "usage": {"output_tokens": tokens},
+    }
+    if valid:
+        assert scorer.validate_response(response) == text
+    else:
+        with pytest.raises(ValueError):
+            scorer.validate_response(response)
