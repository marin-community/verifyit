index 0000000..be7d103
--- /dev/null
+++ b/adapters/widesearch/template/tests/verifyit_score.py
@@ -0,0 +1,341 @@
+"""Run WideSearch's retained table scorer with explicit runtime failures."""
+
+import importlib
+import json
+import math
+import os
+import re
+from pathlib import Path
+from typing import Any
+from io import StringIO
+
+METRICS = {
+    "exact_match",
+    "url_match",
+    "in_match",
+    "number_near",
+    "date_near",
+    "llm_judge",
+}
+PREPROCESSORS = {"norm_str", "extract_number", "norm_date"}
+CHANNELS = {
+    "score",
+    "precision_by_row",
+    "recall_by_row",
+    "f1_by_row",
+    "precision_by_item",
+    "recall_by_item",
+    "f1_by_item",
+}
+
+
+def validate_config(config: dict) -> None:
+    required = config.get("required")
+    keys = config.get("unique_columns")
+    pipeline = config.get("eval_pipeline")
+    for name, values in (("required", required), ("unique_columns", keys)):
+        if (
+            not isinstance(values, list)
+            or not values
+            or any(not isinstance(v, str) or not v for v in values)
+            or len(set(values)) != len(values)
+        ):
+            raise ValueError(f"{name} must contain distinct nonempty column names")
+    assert isinstance(keys, list) and isinstance(required, list)
+    if not set(keys) <= set(required) or not isinstance(pipeline, dict):
+        raise ValueError("Invalid key columns or evaluation pipeline")
+    for col, spec in pipeline.items():
+        if col not in required or not isinstance(spec, dict):
+            raise ValueError("Invalid evaluation column")
+        metrics = spec.get("metric", [])
+        steps = spec.get("preprocess", [])
+        if (
+            not isinstance(metrics, list)
+            or any(m not in METRICS for m in metrics)
+            or not isinstance(steps, list)
+            or any(s not in PREPROCESSORS for s in steps)
+        ):
+            raise ValueError("Unknown metric or preprocessing step")
+        criterion = spec.get("criterion")
+        if "number_near" in metrics and criterion is not None:
+            if (
+                isinstance(criterion, bool)
+                or not isinstance(criterion, (int, float))
+                or not math.isfinite(criterion)
+                or criterion < 0
+            ):
+                raise ValueError("Numeric tolerance must be finite and nonnegative")
+        if (
+            "llm_judge" in metrics
+            and criterion is not None
+            and not isinstance(criterion, str)
+        ):
+            raise ValueError("Judge criterion must be text")
+
+
+def validate_response(response: dict) -> None:
+    choices = response.get("choices")
+    if response.get("error") or not isinstance(choices, list) or len(choices) != 1:
+        raise ValueError("Judge must return one complete text choice")
+    choice = choices[0]
+    message = choice.get("message", {})
+    if (
+        choice.get("finish_reason") != "stop"
+        or message.get("refusal")
+        or message.get("tool_calls")
+        or message.get("function_call")
+        or not isinstance(message.get("content"), str)
+    ):
+        raise ValueError("Judge returned an incomplete or non-text decision")
+
+
+def parse_decision(text: str) -> dict:
+    def unique_object(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ValueError("Judge JSON contains duplicate object keys")
+            result[key] = value
+        return result
+
+    matches = re.findall(r"```json\s*(\{.*?\})\s*```", text, re.DOTALL)
+    if not matches:
+        raise ValueError("Judge decision has no source-format JSON block")
+    result = json.loads(matches[-1], object_pairs_hook=unique_object)
+    if not isinstance(result, dict):
+        raise ValueError("Judge decision must be a JSON object")
+    return result
+
+
+def score(tests: Path, workspace: Path) -> dict:
+    try:
+        config = json.loads((tests / "eval_config.json").read_text())
+        validate_config(config)
+        gold_text = (tests / "gold_answer.csv").read_text()
+    except OSError as error:
+        return {"status": "infra_error", "reward": 0.0, "detail": {"error": str(error)}}
+    except (ValueError, TypeError, AttributeError) as error:
+        return {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+
+    try:
+        native: Any = importlib.import_module("evaluate")
+        metrics: Any = importlib.import_module("metric_utils")
+        gold = native.pd.read_csv(StringIO(gold_text))
+        gold.columns = [native.norm_column(col) for col in gold.columns]
+        required = config["required"]
+        keys = config["unique_columns"]
+        if (
+            gold.empty
+            or not set(required) <= set(gold.columns)
+            or not gold.columns.is_unique
+        ):
+            raise ValueError(
+                "Trusted table must have rows and distinct required columns"
+            )
+    except (ValueError, KeyError) as error:
+        return {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+    except Exception as error:
+        return {"status": "infra_error", "reward": 0.0, "detail": {"error": str(error)}}
+
+    failures = []
+    calls = []
+    assignment = {}
+    native_result = None
+    original_key = native.primary_key_preprocess
+    original_column = native.llm_judge_column
+    original_completion = metrics._llm_completion
+    original_merge = native.pd.merge
+    original_dedup = native.pd.DataFrame.drop_duplicates
+    client = None
+    original_create = None
+    preprocessing_collisions = []
+
+    def tracked_completion(*args, **kwargs):
+        result = original_completion(*args, **kwargs)
+        calls.append({"text": result})
+        return result
+
+    def parsed_call(start):
+        if len(calls) != start + 1 or calls[-1]["text"] is None:
+            failures.append("Judge call returned no decision")
+            return None
+        try:
+            parsed = parse_decision(calls[-1]["text"])
+        except ValueError as error:
+            failures.append(str(error))
+            return None
+        return parsed
+
+    def tracked_key(response, reference, *args, **kwargs):
+        start = len(calls)
+        result = original_key(response, reference, *args, **kwargs)
+        parsed = parsed_call(start)
+        if parsed is not None:
+            if any(
+                not isinstance(k, str)
+                or not isinstance(v, str)
+                or k not in response
+                or (v not in reference and v != k)
+                or (k in reference and v != k)
+                for k, v in parsed.items()
+            ):
+                failures.append("Judge mapping violates source vocabulary alignment")
+        return result
+
+    def tracked_column(responses, targets, *args, **kwargs):
+        start = len(calls)
+        result = original_column(responses, targets, *args, **kwargs)
+        parsed = parsed_call(start)
+        expected = {f"idx_{i}" for i in range(len(responses))}
+        if parsed is not None and (
+            set(parsed) != expected
+            or any(
+                isinstance(v, bool)
+                or not isinstance(v, (int, float))
+                or v not in (0, 1)
+                for v in parsed.values()
+            )
+        ):
+            failures.append(
+                "Judge must score every aligned item with numeric zero or one"
+            )
+        return result
+
+    def tracked_dedup(frame, *args, **kwargs):
+        result = original_dedup(frame, *args, **kwargs)
+        if kwargs.get("inplace") and kwargs.get("subset") == keys:
+            projected = frame[keys].copy()
+            for col in keys:
+                steps = config["eval_pipeline"].get(col, {}).get("preprocess", [])
+                projected[col] = projected[col].apply(
+                    lambda value: native.preprocess_value(value, steps)
+                )
+            preprocessing_collisions.append(
+                bool(projected.duplicated(subset=keys).any())
+            )
+        return result
+
+    def tracked_merge(left, right, *args, **kwargs):
+        assignment.update(
+            gold_rows=len(left),
+            prediction_rows=len(right),
+            metric_columns=sum(
+                1
+                if col in keys
+                else len(
+                    config["eval_pipeline"].get(col, {}).get("metric")
+                    or ["exact_match"]
+                )
+                for col in required
+            ),
+        )
+        if right.duplicated(subset=keys).any():
+            assignment["collision"] = (
+                "candidate_preprocessing"
+                if preprocessing_collisions[0]
+                else "judge_alignment"
+            )
+        result = original_merge(left, right, *args, **kwargs)
+        assignment["matched_rows"] = len(result)
+        return result
+
+    try:
+        text = native._resolve_output_text(workspace / "output.md", workspace)
+        candidate = (
+            native.extract_markdown_table(text) if text and text.strip() else None
+        )
+        if candidate is None or candidate.empty:
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"missing_or_empty_table": True},
+            }
+        candidate.columns = [native.norm_column(col) for col in candidate.columns]
+        client = metrics._get_openai_client()
+        if client is not None:
+            original_create = client.chat.completions.create
+
+            def checked_create(*args, **kwargs):
+                response = original_create(*args, **kwargs)
+                try:
+                    validate_response(response.model_dump())
+                except (ValueError, TypeError, AttributeError) as error:
+                    failures.append(str(error))
+                return response
+
+            client.chat.completions.create = checked_create
+        native.primary_key_preprocess: Any = tracked_key
+        native.llm_judge_column: Any = tracked_column
+        metrics._llm_completion: Any = tracked_completion
+        native.pd.merge: Any = tracked_merge
+        native.pd.DataFrame.drop_duplicates: Any = tracked_dedup
+        native_result = native.evaluate(
+            workspace / "output.md",
+            tests / "gold_answer.csv",
+            tests / "eval_config.json",
+            workspace,
+        )
+        detail = {
+            "native_metrics": native_result,
+            "assignment": assignment,
+            "judge_calls": len(calls),
+        }
+        detail["preprocessing_collisions"] = preprocessing_collisions
+        if len(preprocessing_collisions) == 2 and preprocessing_collisions[1]:
+            return {"status": "invalid_task", "reward": 0.0, "detail": detail}
+        if failures or assignment.get("collision") == "judge_alignment":
+            return {
+                "status": "infra_error",
+                "reward": 0.0,
+                "detail": {**detail, "judge_failures": failures},
+            }
+        if assignment.get("collision") == "candidate_preprocessing":
+            return {"status": "scored", "reward": 0.0, "detail": detail}
+        if any(
+            not isinstance(native_result.get(key), (int, float))
+            or not math.isfinite(native_result[key])
+            or not 0 <= native_result[key] <= 1
+            for key in CHANNELS
+        ):
+            raise ValueError("Native score channels must be finite and in [0, 1]")
+        return {
+            "status": "scored",
+            "reward": native_result["f1_by_item"],
+            "detail": detail,
+        }
+    except Exception as error:
+        return {
+            "status": "infra_error",
+            "reward": 0.0,
+            "detail": {
+                "error": f"{type(error).__name__}: {error}",
+                "native_metrics": native_result,
+                "judge_failures": failures,
+            },
+        }
+    finally:
+        native.primary_key_preprocess = original_key
+        native.llm_judge_column = original_column
+        metrics._llm_completion = original_completion
+        native.pd.merge = original_merge
+        native.pd.DataFrame.drop_duplicates = original_dedup
+        if client is not None and original_create is not None:
+            client.chat.completions.create = original_create
+
+
+if __name__ == "__main__":
+    verdict = score(Path("/tests"), Path("/workspace"))
+    verdict = json.loads(
+        json.dumps(verdict), parse_constant=lambda value: {"nonfinite": value}
+    )
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
diff --git a/tests/unit/test_verifyit_widesearch_runtime.py b/tests/unit/test_verifyit_widesearch_runtime.py
new file mode 100644
index 0000000..08808c2
--- /dev/null
+++ b/tests/unit/test_verifyit_widesearch_runtime.py
@@ -0,0 +1,186 @@
+"""Table denominators and malformed judge replies through the retained scorer."""
+
+import ast
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from threading import Thread
+
+import pytest
+
+SOURCE = Path(__file__).parents[2] / "adapters/widesearch/template/tests"
+
+
+@pytest.fixture
+def judge():
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            prompt = request["messages"][0]["content"]
+            if "The vocabulary to be aligned is as follows:" in prompt:
+                values = ast.literal_eval(
+                    prompt.split("The vocabulary to be aligned is as follows:\n")[
+                        1
+                    ].split("\n\n")[0]
+                )
+                result = {v: v.removeprefix("alias:") for v in values}
+            else:
+                values = ast.literal_eval(
+                    prompt.split("====== response-start ======\n")[1].split(
+                        "\n====== response-end ======"
+                    )[0]
+                )
+                result = {
+                    k: int(v["response"] == v["target"]) for k, v in values.items()
+                }
+            text = json.dumps(result)
+            if self.path.startswith("/duplicate") and "idx_0" in result:
+                text = '{"idx_0": 0, "idx_0": 1}'
+            body = json.dumps(
+                {
+                    "id": "test",
+                    "choices": [
+                        {
+                            "index": 0,
+                            "finish_reason": "stop",
+                            "message": {
+                                "role": "assistant",
+                                "content": f"```json\n{text}\n```",
+                            },
+                        }
+                    ],
+                }
+            ).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}"
+    finally:
+        server.shutdown()
+        thread.join()
+        server.server_close()
+
+
+def run_score(tmp_path, judge, gold, candidate, pipeline=None, keys=None):
+    pytest.importorskip("pandas")
+    pytest.importorskip("dateparser")
+    tests = tmp_path / "tests"
+    workspace = tmp_path / "workspace"
+    tests.mkdir(exist_ok=True)
+    workspace.mkdir(exist_ok=True)
+    columns = gold.splitlines()[0].split(",")
+    config = {
+        "required": columns,
+        "unique_columns": keys or ["id"],
+        "eval_pipeline": pipeline
+        or {
+            col: {"metric": ["exact_match"], "preprocess": ["norm_str"]}
+            for col in columns
+        },
+    }
+    (tests / "eval_config.json").write_text(json.dumps(config))
+    (tests / "gold_answer.csv").write_text(gold)
+    (workspace / "output.md").write_text(candidate)
+    script = "import json,sys; from pathlib import Path; sys.path.insert(0,sys.argv[1]); import verifyit_score; print(json.dumps(verifyit_score.score(Path(sys.argv[2]),Path(sys.argv[3]))))"
+    result = subprocess.run(
+        [sys.executable, "-c", script, str(SOURCE), str(tests), str(workspace)],
+        env={**os.environ, "OPENAI_API_KEY": "local", "OPENAI_BASE_URL": judge + "/v1"},
+        capture_output=True,
+        text=True,
+        check=True,
+        timeout=30,
+    )
+    return json.loads(result.stdout.splitlines()[-1])
+
+
+def test_multiple_metrics_keep_expanded_item_denominator(tmp_path, judge):
+    result = run_score(
+        tmp_path,
+        judge,
+        "id,text\na,longer text\nb,another text\n",
+        "|id|text|\n|---|---|\n|a|longer|\n",
+        {
+            "id": {"metric": ["exact_match"]},
+            "text": {"metric": ["exact_match", "in_match"]},
+        },
+    )
+    assert result["status"] == "scored"
+    assert result["reward"] == 0.444444
+    assert result["detail"]["native_metrics"]["f1_by_row"] == 0
+    assert result["detail"]["assignment"] == {
+        "gold_rows": 2,
+        "prediction_rows": 1,
+        "metric_columns": 3,
+        "matched_rows": 1,
+    }
+
+
+@pytest.mark.parametrize(
+    "candidate,expected,flags",
+    [
+        ("|a|first|\n| A |first|\n", "scored", [True, False]),
+        ("|a|first|\n|alias:a|first|\n", "infra_error", [False, False]),
+    ],
+)
+def test_collision_status_preserves_native_assignment(
+    tmp_path, judge, candidate, expected, flags
+):
+    result = run_score(
+        tmp_path,
+        judge,
+        "id,text\na,first\nb,second\n",
+        "|id|text|\n|---|---|\n" + candidate,
+    )
+    assert result["status"] == expected
+    assert result["reward"] == 0
+    assert result["detail"]["native_metrics"]["f1_by_item"] == 1
+    assert result["detail"]["preprocessing_collisions"] == flags
+
+
+def test_numeric_composite_keys_use_native_dtype_alignment(tmp_path, judge):
+    result = run_score(
+        tmp_path,
+        judge,
+        "id,kind,text\n1,a,first\n2,a,second\n",
+        "|id|kind|text|\n|---|---|---|\n|1.0|a|first|\n|1|a|ignored duplicate|\n|2|a|second|\n",
+        keys=["id", "kind"],
+    )
+    assert result["status"] == "scored"
+    assert result["reward"] == 1
+    assert result["detail"]["assignment"]["prediction_rows"] == 2
+    assert result["detail"]["preprocessing_collisions"] == [False, False]
+
+
+def test_duplicate_judge_decision_cannot_award_last_value(tmp_path, judge):
+    result = run_score(
+        tmp_path,
+        judge + "/duplicate",
+        "id,text\na,first\n",
+        "|id|text|\n|---|---|\n|a|first|\n",
+        {"id": {"metric": ["exact_match"]}, "text": {"metric": ["llm_judge"]}},
+    )
+    assert result["status"] == "infra_error"
+    assert result["reward"] == 0
+    assert result["detail"]["native_metrics"]["f1_by_item"] == 1
+
+
+def test_empty_candidate_and_empty_reference_have_distinct_status(tmp_path, judge):
+    candidate = run_score(tmp_path, judge, "id,text\na,first\n", "")
+    reference = run_score(
+        tmp_path, judge, "id,text\n", "|id|text|\n|---|---|\n|a|first|\n"
+    )
+    assert (candidate["status"], candidate["reward"]) == ("scored", 0)
+    assert (reference["status"], reference["reward"]) == ("invalid_task", 0)
