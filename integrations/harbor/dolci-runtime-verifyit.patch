index 0000000..c3a00fd
--- /dev/null
+++ b/adapters/dolci/src/dolci/graders/verifyit_grade.py
@@ -0,0 +1,193 @@
+"""Dolci source contracts composed with verifyit grading primitives."""
+
+import json
+import math
+import os
+import random
+import tempfile
+from dataclasses import asdict
+from pathlib import Path
+
+from verifyit.grade import InvalidTask, Status, grade, infra_error, invalid_task, scored
+from verifyit.modes.grade_math import grade_math_candidate
+from verifyit.spec import MathSpec, PytestSpec, StdioSpec
+
+import grade as source
+
+
+def validate(reference):
+    # Source instruction defaults use Python's global random generator. Trusted
+    # preflight must not consume draws before the actual source grader builds them.
+    state = random.getstate()
+    try:
+        _validate(reference)
+    finally:
+        random.setstate(state)
+
+
+def _validate(reference):
+    kind = reference["kind"]
+    if kind == "math":
+        if (
+            not isinstance(reference["ground_truth"], str)
+            or not reference["ground_truth"].strip()
+        ):
+            raise InvalidTask("math requires a nonempty reference")
+    elif kind == "code":
+        asserts = reference["asserts"]
+        if (
+            not isinstance(asserts, list)
+            or not asserts
+            or any(not isinstance(x, str) or not x.strip() for x in asserts)
+        ):
+            raise InvalidTask("code requires nonempty assertion strings")
+    elif kind == "code_stdio":
+        cases = reference["cases"]
+        if not isinstance(cases, list) or not cases:
+            raise InvalidTask("stdio requires at least one case")
+        for case in cases:
+            if not isinstance(case, dict) or any(
+                not isinstance(case.get(key), str) for key in ("input", "output")
+            ):
+                raise InvalidTask("stdio inputs and outputs must be strings")
+    elif kind == "ifeval":
+        truth = reference["ground_truth"]
+        if not isinstance(truth, list) or len(truth) != 1:
+            raise InvalidTask("IFEval requires one constraint object")
+        constraint = json.loads(truth[0]) if isinstance(truth[0], str) else truth[0]
+        keys, args = constraint["instruction_id"], constraint["kwargs"]
+        if (
+            not isinstance(keys, list)
+            or not keys
+            or not isinstance(args, list)
+            or len(keys) != len(args)
+        ):
+            raise InvalidTask(
+                "IFEval instruction and argument lists must be nonempty and aligned"
+            )
+        for key, values in zip(keys, args, strict=True):
+            if (
+                not isinstance(key, str)
+                or key not in source.instructions_registry.INSTRUCTION_DICT
+            ):
+                raise InvalidTask("unknown IFEval instruction")
+            if values is not None and not isinstance(values, dict):
+                raise InvalidTask("IFEval arguments must be objects")
+            # Validate every trusted constraint even for absent candidate output.
+            inst = source.instructions_registry.INSTRUCTION_DICT[key](key)
+            inst.build_description(
+                **{k: v for k, v in (values or {}).items() if v is not None}
+            )
+    else:
+        raise InvalidTask("unknown Dolci domain")
+
+
+def score(reference, tests, workspace):
+    kind = reference["kind"]
+    name = {
+        "math": "answer.txt",
+        "code": "solution.py",
+        "code_stdio": "solution.py",
+        "ifeval": "response.txt",
+    }[kind]
+    candidate = workspace / name
+    if not candidate.is_file() and kind != "math":
+        return scored(0.0, reason="missing_candidate")
+    if kind == "ifeval":
+        reward, detail = source.grade(reference["ground_truth"], candidate.read_text())
+        return scored(reward, instructions=detail)
+    with tempfile.TemporaryDirectory(prefix="dolci-verifyit-") as temp:
+        private = Path(temp)
+        if kind == "math":
+            expected = source.normalize(reference["ground_truth"])
+            answer = source.normalize(
+                candidate.read_text() if candidate.is_file() else ""
+            )
+            verdict = grade_math_candidate(MathSpec(expected=expected), answer)
+            if verdict.status != Status.SCORED or verdict.reward:
+                return verdict
+            # Preserve Dolci's strict absolute numeric tolerance. Do not run its
+            # lossy TeX-to-SymPy fallback, which interprets fractions as products.
+            try:
+                gold_number, candidate_number = float(expected), float(answer)
+            except ValueError:
+                return verdict
+            if math.isfinite(gold_number) and math.isfinite(candidate_number):
+                return scored(
+                    float(abs(gold_number - candidate_number) < 1e-6),
+                    mode="math",
+                    numeric_tolerance=1e-6,
+                )
+            return verdict
+        if kind == "code_stdio":
+            cases = private / "cases"
+            cases.mkdir()
+            for index, case in enumerate(reference["cases"]):
+                (cases / f"input_{index}.txt").write_text(case["input"])
+                (cases / f"output_{index}.txt").write_text(case["output"])
+            # The source preserves leading blank lines, unlike core EXACT.
+            (private / "compare.py").write_text(
+                "import sys\nfrom pathlib import Path\n"
+                f"sys.path.insert(0, {str(tests)!r})\n"
+                "from grade import normalize_output\n"
+                "print(int(normalize_output(Path(sys.argv[2]).read_text()) == normalize_output(Path(sys.argv[3]).read_text())))\n"
+            )
+            return grade(
+                StdioSpec(
+                    command=f"python3 {candidate}",
+                    cases="cases",
+                    special_judge="compare.py",
+                    per_case_timeout=15,
+                ),
+                private,
+                workspace,
+            )
+        # A single pytest item preserves the source's all-assertions denominator
+        # and executes the concatenated program in a fresh process as before.
+        runner = (
+            candidate.read_text()
+            + "\n\n# --- tests ---\n"
+            + "\n".join(reference["asserts"])
+            + "\n"
+        )
+        (private / "program.py").write_text(runner)
+        (private / "test_program.py").write_text(
+            "from pathlib import Path\nfrom verifyit.modes.run import run_command\n"
+            "def test_all_assertions():\n"
+            "    path = Path(__file__).with_name('program.py')\n"
+            "    result = run_command(['python3', str(path)], Path.cwd(), 30)\n"
+            "    assert not result.timed_out and result.returncode == 0, result.stderr\n"
+        )
+        return grade(
+            PytestSpec(
+                paths=(str(private / "test_program.py"),),
+                python="/opt/verifyit/bin/python",
+                timeout=40,
+            ),
+            private,
+            workspace,
+        )
+
+
+def main():
+    tests = Path(os.environ["VERIFYIT_TESTS_DIR"])
+    workspace = Path(os.environ["VERIFYIT_WORKSPACE"])
+    try:
+        reference = json.loads((tests / "spec.json").read_text())
+        try:
+            validate(reference)
+        except (InvalidTask, KeyError, TypeError, ValueError, AssertionError) as error:
+            result = invalid_task(str(error))
+        else:
+            result = score(reference, tests, workspace)
+    except InvalidTask as error:
+        result = invalid_task(str(error))
+    except Exception as error:
+        result = infra_error(f"{type(error).__name__}: {error}")
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(asdict(result), allow_nan=False)
+    )
+
+
+if __name__ == "__main__":
+    main()
