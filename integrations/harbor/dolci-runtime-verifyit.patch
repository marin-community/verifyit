@@ -0,0 +1,194 @@
+"""Ordinary Dolci regressions through the structured grading entry point."""
+
+import importlib.util
+import json
+import os
+import random
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+GRADERS = Path(__file__).parents[1] / "src/dolci/graders"
+
+
+def run_grade(tmp_path, reference, candidate):
+    tests = tmp_path / "tests"
+    tests.mkdir()
+    workspace = tmp_path / "workspace"
+    workspace.mkdir()
+    logs = tmp_path / "logs"
+    logs.mkdir()
+    kind = reference["kind"]
+    shutil.copy2(GRADERS / f"grade_{kind}.py", tests / "grade.py")
+    shutil.copy2(GRADERS / "verifyit_grade.py", tests)
+    if kind == "ifeval":
+        shutil.copytree(GRADERS / "ifeval_lib", tests / "ifeval_lib")
+    (tests / "spec.json").write_text(json.dumps(reference))
+    if candidate is not None:
+        filename = {
+            "math": "answer.txt",
+            "code": "solution.py",
+            "code_stdio": "solution.py",
+            "ifeval": "response.txt",
+        }[kind]
+        (workspace / filename).write_text(candidate)
+    subprocess.run(
+        [sys.executable, str(tests / "verifyit_grade.py")],
+        check=True,
+        env={
+            **os.environ,
+            "VERIFYIT_TESTS_DIR": str(tests),
+            "VERIFYIT_WORKSPACE": str(workspace),
+            "VERIFYIT_LOGS_DIR": str(logs),
+        },
+        timeout=30,
+    )
+    return json.loads((logs / "native-verdict.json").read_text())
+
+
+@pytest.mark.parametrize(
+    "candidate,reward", [("2", 0), ("0.5", 1), (r"\frac{1}{2}", 1)]
+)
+def test_fraction_is_not_multiplication(tmp_path, candidate, reward):
+    result = run_grade(
+        tmp_path, {"kind": "math", "ground_truth": r"\frac{1}{2}"}, candidate
+    )
+    assert (result["status"], result["reward"]) == ("scored", reward)
+
+
+@pytest.mark.parametrize(
+    "candidate,reward", [("0.0000005", 1), ("0.000001", 0), ("nan", 0)]
+)
+def test_source_strict_numeric_tolerance(tmp_path, candidate, reward):
+    result = run_grade(tmp_path, {"kind": "math", "ground_truth": "0"}, candidate)
+    assert (result["status"], result["reward"]) == ("scored", reward)
+
+
+@pytest.mark.parametrize("kind,key", [("code", "asserts"), ("code_stdio", "cases")])
+def test_empty_tests_invalid_before_missing_candidate(tmp_path, kind, key):
+    result = run_grade(tmp_path, {"kind": kind, key: []}, None)
+    assert (result["status"], result["reward"]) == ("invalid_task", 0)
+
+
+@pytest.mark.parametrize(
+    "program,reward", [("print('yes   ')", 1), ("print('\\nyes')", 0)]
+)
+def test_stdio_preserves_source_leading_blank_semantics(tmp_path, program, reward):
+    result = run_grade(
+        tmp_path,
+        {"kind": "code_stdio", "cases": [{"input": "", "output": "yes\n"}]},
+        program,
+    )
+    assert (result["status"], result["reward"]) == ("scored", reward)
+
+
+@pytest.fixture
+def preserve_random_state():
+    state = random.getstate()
+    try:
+        yield
+    finally:
+        random.setstate(state)
+
+
+def test_random_default_preflight_preserves_source_constraint(
+    monkeypatch, preserve_random_state
+):
+    monkeypatch.syspath_prepend(str(GRADERS))
+    module_spec = importlib.util.spec_from_file_location(
+        "grade", GRADERS / "grade_ifeval.py"
+    )
+    assert module_spec is not None and module_spec.loader is not None
+    source = importlib.util.module_from_spec(module_spec)
+    module_spec.loader.exec_module(source)
+    monkeypatch.setitem(sys.modules, "grade", source)
+    module_spec = importlib.util.spec_from_file_location(
+        "dolci_verifyit", GRADERS / "verifyit_grade.py"
+    )
+    assert module_spec is not None and module_spec.loader is not None
+    runtime = importlib.util.module_from_spec(module_spec)
+    module_spec.loader.exec_module(runtime)
+    constraint = {
+        "instruction_id": ["detectable_format:number_bullet_lists"],
+        "kwargs": [{}],
+    }
+    reference = {"kind": "ifeval", "ground_truth": [constraint]}
+    candidate = "* One\n* Two\n* Three"
+    random.seed(71)
+    original = source.grade(reference["ground_truth"], candidate)
+    original_state = random.getstate()
+    random.seed(71)
+    runtime.validate(reference)
+    assert source.grade(reference["ground_truth"], candidate) == original
+    assert random.getstate() == original_state
+    constraint["instruction_id"].append("unknown:instruction")
+    constraint["kwargs"].append({})
+    state = random.getstate()
+    with pytest.raises(runtime.InvalidTask):
+        runtime.validate(reference)
+    assert random.getstate() == state
+
+
+def test_instruction_denominator_cannot_drop_unpaired_constraint(tmp_path):
+    result = run_grade(
+        tmp_path,
+        {
+            "kind": "ifeval",
+            "ground_truth": [
+                {
+                    "instruction_id": [
+                        "keywords:existence",
+                        "keywords:forbidden_words",
+                    ],
+                    "kwargs": [{"keywords": ["hello"]}],
+                }
+            ],
+        },
+        "hello",
+    )
+    assert (result["status"], result["reward"]) == ("invalid_task", 0)
+
+
+@pytest.fixture
+def adapter(tmp_path):
+    module_spec = importlib.util.spec_from_file_location(
+        "dolci_adapter", GRADERS.parent / "adapter.py"
+    )
+    assert module_spec is not None and module_spec.loader is not None
+    module = importlib.util.module_from_spec(module_spec)
+    module_spec.loader.exec_module(module)
+    return module.DolciAdapter(tmp_path, use_verifyit=True)
+
+
+@pytest.mark.parametrize(
+    "record",
+    [
+        {},
+        {"ground_truth": None},
+        {"ground_truth": None, "reward_model": {"ground_truth": None}},
+    ],
+)
+def test_math_generation_rejects_missing_gold_before_string_conversion(adapter, record):
+    with pytest.raises(ValueError, match="reference"):
+        adapter.build_task({"dataset": "math", **record}, 0)
+    assert list(adapter.task_dir.iterdir()) == []
+
+
+@pytest.mark.parametrize(
+    "record,expected",
+    [
+        ({"ground_truth": 0, "reward_model": {"ground_truth": 9}}, "0"),
+        ({"ground_truth": None, "reward_model": {"ground_truth": 0}}, "0"),
+        ({"reward_model": {"ground_truth": "42"}}, "42"),
+        ({"ground_truth": "None"}, "None"),
+    ],
+)
+def test_math_generation_preserves_zero_fallback_and_literal_strings(
+    adapter, record, expected
+):
+    result = adapter._build_spec(record, "math")
+    assert result["ground_truth"] == expected
+    assert adapter._oracle_content(record, "math") == expected.encode()
