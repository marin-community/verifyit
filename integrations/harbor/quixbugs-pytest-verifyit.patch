+            'args = ["-v", "-rA"]\ntimeout = 590\n'
+        )
+        dockerfile = (task_root / "environment/Dockerfile").read_text()
+        copy = f"COPY {original} /app/{original}"
+        if dockerfile.count(copy) != 1:
+            raise ValueError("Unreviewed QuixBugs source image")
+        dockerfile = dockerfile.replace(copy, "")
