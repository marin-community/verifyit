+    @staticmethod
+    def _enable_verifyit(task_root: Path, program_name: str, language: str) -> None:
+        tests = task_root / "tests"
+        if language == "python":
+            original = f"{program_name}.py"
+            candidate = f"fixed_{program_name}.py"
+            shutil.copy(task_root / "environment" / original, tests / original)
+            original_copy = f"COPY {original} /app/{original}\n"
+        else:
+            original = f"{program_name.upper()}.java"
+            candidate = original
+            original_copy = ""
+        config_path = task_root / "task.toml"
+        config = config_path.read_text()
