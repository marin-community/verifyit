+            )
+            + "\n[verifier.environment]\n"
+            + "build_timeout_sec = 900.0\ncpus = 1\nmemory_mb = 2048\nstorage_mb = 4096\nallow_internet = true\n"
+        )
+        (tests / "verifier.toml").write_text(
+            'mode = "pytest"\npaths = ["/tests/test_outputs.py"]\n'
