+            + "&& /opt/verifyit/bin/pip install --no-cache-dir "
+            + f"'verifyit @ git+https://github.com/marin-community/verifyit@{VERIFYIT_REVISION}' "
+            + "pytest==8.4.1 pytest-json-report pytest-timeout\n"
+            + 'ENV PATH="/opt/verifyit/bin:$PATH"\n'
+            + "COPY . /tests/\n"
