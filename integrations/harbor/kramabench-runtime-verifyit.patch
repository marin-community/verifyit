diff --git a/adapters/kramabench/template/tests/verifyit_score.py b/adapters/kramabench/template/tests/verifyit_score.py
new file mode 100644
index 0000000..96df9bb
--- /dev/null
+++ b/adapters/kramabench/template/tests/verifyit_score.py
@@ -0,0 +1,216 @@
+"""Run the retained KramaBench scorer with explicit task and judge failures."""
+
+import importlib
+import json
+import math
+import os
+from pathlib import Path
+
+METRICS = {
+    "numeric_exact": ["success"],
+    "string_exact": ["success"],
+    "numeric_approximate": ["mean_absolute_error", "mean_squared_error", "rae_score"],
+    "string_approximate": ["llm_paraphrase"],
+    "list_exact": ["f1", "precision", "recall"],
+    "list_approximate": ["f1_approximate"],
+}
+PRIMARY = {"success", "llm_paraphrase", "f1", "f1_approximate", "rae_score"}
+
+
+def validate_workload(workload: dict) -> str:
+    if not isinstance(workload, dict) or not isinstance(workload.get("id"), str):
+        raise ValueError("Expected a single workload with a string task ID")
+    answer_type = workload.get("answer_type")
+    if answer_type not in METRICS or "answer" not in workload:
+        raise ValueError("Missing answer or unsupported answer type")
+    answer = workload["answer"]
+    if answer_type.startswith("string") and isinstance(answer, list):
+        answer_type = "list" + answer_type[len("string") :]
+    if answer_type.startswith("numeric"):
+        if (
+            isinstance(answer, bool)
+            or not isinstance(answer, (int, float))
+            or not math.isfinite(answer)
+        ):
+            raise ValueError("Numeric reference must be finite")
+    elif answer_type.startswith("string"):
+        if not isinstance(answer, str) or not answer.strip():
+            raise ValueError("String reference must be nonempty")
+    elif (
+        not isinstance(answer, list)
+        or not answer
+        or any(
+            isinstance(item, bool)
+            or not isinstance(item, (int, float, str))
+            or (isinstance(item, str) and not item.strip())
+            or (isinstance(item, (int, float)) and not math.isfinite(item))
+            for item in answer
+        )
+    ):
+        raise ValueError(
+            "List reference must contain nonempty strings or finite numbers"
+        )
+    return answer_type
+
+
+def validate_judge_response(response: dict) -> None:
+    choices = response.get("choices")
+    if response.get("error") or not isinstance(choices, list) or len(choices) != 1:
+        raise ValueError("Judge must return one complete text choice")
+    choice = choices[0]
+    message = choice.get("message", {})
+    text = message.get("content")
+    if (
+        choice.get("finish_reason") != "stop"
+        or message.get("refusal")
+        or message.get("tool_calls")
+        or message.get("function_call")
+        or not isinstance(text, str)
+        or text.strip().lower() not in {"yes", "no"}
+    ):
+        raise ValueError("Judge must return only an unambiguous yes or no")
+
+
+def score(tests: Path, candidates: list[Path]) -> dict:
+    try:
+        workload = json.loads((tests / "workload.json").read_text())
+        answer_type = validate_workload(workload)
+        fixtures = json.loads(
+            (tests / "benchmark/fixtures/answer_type_fixtures.json").read_text()
+        )
+        routes = {row["name"]: row["metrics"] for row in fixtures}
+        if routes != METRICS:
+            raise ValueError("Unsupported source metric routing")
+        for name in ("task", "input_type", "output_type"):
+            json.loads((tests / f"benchmark/fixtures/{name}_fixtures.json").read_text())
+    except OSError as error:
+        return {"status": "infra_error", "reward": 0.0, "detail": {"error": str(error)}}
+    except (ValueError, TypeError, KeyError) as error:
+        return {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+
+    try:
+        answer_path = next((path for path in candidates if path.is_file()), None)
+        if answer_path is None:
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"missing_answer": True},
+            }
+        try:
+            answer_text = answer_path.read_text().strip()
+        except (OSError, UnicodeError) as error:
+            return {
+                "status": "scored",
+                "reward": 0.0,
+                "detail": {"unreadable_answer": str(error)},
+            }
+
+        if not answer_text:
+            return {"status": "scored", "reward": 0.0, "detail": {"empty_answer": True}}
+
+        needs_judge = answer_type in {"string_approximate", "list_approximate"}
+        if needs_judge and not os.environ.get("OPENAI_API_KEY"):
+            raise RuntimeError(
+                "KramaBench approximate text scoring requires OPENAI_API_KEY"
+            )
+        if not needs_judge:
+            # The source constructs an unused pipeline client even with pipeline evaluation off.
+            # These four routes never call it, regardless of the candidate answer.
+            if not os.environ.get("OPENAI_API_KEY"):
+                os.environ["OPENAI_API_KEY"] = "unused-deterministic-scoring"
+        native = importlib.import_module("evaluate")
+        judge = importlib.import_module("benchmark.llm_tools.gpt_interface")
+        failures = []
+        original = judge.GPTInterface.evaluate_paraphrase
+
+        def tracked_paraphrase(self, *args, **kwargs):
+            create = self.client.chat.completions.create
+
+            def checked_create(*create_args, **create_kwargs):
+                response = create(*create_args, **create_kwargs)
+                try:
+                    validate_judge_response(response.model_dump())
+                except (ValueError, TypeError, AttributeError) as error:
+                    failures.append(str(error))
+                return response
+
+            self.client.chat.completions.create = checked_create
+            try:
+                result = original(self, *args, **kwargs)
+            except Exception as error:
+                failures.append(f"{type(error).__name__}: {error}")
+                raise
+            finally:
+                self.client.chat.completions.create = create
+            if result[0] is None:
+                failures.append("Source judge returned no usable decision")
+            return result
+
+        judge.GPTInterface.evaluate_paraphrase = tracked_paraphrase
+        try:
+            evaluator = native.Evaluator(
+                workload_path=str(tests / "workload.json"),
+                task_fixture_directory=str(tests / "benchmark/fixtures"),
+                results_directory="not-actually-used",
+                run_subtasks=False,
+                evaluate_pipeline=False,
+            )
+            evaluator.workload["answer_type"] = answer_type
+            prediction = {
+                "task_id": workload["id"],
+                "model_output": {
+                    "answer": native.make_answer(answer_text, answer_type)
+                },
+                "code": "",
+            }
+            results = evaluator._evaluate_result_for_task(
+                prediction, evaluator.workload, evaluate_pipeline=False
+            )
+        finally:
+            judge.GPTInterface.evaluate_paraphrase = original
+        if len(results) != 1:
+            raise ValueError("Expected one native task result")
+        metrics = {key: value for key, value in results[0].items() if key != "code"}
+        detail = {"native_metrics": metrics, "answer_type": answer_type}
+        if failures:
+            return {
+                "status": "infra_error",
+                "reward": 0.0,
+                "detail": {**detail, "judge_failures": failures},
+            }
+        channels = PRIMARY.intersection(metrics)
+        if len(channels) != 1:
+            raise ValueError("Expected exactly one native primary score")
+        channel = channels.pop()
+        reward = metrics[channel]
+        if (
+            not isinstance(reward, (int, float))
+            or not math.isfinite(reward)
+            or not 0 <= reward <= 1
+        ):
+            raise ValueError("Native score must be finite and in [0, 1]")
+        json.dumps(metrics, allow_nan=False)
+        return {
+            "status": "scored",
+            "reward": float(reward),
+            "detail": {**detail, "score_type": channel},
+        }
+    except Exception as error:
+        return {
+            "status": "infra_error",
+            "reward": 0.0,
+            "detail": {"error": f"{type(error).__name__}: {error}"},
+        }
+
+
+if __name__ == "__main__":
+    verdict = score(
+        Path("/tests"), [Path("/app/answer.txt"), Path("/app/output/answer.txt")]
+    )
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
diff --git a/tests/unit/test_verifyit_kramabench_runtime.py b/tests/unit/test_verifyit_kramabench_runtime.py
new file mode 100644
index 0000000..0d380be
--- /dev/null
+++ b/tests/unit/test_verifyit_kramabench_runtime.py
@@ -0,0 +1,81 @@
+"""Ordinary submission and judge response regressions for the retained scorer."""
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+PATH = (
+    Path(__file__).parents[2] / "adapters/kramabench/template/tests/verifyit_score.py"
+)
+SPEC = importlib.util.spec_from_file_location("kramabench_verifyit", PATH)
+assert SPEC is not None and SPEC.loader is not None
+scorer = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(scorer)
+
+
+def task(tmp_path: Path) -> Path:
+    tests = tmp_path / "tests"
+    fixtures = tests / "benchmark/fixtures"
+    fixtures.mkdir(parents=True)
+    (tests / "workload.json").write_text(
+        json.dumps(
+            {"id": "text-1", "answer_type": "string_approximate", "answer": "fast"}
+        )
+    )
+    (fixtures / "answer_type_fixtures.json").write_text(
+        json.dumps(
+            [
+                {"name": name, "metrics": metrics}
+                for name, metrics in scorer.METRICS.items()
+            ]
+        )
+    )
+    for name in ("task", "input_type", "output_type"):
+        (fixtures / f"{name}_fixtures.json").write_text("[]")
+    return tests
+
+
+def test_empty_submission_cannot_receive_judge_credit(tmp_path: Path):
+    tests = task(tmp_path)
+    candidate = tmp_path / "answer.txt"
+    candidate.write_text(" \n\t ")
+    verdict = scorer.score(tests, [candidate])
+    assert verdict["status"] == "scored"
+    assert verdict["reward"] == 0
+    assert verdict["detail"]["empty_answer"] is True
+
+
+def test_missing_reference_is_distinct_from_missing_submission(tmp_path: Path):
+    tests = task(tmp_path)
+    candidate = tmp_path / "answer.txt"
+    assert scorer.score(tests, [candidate])["status"] == "scored"
+    (tests / "workload.json").unlink()
+    verdict = scorer.score(tests, [candidate])
+    assert verdict["status"] == "infra_error"
+    assert verdict["reward"] == 0
+
+
+@pytest.mark.parametrize(
+    "text,finish_reason,extra",
+    [
+        ("Yes", "length", {}),
+        ("Yes and no", "stop", {}),
+        ("Yesterday", "stop", {}),
+        ("Yes", "stop", {"refusal": "Unavailable"}),
+        ("Yes", "stop", {"tool_calls": [{"id": "call-1"}]}),
+    ],
+)
+def test_source_positive_malformed_reply_is_rejected(text, finish_reason, extra):
+    response = {
+        "choices": [
+            {"finish_reason": finish_reason, "message": {"content": text, **extra}}
+        ]
+    }
+    with pytest.raises(ValueError):
+        scorer.validate_judge_response(response)
+    response["choices"] = [{"finish_reason": "stop", "message": {"content": "Yes"}}]
+    scorer.validate_judge_response(response)
+    response["choices"][0]["message"]["content"] = "No"
+    scorer.validate_judge_response(response)
