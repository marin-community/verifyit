diff --git a/src/harbor/tasks/assets/verifyit_judge_checks.py b/src/harbor/tasks/assets/verifyit_judge_checks.py
new file mode 100644
index 0000000..04cdbdd
--- /dev/null
+++ b/src/harbor/tasks/assets/verifyit_judge_checks.py
@@ -0,0 +1,112 @@
+"""Validate external judge transport and grade its raw labels with verifyit."""
+
+import dataclasses
+import json
+import os
+from pathlib import Path
+
+from verifyit.grade import Status
+from verifyit.json_objects import unique_object
+from verifyit.modes.grade_exact import grade_exact_candidate
+from verifyit.modes.grade_json_schema import grade_json_schema_candidate
+from verifyit.spec import ExactSpec
+
+
+def strict_json(text):
+    value = json.loads(text, object_pairs_hook=unique_object)
+    json.dumps(value, allow_nan=False)
+    return value
+
+
+def record(kind, raw, verdict):
+    path = (
+        Path(os.environ.get("VERIFYIT_NATIVE_LOGS_DIR", "/logs/verifier"))
+        / "verifyit-judge-calls.jsonl"
+    )
+    with path.open("a") as stream:
+        stream.write(
+            json.dumps(
+                {"kind": kind, "raw": raw, "verdict": dataclasses.asdict(verdict)},
+                allow_nan=False,
+            )
+            + "\n"
+        )
+    if verdict.status is not Status.SCORED:
+        raise ValueError("Judge primitive did not produce a score")
+
+
+def parse_transport(raw_response):
+    strict_json(raw_response.http_response.text)
+    return raw_response.parse()
+
+
+def label(response):
+    if (
+        response.status != "completed"
+        or response.error is not None
+        or response.incomplete_details is not None
+    ):
+        raise ValueError("Incomplete judge response")
+    if any(item.type not in {"message", "reasoning"} for item in response.output):
+        raise ValueError("Judge returned unexpected tool output")
+    messages = [item for item in response.output if item.type == "message"]
+    if not messages or any(item.status != "completed" for item in messages):
+        raise ValueError("Incomplete judge output")
+    if any(block.type != "output_text" for item in messages for block in item.content):
+        raise ValueError("Judge refused or returned nontext output")
+    value = response.output_text.strip().upper()
+    verdict = grade_json_schema_candidate(
+        {"type": "string", "enum": ["A", "B", "C"]}, value
+    )
+    record("json-schema", response.output_text, verdict)
+    if verdict.reward != 1.0:
+        raise ValueError("Invalid judge label")
+    verdict = grade_exact_candidate(
+        ExactSpec(expected=("A",), ignore_whitespace=False), value
+    )
+    record("exact", response.output_text, verdict)
+    return value, verdict.reward
+
+
+def structured(content, schema, field, positive):
+    value = strict_json(content) if isinstance(content, str) else content
+    json.dumps(value, allow_nan=False)
+    verdict = grade_json_schema_candidate(schema, value)
+    record("json-schema", content, verdict)
+    if verdict.reward != 1.0:
+        raise ValueError("Invalid structured judge response")
+    verdict = grade_exact_candidate(
+        ExactSpec(
+            expected=(json.dumps(positive),), ignore_case=False, ignore_whitespace=False
+        ),
+        json.dumps(value[field]),
+    )
+    record("exact", content, verdict)
+    return verdict.reward == 1.0
+
+
+def chat(response, schema, field, positive):
+    if len(response.choices) != 1 or response.choices[0].finish_reason != "stop":
+        raise ValueError("Incomplete chat judge response")
+    message = response.choices[0].message
+    if message.refusal or message.tool_calls or getattr(message, "function_call", None):
+        raise ValueError("Judge refused or returned tool output")
+    return structured(message.content, schema, field, positive)
+
+
+def tool(response):
+    if response.stop_reason != "tool_use":
+        raise ValueError("Incomplete tool judge response")
+    tools = [item for item in response.content if item.type == "tool_use"]
+    if len(tools) != 1 or tools[0].name != "grade_answer":
+        raise ValueError("Missing or conflicting judge tool response")
+    return structured(
+        tools[0].input,
+        {
+            "type": "object",
+            "properties": {"binary_score": {"type": "boolean"}},
+            "required": ["binary_score"],
+        },
+        "binary_score",
+        True,
+    )
