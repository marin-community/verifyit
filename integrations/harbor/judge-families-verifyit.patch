--- /dev/null
+++ b/src/harbor/tasks/verifyit_judge_runtime.py
@@ -0,0 +1,50 @@
+"""Package the three source-owned external-judge contracts for verifyit."""
+
+import shutil
+from pathlib import Path
+
+from harbor.tasks.verifyit_source_runtime import package_source_runtime
+
+
+def package_judge_runtime(task_dir: Path, family: str) -> None:
+    artifacts = ["/workspace/answer.txt"]
+    timeout = 300
+    if family == "hle":
+        artifacts = [
+            "/logs/agent/response.txt",
+            "/logs/agent/codex.txt",
+            "/logs/agent/terminus.json",
+            "/logs/agent/claude-code.txt",
+        ]
+        config = task_dir / "task.toml"
+        content = config.read_text()
+        if "[verifier]\n" not in content:
+            config.write_text(content + "\n[verifier]\ntimeout_sec = 330.0\n")
+    elif family not in {"simpleqa", "omnimath"}:
+        raise ValueError("Unknown source judge family")
+    package_source_runtime(
+        task_dir,
+        artifacts=artifacts,
+        dockerfile="FROM python:3.11-slim\nWORKDIR /app\nRUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*\nRUN mkdir -p /workspace /logs/agent /logs/verifier",
+        timeout=timeout,
+    )
+    tests = task_dir / "tests"
+    if family == "omnimath":
+        # The legacy shell otherwise turns a crashed judge into a scored zero.
+        script = tests / "test.sh"
+        script.write_text(
+            script.read_text().replace(
+                "#!/bin/bash", "#!/bin/bash\nset -euo pipefail", 1
+            )
+        )
+    shutil.copy2(
+        Path(__file__).parent / "assets/verifyit_judge_checks.py",
+        tests / "verifyit_judge_checks.py",
+    )
+    with (tests / "Dockerfile").open("a") as stream:
+        stream.write(
+            "RUN /opt/verifyit/bin/pip install --no-cache-dir openai==2.24.0 anthropic==0.75.0 jsonschema==4.23.0 pyyaml==6.0.2\n"
+        )
+    (tests / "native_bridge.sh").write_text(
+        "#!/bin/sh\nexport VERIFYIT_JUDGE_RUNTIME=1\nexport PATH=/opt/verifyit/bin:$PATH\nexec /opt/verifyit/bin/python -m verifyit.adapters.harbor_runtime test.sh\n"
+    )
