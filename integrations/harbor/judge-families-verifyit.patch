+"""Source judge labels and structured responses remain fail closed."""
+
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location(
+    "judge_checks", ROOT / "src/harbor/tasks/assets/verifyit_judge_checks.py"
+)
+checks = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(checks)
+
+
+@pytest.fixture(autouse=True)
+def logs(tmp_path, monkeypatch):
+    monkeypatch.setenv("VERIFYIT_NATIVE_LOGS_DIR", str(tmp_path))
+
+
+def responses(text, status="completed"):
+    return SimpleNamespace(
+        status=status,
+        error=None,
+        incomplete_details=None,
+        output_text=text,
+        output=[
+            SimpleNamespace(
+                type="message",
+                status="completed",
+                content=[SimpleNamespace(type="output_text")],
+            )
+        ],
+    )
+
+
+@pytest.mark.parametrize("text,expected", [(" A ", 1.0), ("B", 0.0), ("c", 0.0)])
+def test_responses_label(text, expected):
+    assert checks.label(responses(text)) == (text.strip().upper(), expected)
+
+
+@pytest.mark.parametrize(
+    "response", [responses("A", "incomplete"), responses("A B"), responses("CORRECT")]
+)
+def test_incomplete_or_malformed_label_is_unscored(response):
+    with pytest.raises(ValueError):
+        checks.label(response)
+
+
+@pytest.mark.parametrize("value,expected", [(True, True), (False, False)])
+def test_boolean_judge_schema(value, expected):
+    assert (
+        checks.structured(
+            json.dumps({"binary_score": value}),
+            {
+                "type": "object",
+                "properties": {"binary_score": {"type": "boolean"}},
+                "required": ["binary_score"],
+            },
+            "binary_score",
+            True,
+        )
+        is expected
+    )
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        '{"binary_score":1}',
+        '{"binary_score":"true"}',
+        '{"binary_score":false,"binary_score":true}',
+        '{"binary_score":true,"confidence":1e999}',
+    ],
+)
+def test_malformed_structured_judge_is_unscored(raw):
+    with pytest.raises(ValueError):
+        checks.structured(
+            raw,
+            {
+                "type": "object",
+                "properties": {"binary_score": {"type": "boolean"}},
+                "required": ["binary_score"],
+            },
+            "binary_score",
+            True,
+        )
