diff --git a/adapters/spreadsheetbench-verified/src/spreadsheetbench_verified/task-template/tests/verifyit_score.py b/adapters/spreadsheetbench-verified/src/spreadsheetbench_verified/task-template/tests/verifyit_score.py
new file mode 100644
index 0000000..a806b1e
--- /dev/null
+++ b/adapters/spreadsheetbench-verified/src/spreadsheetbench_verified/task-template/tests/verifyit_score.py
@@ -0,0 +1,160 @@
+"""Validate trusted workbook inputs and retain the native case report."""
+
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+from xml.etree.ElementTree import ParseError
+from zipfile import BadZipFile
+
+import openpyxl
+from evaluate import generate_cell_names, parse_answer_position
+from openpyxl.utils.exceptions import InvalidFileException
+
+
+def validate_reference(tests: Path) -> dict:
+    config = json.loads((tests / "config.json").read_text())
+    if not isinstance(config, dict):
+        raise ValueError("Spreadsheet config must be an object")
+    count = config.get("num_test_cases", 1)
+    if isinstance(count, bool) or not isinstance(count, int) or count <= 0:
+        raise ValueError("Spreadsheet task requires at least one test case")
+    position = config["answer_position"]
+    if not isinstance(position, str) or not position.strip():
+        raise ValueError("Spreadsheet task requires an answer position")
+    ranges = parse_answer_position(position)
+    if not ranges:
+        raise ValueError("Spreadsheet task has no selected ranges")
+    for index in range(1, count + 1):
+        path = tests / "answer_files" / f"{index}_{config['id']}_answer.xlsx"
+        workbook = openpyxl.load_workbook(path, data_only=False)
+        try:
+            for sheet, cell_range in ranges:
+                sheet = workbook.sheetnames[0] if sheet is None else sheet
+                worksheet = workbook[sheet]
+                cells = generate_cell_names(cell_range, max_row=worksheet.max_row or 1)
+                if not cells:
+                    raise ValueError("Spreadsheet answer range selects no cells")
+                for cell in cells:
+                    worksheet[cell]
+        finally:
+            workbook.close()
+    return config
+
+
+def recalculate_workbook(source: Path, destination: Path) -> None:
+    with tempfile.TemporaryDirectory(prefix="spreadsheet-recalc-") as directory:
+        completed = subprocess.run(
+            [
+                "libreoffice",
+                "--headless",
+                "--calc",
+                "--convert-to",
+                "xlsx:Calc MS Excel 2007 XML",
+                "--outdir",
+                directory,
+                str(source),
+            ],
+            capture_output=True,
+            text=True,
+        )
+        converted = Path(directory) / source.name
+        if completed.returncode or not converted.is_file():
+            raise RuntimeError(
+                f"LibreOffice failed to recalculate {source.name}: {completed.stderr[-1000:]}"
+            )
+        workbook = openpyxl.load_workbook(converted, data_only=True)
+        workbook.close()
+        shutil.copy2(converted, destination)
+
+
+def run_source(tests: Path) -> None:
+    with tempfile.TemporaryDirectory(prefix="spreadsheet-answers-") as directory:
+        answer_dir = Path(directory)
+        for reference in sorted((tests / "answer_files").glob("*.xlsx")):
+            recalculate_workbook(reference, answer_dir / reference.name)
+        for candidate in sorted(Path("/app/output").glob("*.xlsx")):
+            try:
+                workbook = openpyxl.load_workbook(candidate, data_only=False)
+                workbook.close()
+            except (
+                OSError,
+                ValueError,
+                KeyError,
+                TypeError,
+                BadZipFile,
+                InvalidFileException,
+                ParseError,
+            ):
+                # Unreadable candidate workbooks are ordinary failed test cases.
+                continue
+            recalculate_workbook(candidate, candidate)
+        completed = subprocess.run(
+            ["python3", str(tests / "evaluate.py")],
+            env={**os.environ, "ANSWER_DIR": str(answer_dir)},
+            capture_output=True,
+            text=True,
+        )
+        if completed.returncode:
+            raise RuntimeError(
+                f"Spreadsheet evaluator exited {completed.returncode}: {completed.stderr[-1000:]}"
+            )
+
+
+def score(tests: Path, logs: Path) -> dict:
+    try:
+        config = validate_reference(tests)
+    except OSError as error:
+        return {"status": "infra_error", "reward": 0.0, "detail": {"error": str(error)}}
+    except (
+        ValueError,
+        KeyError,
+        TypeError,
+        IndexError,
+        BadZipFile,
+        InvalidFileException,
+        ParseError,
+    ) as error:
+        return {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+    try:
+        for name in ("reward.txt", "reward.json", "report.json"):
+            (logs / name).unlink(missing_ok=True)
+        run_source(tests)
+        report = json.loads((logs / "report.json").read_text())
+        results = report["test_case_results"]
+        count = config.get("num_test_cases", 1)
+        if len(results) != count or any(
+            type(result) is not int or result not in (0, 1) for result in results
+        ):
+            raise ValueError(
+                "Native spreadsheet report has an invalid case denominator"
+            )
+        reward = sum(results) / count
+        if report["soft_reward"] != reward or report["hard_reward"] != int(
+            all(results)
+        ):
+            raise ValueError("Native spreadsheet report disagrees with case results")
+        return {
+            "status": "scored",
+            "reward": reward,
+            "detail": {"native_metrics": report},
+        }
+    except Exception as error:
+        return {
+            "status": "infra_error",
+            "reward": 0.0,
+            "detail": {"error": f"{type(error).__name__}: {error}"},
+        }
+
+
+if __name__ == "__main__":
+    verdict = score(Path("/tests"), Path("/logs/verifier"))
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
