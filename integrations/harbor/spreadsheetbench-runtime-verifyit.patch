@@ -0,0 +1,81 @@
+"""Trusted spreadsheet defects differ from legitimate blank cells."""
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+openpyxl = pytest.importorskip("openpyxl")
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@pytest.fixture
+def grader(monkeypatch):
+    directory = (
+        ROOT
+        / "adapters/spreadsheetbench-verified/src/spreadsheetbench_verified/task-template/tests"
+    )
+    monkeypatch.syspath_prepend(str(directory))
+    spec = importlib.util.spec_from_file_location(
+        "spreadsheet_grader", directory / "verifyit_score.py"
+    )
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def reference(tmp_path):
+    config = {"id": "example", "answer_position": "A1", "num_test_cases": 1}
+    (tmp_path / "config.json").write_text(json.dumps(config))
+    folder = tmp_path / "answer_files"
+    folder.mkdir()
+    workbook = openpyxl.Workbook()
+    workbook.save(folder / "1_example_answer.xlsx")
+    return tmp_path
+
+
+@pytest.mark.parametrize("position", ["", "B2:A1"])
+def test_blank_cells_are_valid_but_empty_selected_ranges_are_invalid(
+    grader, reference, position
+):
+    assert grader.validate_reference(reference)["answer_position"] == "A1"
+    config = json.loads((reference / "config.json").read_text())
+    config["answer_position"] = position
+    (reference / "config.json").write_text(json.dumps(config))
+    verdict = grader.score(reference, reference / "logs")
+    assert (verdict["status"], verdict["reward"]) == ("invalid_task", 0.0)
+
+
+def test_unavailable_reference_differs_from_corrupt_reference(grader, reference):
+    path = reference / "answer_files/1_example_answer.xlsx"
+    path.unlink()
+    missing = grader.score(reference, reference / "logs")
+    assert (missing["status"], missing["reward"]) == ("infra_error", 0.0)
+    path.write_bytes(b"not a workbook")
+    corrupt = grader.score(reference, reference / "logs")
+    assert (corrupt["status"], corrupt["reward"]) == ("invalid_task", 0.0)
+
+
+def test_zero_case_task_cannot_report_vacuous_hard_reward(grader, reference):
+    config = json.loads((reference / "config.json").read_text())
+    config["num_test_cases"] = 0
+    (reference / "config.json").write_text(json.dumps(config))
+    verdict = grader.score(reference, reference / "logs")
+    assert (verdict["status"], verdict["reward"]) == ("invalid_task", 0.0)
+
+
+def test_converter_success_without_output_cannot_reuse_original_workbook(
+    grader, reference, monkeypatch
+):
+    executable = reference / "libreoffice"
+    executable.write_text("#!/bin/sh\nexit 0\n")
+    executable.chmod(0o755)
+    monkeypatch.setenv("PATH", str(reference))
+    workbook = reference / "answer_files/1_example_answer.xlsx"
+    original = workbook.read_bytes()
+    with pytest.raises(RuntimeError):
+        grader.recalculate_workbook(workbook, workbook)
+    assert workbook.read_bytes() == original
