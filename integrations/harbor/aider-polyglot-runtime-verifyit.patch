diff --git a/adapters/aider_polyglot/tests/test_verifyit_route.py b/adapters/aider_polyglot/tests/test_verifyit_route.py
new file mode 100644
index 0000000..c7da81a
--- /dev/null
+++ b/adapters/aider_polyglot/tests/test_verifyit_route.py
@@ -0,0 +1,27 @@
+"""Reject incomplete exercise references before generating a scoring task."""
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "src"))
+from aider_polyglot.adapter import AiderPolyglotAdapter
+
+
+@pytest.mark.parametrize("test_files", [[], ["missing_test.py"]])
+def test_incomplete_exercise_tests_cannot_generate_scoring_task(tmp_path, test_files):
+    exercise = tmp_path / "upstream/python/exercises/practice/example"
+    (exercise / ".meta").mkdir(parents=True)
+    (exercise / "solution.py").write_text("pass\n")
+    (exercise / ".meta/config.json").write_text(
+        json.dumps({"files": {"solution": ["solution.py"], "test": test_files}})
+    )
+    output = tmp_path / "tasks"
+    adapter = AiderPolyglotAdapter(
+        output, tmp_path / "upstream", languages="python", verifyit_enabled=True
+    )
+    with pytest.raises(ValueError):
+        adapter.generate_task("python_example", "example")
+    assert not (output / "example").exists()
