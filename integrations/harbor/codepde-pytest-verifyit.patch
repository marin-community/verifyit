+"""Grade CodePDE with the upstream evaluator and isolated candidate proxy."""
+
+import math
+import errno
+import os
+import re
+import stat
+import subprocess
+from pathlib import Path
+
+
+def test_nrmse_accuracy():
+    data_file = Path("/app/data/{template_data_file}")
+    assert data_file.is_file()
+    candidate_path = Path("/app/solver.py")
+    assert stat.S_ISREG(candidate_path.lstat().st_mode)
+    protected = [Path("/app"), Path("/app/data"), data_file,
+                 Path("/tests"), Path("/tests/verifyit"),
+                 Path("/logs"), Path("/logs/verifier")]
+    original_modes = [(path, path.stat().st_mode & 0o777)
+                      for path in protected if path.exists()]
+    changed = []
+    try:
+        for path, mode in original_modes:
+            if path.stat().st_uid == 65534:
+                raise ValueError(f"candidate owns protected path: {path}")
+            try:
+                os.chmod(path, 0o600 if path == data_file else 0o755)
+                changed.append((path, mode))
+            except OSError as error:
+                if path not in (Path("/tests"), Path("/tests/verifyit")) or error.errno != errno.EROFS:
+                    raise
+        result = subprocess.run(
+            [
+                "python", "/tests/verifyit/nRMSE_evaluator.py",
+                "--dataset-path-for-eval", str(data_file),
+                *"{template_pde_args}".split(),
+            ],
+            capture_output=True,
+            text=True,
+            timeout={template_timeout},  # noqa: F821
+            check=False,
+        )
+    finally:
+        for path, mode in reversed(changed):
+            os.chmod(path, mode)
+    assert result.returncode == 0, result.stderr[-2000:]
+    scores = re.findall(r"^nRMSE:\s*([0-9.eE+-]+)\s*\|", result.stdout, re.MULTILINE)
+    assert len(scores) == 1, "trusted evaluator returned no unique nRMSE"
+    score = float(scores[0])
+    assert math.isfinite(score) and score >= 0
+    Path("/app/evaluation_results.txt").write_text(
+        f"nRMSE: {score:.6f}\n"
+    )
+    assert score < 0.05, f"nRMSE {score:.6f} exceeds 0.05"
