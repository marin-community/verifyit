@@ -0,0 +1,79 @@
+"""Restrict the CodePDE candidate to its source and public solver inputs."""
+
+import ctypes
+import os
+from pathlib import Path
+
+
+_READ_FILE = 1 << 2
+_READ_DIR = 1 << 3
+_WRITE_FILE = 1 << 1
+_EXECUTE = 1 << 0
+_HANDLED = (1 << 15) - 1
+_RULE_PATH_BENEATH = 1
+_PR_SET_NO_NEW_PRIVS = 38
+_CREATE_RULESET = 444
+_ADD_RULE = 445
+_RESTRICT_SELF = 446
+
+
+class _RulesetAttr(ctypes.Structure):
+    _fields_ = [("handled_access_fs", ctypes.c_uint64)]
+
+
+class _PathBeneathAttr(ctypes.Structure):
+    _fields_ = [("allowed_access", ctypes.c_uint64), ("parent_fd", ctypes.c_int32)]
+
+
+def _syscall(libc, number, *arguments):
+    result = libc.syscall(number, *arguments)
+    if result < 0:
+        error = ctypes.get_errno()
+        raise OSError(error, os.strerror(error))
+    return result
+
+
+def restrict_candidate(input_path: Path) -> None:
+    """Fail closed if the kernel cannot enforce this filesystem allowlist."""
+    libc = ctypes.CDLL(None, use_errno=True)
+    abi = _syscall(libc, _CREATE_RULESET, 0, 0, 1)
+    if abi < 3:
+        raise RuntimeError("Landlock ABI 3 or newer is required")
+    attr = _RulesetAttr(_HANDLED)
+    ruleset = _syscall(libc, _CREATE_RULESET, ctypes.byref(attr), ctypes.sizeof(attr), 0)
+    try:
+        rights = _READ_FILE | _READ_DIR | _EXECUTE
+        allowed = {
+            Path("/usr"): rights,
+            Path("/lib"): rights,
+            Path("/bin"): rights,
+            Path("/etc"): _READ_FILE | _READ_DIR,
+            Path("/dev"): _READ_FILE | _READ_DIR,
+            Path("/dev/null"): _READ_FILE | _WRITE_FILE,
+            Path("/app"): _READ_DIR,
+            Path("/app/solver.py"): _READ_FILE,
+            Path("/tests"): _READ_DIR,
+            Path("/tests/verifyit"): _READ_DIR,
+            Path("/tests/verifyit/verifyit_worker.py"): _READ_FILE,
+            input_path.parent: _READ_DIR,
+            input_path: _READ_FILE,
+        }
+        for path, access in allowed.items():
+            descriptor = os.open(path, os.O_PATH | os.O_CLOEXEC)
+            try:
+                rule = _PathBeneathAttr(access, descriptor)
+                _syscall(libc, _ADD_RULE, ruleset, _RULE_PATH_BENEATH,
+                         ctypes.byref(rule), 0)
+            finally:
+                os.close(descriptor)
+        if libc.prctl(_PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
+            error = ctypes.get_errno()
+            raise OSError(error, os.strerror(error))
+        _syscall(libc, _RESTRICT_SELF, ruleset, 0)
+    finally:
+        os.close(ruleset)
+
+
+if __name__ == "__main__":
+    # PytestSpec.setup treats an unavailable sandbox as infrastructure failure.
+    restrict_candidate(Path("/tests/verifyit/verifyit_worker.py"))
