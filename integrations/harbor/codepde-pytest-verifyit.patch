@@ -0,0 +1,130 @@
+"""Trusted solver proxy for CodePDE's upstream nRMSE evaluator."""
+
+import ctypes
+import os
+import json
+import resource
+import signal
+import subprocess
+import tempfile
+import time
+from pathlib import Path
+
+import numpy as np
+
+from landlock import restrict_candidate
+
+
+_UID = 65534
+_GID = 65534
+
+
+def _expected_shapes(arguments):
+    pde = "{template_pde_name}"
+    if pde == "darcy":
+        return (arguments[0].shape,)
+    if pde == "cns1d":
+        shape = (len(arguments[0]), len(arguments[3]), arguments[0].shape[1])
+        return (shape, shape, shape)
+    shape = (len(arguments[0]), len(arguments[1]), arguments[0].shape[1])
+    return (shape,)
+
+
+def _limit_output(max_bytes):
+    resource.setrlimit(resource.RLIMIT_FSIZE, (max_bytes, max_bytes))
+
+
+def _prepare_candidate(max_bytes, input_path):
+    _limit_output(max_bytes)
+    restrict_candidate(input_path)
+
+
+def _enable_subreaper():
+    # This evaluator process adopts detached candidate descendants as well.
+    libc = ctypes.CDLL(None, use_errno=True)
+    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
+        error = ctypes.get_errno()
+        raise OSError(error, os.strerror(error))
+
+
+def _cleanup_descendants():
+    children_file = Path(f"/proc/self/task/{os.getpid()}/children")
+    deadline = time.monotonic() + 5
+    while True:
+        children = [int(pid) for pid in children_file.read_text().split()]
+        if not children:
+            return
+        for pid in children:
+            try:
+                os.kill(pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+        while True:
+            try:
+                reaped, _ = os.waitpid(-1, os.WNOHANG)
+            except ChildProcessError:
+                break
+            if not reaped:
+                break
+        if time.monotonic() >= deadline:
+            raise RuntimeError("candidate descendants could not be stopped")
+        time.sleep(0.01)
+
+
+def solver(*arguments):
+    expected_shapes = _expected_shapes(arguments)
+    expected_bytes = sum(int(np.prod(shape)) * 8 for shape in expected_shapes)
+    with tempfile.TemporaryDirectory(prefix="codepde-candidate-") as temporary:
+        directory = Path(temporary)
+        os.chown(directory, _UID, _GID)
+        os.chmod(directory, 0o700)
+        input_path = directory / "input.npz"
+        np.savez(input_path, **{
+            f"arg_{index}": argument for index, argument in enumerate(arguments)
+        })
+        os.chown(input_path, _UID, _GID)
+        os.chmod(input_path, 0o400)
+        with tempfile.TemporaryFile() as output:
+            _enable_subreaper()
+            process = subprocess.Popen(
+                [
+                    "setpriv", "--no-new-privs", "--reuid", str(_UID),
+                    "--regid", str(_GID), "--clear-groups", "python",
+                    "/tests/verifyit/verifyit_worker.py", str(input_path),
+                    json.dumps(expected_shapes),
+                ],
+                stdout=output,
+                stderr=subprocess.DEVNULL,
+                start_new_session=True,
+                preexec_fn=lambda: _prepare_candidate(expected_bytes, input_path),
+            )
+            try:
+                status = process.wait(timeout={template_timeout})  # noqa: F821
+            except subprocess.TimeoutExpired:
+                raise ValueError("candidate solver timed out") from None
+            finally:
+                try:
+                    os.killpg(process.pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+                if process.poll() is None:
+                    process.wait()
+                _cleanup_descendants()
+            if status:
+                raise ValueError("candidate solver failed")
+            if output.tell() != expected_bytes:
+                raise ValueError("candidate solver returned a malformed array")
+            output.seek(0)
+            payload = output.read(expected_bytes + 1)
+            if len(payload) != expected_bytes:
+                raise ValueError("candidate solver returned a malformed array")
+            values = []
+            cursor = 0
+            for shape in expected_shapes:
+                length = int(np.prod(shape)) * 8
+                value = np.frombuffer(payload[cursor:cursor + length], dtype="<f8").reshape(shape)
+                cursor += length
+                if not np.isfinite(value).all():
+                    raise ValueError("candidate solver returned invalid numerical values")
+                values.append(value)
+            return tuple(values) if len(values) != 1 else values[0]
