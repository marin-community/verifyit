+"""Execute the candidate solver with only the public initial state available."""
+
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+def main() -> None:
+    input_path = Path(sys.argv[1])
+    expected_shapes = [tuple(shape) for shape in json.loads(sys.argv[2])]
+    with np.load(input_path, allow_pickle=False) as inputs:
+        arguments = [inputs[f"arg_{index}"] for index in range(len(inputs.files))]
+        arguments = [arg.item() if arg.ndim == 0 else arg for arg in arguments]
+
+    output_fd = os.dup(1)
+    discard_fd = os.open(os.devnull, os.O_WRONLY)
+    try:
+        os.dup2(discard_fd, 1)
+        spec = importlib.util.spec_from_file_location("candidate_solver", "/app/solver.py")
+        if spec is None or spec.loader is None:
+            raise RuntimeError("candidate solver could not be loaded")
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        candidate = getattr(module, "solver", None)
+        if not callable(candidate):
+            raise ValueError("candidate solver is missing")
+        result = candidate(*arguments)
+        sys.stdout.flush()
+    finally:
+        os.dup2(output_fd, 1)
+        os.close(output_fd)
+        os.close(discard_fd)
+    values = result if isinstance(result, (tuple, list)) else (result,)
+    if len(values) != len(expected_shapes):
+        raise ValueError("candidate returned the wrong number of arrays")
+    for value, shape in zip(values, expected_shapes):
+        array = np.asarray(value)
+        if array.shape != shape or array.dtype.kind not in "iuf":
+            raise ValueError("candidate returned an invalid array")
+        sys.stdout.buffer.write(array.astype("<f8").tobytes(order="C"))
+    sys.stdout.buffer.flush()
+
+
+if __name__ == "__main__":
+    main()
