diff --git a/adapters/sldbench/tests/test_reference.py b/adapters/sldbench/tests/test_reference.py
new file mode 100644
index 0000000..1678d58
--- /dev/null
+++ b/adapters/sldbench/tests/test_reference.py
@@ -0,0 +1,41 @@
+import importlib.util
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+
+@pytest.fixture
+def scorer(tmp_path):
+    path = (
+        Path(__file__).parents[1] / "src/sldbench/task-template/tests/test_outputs.py"
+    )
+    spec = importlib.util.spec_from_file_location("sldbench_scorer", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    module.__file__ = str(tmp_path / "test_outputs.py")
+    module.TASK_NAME = "parallel_scaling_law"
+    module.TASK_SCHEMA_MAP = {
+        module.TASK_NAME: {"feature_names": ["num_params"], "target_name": "loss"}
+    }
+    return module
+
+
+@pytest.mark.parametrize("loss", [[float("nan"), 2.0], []])
+def test_invalid_reference_is_rejected_before_candidate_scoring(scorer, loss):
+    frame = pd.DataFrame({"num_params": range(len(loss)), "loss": loss})
+    frame.to_parquet(Path(scorer.__file__).with_name("test.parquet"))
+    with pytest.raises(ValueError):
+        scorer.load_reference()
+
+
+def test_multioutput_metrics_preserve_negative_r2(scorer):
+    true = np.array([[1.0, 2.0], [2.0, 4.0], [3.0, 6.0]])
+    assert scorer.calculate_final_metrics(true, true) == {
+        "nmse": 0.0,
+        "nmae": 0.0,
+        "r2": 1.0,
+    }
+    wrong = scorer.calculate_final_metrics(np.zeros_like(true), true)
+    assert wrong["r2"] == pytest.approx(-6.0)
