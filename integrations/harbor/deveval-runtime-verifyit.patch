+"""Run DevEval's phase commands and binary log assertions through verifyit."""
+
+import json
+import os
+import shutil
+from dataclasses import asdict
+from pathlib import Path
+
+from verifyit.adapters.harbor_runtime import run_native
+from verifyit.grade import InvalidTask, infra_error, invalid_task, scored
+from verifyit.modes.grade_junit import _outcomes
+
+
+def phase_logs(phase):
+    if phase == "implementation":
+        return ("unit_test.log", "acceptance_test.log")
+    if phase == "unit_testing":
+        return ("unit_test.log",)
+    if phase == "acceptance_testing":
+        return ("acceptance_test.log",)
+    raise InvalidTask(f"Unknown DevEval phase: {phase}")
+
+
+def check_logs(workspace, phase):
+    outcomes = {}
+    for name in phase_logs(phase):
+        lines = (workspace / name).read_text().splitlines()
+        if len(lines) < 2 or not any(line.strip() for line in lines[:-1]):
+            raise RuntimeError(f"DevEval phase produced no test output: {name}")
+        if lines[-1] not in ("ALL_PASSED", "ALL_FAILED"):
+            raise RuntimeError(f"DevEval phase has no terminal command status: {name}")
+        outcomes[name] = lines[-1] == "ALL_PASSED"
+    return outcomes
+
+
+def score(tests, workspace):
+    reference = json.loads((tests / "verifyit-reference.json").read_text())
+    phase = reference["phase"]
+    logs = phase_logs(phase)
+    candidates = reference["candidate_paths"]
+    if not candidates:
+        raise InvalidTask("DevEval phase has no candidate paths")
+    for relative in candidates:
+        candidate = workspace / relative
+        if not candidate.exists() or (
+            candidate.is_dir() and not any(p.is_file() for p in candidate.rglob("*"))
+        ):
+            return scored(0.0, reason="missing_candidate", path=relative, phase=phase)
+    # A previous phase result must not survive a failed setup on repeated grading.
+    for name in ("unit_test.log", "acceptance_test.log"):
+        (workspace / name).unlink(missing_ok=True)
+    native = run_native("source_test.sh")
+    outcomes = check_logs(workspace, phase)
+    counts = {}
+    for log_name, task_name in reference.get("gradle_tasks", {}).items():
+        reports = sorted(
+            (workspace / "build" / "test-results" / task_name).glob("TEST-*.xml")
+        )
+        test_outcomes = {}
+        for report in reports:
+            for test_id, passed in _outcomes(report).items():
+                test_outcomes[test_id] = test_outcomes.get(test_id, True) and passed
+        counts[task_name] = len(test_outcomes)
+        no_source = any(
+            line.split() == [">", "Task", f":{task_name}", "NO-SOURCE"]
+            for line in (workspace / log_name).read_text().splitlines()
+        )
+        # Gradle can exit successfully without executing any tests. A selected
+        # NO-SOURCE task also overrides reports left by an earlier candidate.
+        outcomes[log_name] = (
+            outcomes[log_name]
+            and not no_source
+            and bool(test_outcomes)
+            and all(test_outcomes.values())
+        )
+    for name in logs:
+        shutil.copy2(workspace / name, Path(os.environ["VERIFYIT_LOGS_DIR"]) / name)
+    # The outer source pytest is binary even when implementation has two items.
+    reward = float(native["reward"] == 1.0 and all(outcomes.values()))
+    return scored(
+        reward,
+        phase=phase,
+        phase_outcomes=outcomes,
+        source_reward=native["reward"],
+        gradle_executed_counts=counts,
+    )
+
+
+def main():
+    try:
+        result = score(
+            Path(os.environ["VERIFYIT_TESTS_DIR"]),
+            Path(os.environ["VERIFYIT_WORKSPACE"]),
+        )
+    except InvalidTask as error:
+        result = invalid_task(str(error))
+    except Exception as error:
+        result = infra_error(f"{type(error).__name__}: {error}")
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "native-verdict.json").write_text(
+        json.dumps(asdict(result), allow_nan=False)
+    )
+
+
+if __name__ == "__main__":
+    main()
