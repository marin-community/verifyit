@@ -0,0 +1,190 @@
+"""DevEval phase results retain their binary denominator and explicit failures."""
+
+import importlib.util
+import json
+import shlex
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def grader():
+    return load_module(
+        "deveval_grade", Path(__file__).parents[1] / "assets" / "verifyit_grade.py"
+    )
+
+
+@pytest.fixture
+def runtime(tmp_path, monkeypatch):
+    tests = tmp_path / "tests"
+    workspace = tmp_path / "app"
+    logs = tmp_path / "logs"
+    for directory in (tests, workspace, logs):
+        directory.mkdir()
+    (workspace / "answer.py").write_text("pass\n")
+    (tests / "verifyit-reference.json").write_text(
+        json.dumps({"phase": "implementation", "candidate_paths": ["answer.py"]})
+    )
+    for key, value in {
+        "VERIFYIT_TESTS_DIR": tests,
+        "VERIFYIT_WORKSPACE": workspace,
+        "VERIFYIT_LOGS_DIR": logs,
+        "VERIFYIT_NATIVE_LOGS_DIR": logs,
+    }.items():
+        monkeypatch.setenv(key, str(value))
+    return tests, workspace, logs
+
+
+@pytest.mark.parametrize(
+    "unit,acceptance,expected",
+    [(True, True, 1.0), (True, False, 0.0), (False, True, 0.0)],
+)
+def test_implementation_requires_both_phase_commands(
+    grader, runtime, unit, acceptance, expected
+):
+    tests, workspace, logs = runtime
+    commands = []
+    for name, passed in (("unit", unit), ("acceptance", acceptance)):
+        marker = "ALL_PASSED" if passed else "ALL_FAILED"
+        commands.append(f"printf 'Ran 3 tests\\n{marker}\\n' > {name}_test.log")
+    commands.append(
+        f"printf '{int(unit and acceptance)}' > \"$VERIFYIT_NATIVE_LOGS_DIR/reward.txt\""
+    )
+    (tests / "source_test.sh").write_text("\n".join(commands))
+    result = grader.score(tests, workspace)
+    assert result.status == "scored"
+    assert result.reward == expected
+    assert (
+        (logs / "unit_test.log")
+        .read_text()
+        .endswith("ALL_PASSED\n" if unit else "ALL_FAILED\n")
+    )
+
+
+def test_failed_setup_removes_prior_phase_success(grader, runtime):
+    tests, workspace, logs = runtime
+    for name in ("unit_test.log", "acceptance_test.log"):
+        (workspace / name).write_text("Ran 3 tests\nALL_PASSED\n")
+    (tests / "source_test.sh").write_text("exit 17\n")
+    grader.main()
+    verdict = json.loads((logs / "native-verdict.json").read_text())
+    assert verdict["status"] == "infra_error"
+    assert verdict["reward"] == 0.0
+    assert not (workspace / "unit_test.log").exists()
+
+
+@pytest.mark.parametrize("content", ["", "ALL_PASSED\n"])
+def test_missing_test_output_cannot_receive_positive_score(grader, runtime, content):
+    tests, workspace, logs = runtime
+    (tests / "source_test.sh").write_text(
+        'printf 1 > "$VERIFYIT_NATIVE_LOGS_DIR/reward.txt"\n'
+        + "\n".join(
+            f"printf {content!r} > {name}"
+            for name in ("unit_test.log", "acceptance_test.log")
+        )
+    )
+    grader.main()
+    verdict = json.loads((logs / "native-verdict.json").read_text())
+    assert verdict["status"] == "infra_error"
+    assert verdict["reward"] == 0.0
+
+
+def test_source_missing_command_default_is_rejected_before_cutover(tmp_path):
+    adapter = load_module("deveval_adapter", Path(__file__).parents[1] / "adapter.py")
+    config = {
+        "unit_tests": "tests",
+        "acceptance_tests": "acceptance",
+        "acceptance_test_script": "run-acceptance",
+        "code_file_DAG": {"answer.py": []},
+    }
+    loader = SimpleNamespace(repo_config=config, repo_path=tmp_path, language="python")
+    native = adapter.DevEvalFileGenerator(
+        loader, "unit_testing"
+    ).get_run_tests_sh_content()
+    assert "echo 'No unit test script defined'" in native
+    with pytest.raises(ValueError, match="explicit test command"):
+        adapter.DevEvalAdapter._validate_verifyit_phase(loader, "unit_testing")
+
+
+def test_terminal_failure_overrides_source_substring_positive(grader, runtime):
+    tests, workspace, logs = runtime
+    adapter = load_module("deveval_adapter", Path(__file__).parents[1] / "adapter.py")
+    loader = SimpleNamespace(repo_config={}, repo_path=workspace, language="python")
+    source_tests = adapter.DevEvalFileGenerator(
+        loader, "implementation"
+    ).get_test_outputs_py_content()
+    # Relocate only the source parser's fixed workspace paths for this local run.
+    (tests / "test_outputs.py").write_text(
+        source_tests.replace('"/app/', f'"{workspace}/')
+    )
+    (tests / "source_test.sh").write_text(
+        "printf 'Earlier operation ALL_PASSED\\nCurrent test failed\\nALL_FAILED\\n' > unit_test.log\n"
+        "printf 'Ran 3 tests\\nALL_PASSED\\n' > acceptance_test.log\n"
+        + shlex.quote(sys.executable)
+        + " -m pytest -q -c /dev/null "
+        + shlex.quote(str(tests / "test_outputs.py"))
+        + '\nif [ $? -eq 0 ]; then printf 1; else printf 0; fi > "$VERIFYIT_NATIVE_LOGS_DIR/reward.txt"\n'
+    )
+    result = grader.score(tests, workspace)
+    assert result.detail["source_reward"] == 1.0
+    assert result.status == "scored"
+    assert result.reward == 0.0
+
+
+@pytest.mark.parametrize(
+    "task_status,report,expected",
+    [
+        (
+            "UP-TO-DATE",
+            '<testsuite tests="1"><testcase classname="Example" name="works"/></testsuite>',
+            1.0,
+        ),
+        (
+            "NO-SOURCE",
+            '<testsuite tests="1"><testcase classname="Example" name="works"/></testsuite>',
+            0.0,
+        ),
+        ("NO-SOURCE", None, 0.0),
+        (
+            "UP-TO-DATE",
+            '<testsuite tests="1" skipped="1"><testcase classname="Example" name="works"><skipped/></testcase></testsuite>',
+            0.0,
+        ),
+    ],
+)
+def test_gradle_requires_executed_tests_preserving_valid_cache(
+    grader, runtime, task_status, report, expected
+):
+    tests, workspace, logs = runtime
+    (tests / "verifyit-reference.json").write_text(
+        json.dumps(
+            {
+                "phase": "unit_testing",
+                "candidate_paths": ["answer.py"],
+                "gradle_tasks": {"unit_test.log": "test"},
+            }
+        )
+    )
+    if report is not None:
+        output = workspace / "build/test-results/test/TEST-Example.xml"
+        output.parent.mkdir(parents=True)
+        output.write_text(report)
+    (tests / "source_test.sh").write_text(
+        f"printf '> Task :test {task_status}\\nBUILD SUCCESSFUL\\nALL_PASSED\\n' > unit_test.log\n"
+        'printf 1 > "$VERIFYIT_NATIVE_LOGS_DIR/reward.txt"\n'
+    )
+    result = grader.score(tests, workspace)
+    assert result.status == "scored"
+    assert result.reward == expected
+    assert result.detail["source_reward"] == 1.0
