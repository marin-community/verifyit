diff --git a/adapters/pixiu/tests/test_empty_prediction.py b/adapters/pixiu/tests/test_empty_prediction.py
new file mode 100644
index 0000000..80c2a30
--- /dev/null
+++ b/adapters/pixiu/tests/test_empty_prediction.py
@@ -0,0 +1,78 @@
+"""Empty classification answers must not inherit the first choice's score."""
+
+import importlib.util
+import json
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.mark.parametrize(
+    "answer, expected", [("", 0.0), ("   ", 0.0), ("positive", 1.0)]
+)
+def test_cutover_classification_empty_answer(tmp_path, monkeypatch, answer, expected):
+    source = Path(__file__).parents[1] / "src/pixiu/task-template/tests/test_pixiu.py"
+    spec = importlib.util.spec_from_file_location("pixiu_source_score", source)
+    scorer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(scorer)
+    scorer.ANSWER_PATH = tmp_path / "answer.txt"
+    scorer.METRICS_PATH = tmp_path / "metrics.json"
+    scorer.ANSWER_PATH.write_text(answer)
+    monkeypatch.setenv("VERIFYIT_PIXIU_STRICT", "1")
+    monkeypatch.setitem(
+        sys.modules,
+        "test_outputs",
+        SimpleNamespace(
+            TASK_TYPE="Classification",
+            EXPECTED_LABEL="positive",
+            ALLOWED_CHOICES=["positive", "negative"],
+            LABEL_TYPE="sentiment",
+        ),
+    )
+    scorer.test_pixiu_output_matches_expected()
+    assert json.loads(scorer.METRICS_PATH.read_text())["reward"] == expected
+
+
+def test_invalid_reference_precedes_missing_candidate(tmp_path, monkeypatch):
+    source = Path(__file__).parents[1] / "src/pixiu/task-template/tests/test_pixiu.py"
+    spec = importlib.util.spec_from_file_location("pixiu_source_score", source)
+    scorer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(scorer)
+    scorer.ANSWER_PATH = tmp_path / "absent-answer.txt"
+    scorer.METRICS_PATH = tmp_path / "metrics.json"
+    monkeypatch.setenv("VERIFYIT_PIXIU_STRICT", "1")
+    monkeypatch.setitem(
+        sys.modules,
+        "test_outputs",
+        SimpleNamespace(
+            TASK_TYPE="Classification",
+            EXPECTED_LABEL="missing",
+            ALLOWED_CHOICES=["positive", "negative"],
+        ),
+    )
+    with pytest.raises(ValueError, match="gold label must be an allowed choice"):
+        scorer.test_pixiu_output_matches_expected()
+    assert not scorer.METRICS_PATH.exists()
+
+
+def test_empty_relation_reference_is_valid_negative(tmp_path, monkeypatch):
+    source = Path(__file__).parents[1] / "src/pixiu/task-template/tests/test_pixiu.py"
+    spec = importlib.util.spec_from_file_location("pixiu_source_score", source)
+    scorer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(scorer)
+    scorer.ANSWER_PATH = tmp_path / "answer.txt"
+    scorer.METRICS_PATH = tmp_path / "metrics.json"
+    scorer.ANSWER_PATH.write_text("")
+    monkeypatch.setenv("VERIFYIT_PIXIU_STRICT", "1")
+    monkeypatch.setitem(
+        sys.modules,
+        "test_outputs",
+        SimpleNamespace(
+            TASK_TYPE="RelationExtraction",
+            EXPECTED_RELATIONS=[],
+        ),
+    )
+    scorer.test_pixiu_output_matches_expected()
+    assert json.loads(scorer.METRICS_PATH.read_text())["reward"] == 1.0
