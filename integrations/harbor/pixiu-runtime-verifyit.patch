+def _validate_verifyit_config(cfg, task_type: str) -> None:
+    """Reject incomplete trusted references before scoring a candidate."""
+
+    def strings(value):
+        return isinstance(value, list) and all(
+            isinstance(item, str) and bool(item.strip()) for item in value
+        )
+
+    if task_type == "Classification":
+        choices = cfg.ALLOWED_CHOICES
+        if (
+            not strings(choices)
+            or not choices
+            or not isinstance(cfg.EXPECTED_LABEL, str)
+        ):
+            raise ValueError("Classification requires nonempty choices and gold label")
+        normalized = [choice.strip().lower() for choice in choices]
+        if cfg.EXPECTED_LABEL.strip().lower() not in normalized:
+            raise ValueError("Classification gold label must be an allowed choice")
+    elif task_type == "TSA":
+        score = cfg.EXPECTED_SCORE
+        if isinstance(score, bool) or not isinstance(score, (float, int)):
+            raise ValueError("TSA gold score must be numeric")
+        if not math.isfinite(score) or not -1 <= score <= 1:
+            raise ValueError("TSA gold score must be finite and within [-1, 1]")
+    elif task_type in {"QA", "AbstractiveSummarization", "ExtractiveSummarization"}:
+        if not isinstance(cfg.EXPECTED_ANSWER, str) or not cfg.EXPECTED_ANSWER.strip():
+            raise ValueError("Text scoring requires a nonempty reference")
+    elif task_type in {"NER", "SequentialLabeling"}:
+        if not strings(cfg.TOKENS) or not strings(cfg.EXPECTED_LABELS):
+            raise ValueError("Sequence scoring requires tokens and labels")
+        if len(cfg.TOKENS) != len(cfg.EXPECTED_LABELS):
+            raise ValueError("Reference token and label counts differ")
+        if task_type == "SequentialLabeling" and (
+            not isinstance(cfg.LABEL_MAP, dict)
+            or any(label not in cfg.LABEL_MAP for label in cfg.EXPECTED_LABELS)
+        ):
+            raise ValueError("Reference labels must be present in label map")
+    elif task_type == "RelationExtraction":
+        if not strings(cfg.EXPECTED_RELATIONS):
+            raise ValueError("Relation scoring requires a list of reference relations")
+    else:
+        raise ValueError(f"Unknown PIXIU scoring contract: {task_type}")
+
+
