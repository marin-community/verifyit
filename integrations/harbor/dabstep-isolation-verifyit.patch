diff --git a/adapters/dabstep/tests/test_verifyit_route.py b/adapters/dabstep/tests/test_verifyit_route.py
new file mode 100644
index 0000000..78417bf
--- /dev/null
+++ b/adapters/dabstep/tests/test_verifyit_route.py
@@ -0,0 +1,97 @@
+"""Protected DABstep scorer and generated verifyit client behavior."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+from harbor.models.task.config import VerifierEnvironmentMode
+from harbor.models.task.task import Task
+
+ADAPTER_SOURCE = Path(__file__).parents[1] / "adapter.py"
+SCORER_SOURCE = Path(__file__).parents[1] / "scorer.py"
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+ADAPTER = load(ADAPTER_SOURCE, "dabstep_adapter_under_test")
+SCORER = load(SCORER_SOURCE, "dabstep_scorer_under_test")
+
+
+def task(answer="1000"):
+    return ADAPTER.DABstepTask(
+        {
+            "task_id": 1,
+            "question": "What is the total?",
+            "guidelines": "Use data.",
+            "level": "easy",
+        },
+        answer,
+    )
+
+
+def test_generated_route_preserves_source_scorer(tmp_path):
+    adapter = ADAPTER.DABstepAdapter(tmp_path, [], {})
+    adapter.generate_task(task())
+    generated = tmp_path / "dabstep-1"
+    assert (generated / "tests/scorer.py").read_text() == SCORER_SOURCE.read_text()
+    assert 'mode = "script"' in (generated / "tests/verifier.toml").read_text()
+    assert (
+        'verdict_file = "native-verdict.json"'
+        in (generated / "tests/verifier.toml").read_text()
+    )
+    bridge = (generated / "tests/native_bridge.sh").read_text()
+    assert "ast.parse" in bridge
+    assert "extract_numeric" in bridge
+    assert "verifyit.adapters.harbor_runtime test.sh" in bridge
+    assert "1000" in (generated / "tests/test.sh").read_text()
+    assert (generated / "tests/expected_answer.txt").read_text() == "1000"
+    assert (
+        Task(generated).config.verifier.environment_mode
+        == VerifierEnvironmentMode.SEPARATE
+    )
+    assert Task(generated).config.artifacts == ["/app/answer.txt"]
+    assert (generated / "tests/Dockerfile").exists()
+    assert "verifyit @ git+" not in (generated / "environment/Dockerfile").read_text()
+
+
+def test_numeric_fuzzy_profile_rejects_nonfinite_false_positive():
+    assert SCORER.question_scorer("1,000", "1000")
+    assert SCORER.question_scorer("ledger", "ledger")
+    assert not SCORER.question_scorer("9" * 400, "8" * 400)
+
+
+def test_text_list_and_blank_answers():
+    assert SCORER.question_scorer("amsterdam", "Amsterdam")
+    assert not SCORER.question_scorer("Rotterdam", "Amsterdam")
+    assert SCORER.question_scorer("B; A", "A; B")
+    assert not SCORER.question_scorer("A; C", "A; B")
+    assert not SCORER.question_scorer("", "!")
+    assert not SCORER.question_scorer("!!!", "???")
+    assert not SCORER.question_scorer("!!!", "Amsterdam")
+
+
+@pytest.mark.parametrize("answer", ["", "!!!", " \n "])
+def test_empty_trusted_answer_cannot_replace_existing_task(tmp_path, answer):
+    adapter = ADAPTER.DABstepAdapter(tmp_path, [], {})
+    existing = tmp_path / "dabstep-1"
+    existing.mkdir()
+    (existing / "marker").write_text("keep")
+    with pytest.raises(ValueError, match="word or number"):
+        adapter.generate_task(task(answer))
+    assert (existing / "marker").read_text() == "keep"
+
+
+def test_heredoc_terminator_cannot_replace_existing_task(tmp_path):
+    adapter = ADAPTER.DABstepAdapter(tmp_path, [], {})
+    existing = tmp_path / "dabstep-1"
+    existing.mkdir()
+    (existing / "marker").write_text("keep")
+    with pytest.raises(ValueError, match="heredoc"):
+        adapter.generate_task(task("hello\nANSWER_EOF\nworld"))
+    assert (existing / "marker").read_text() == "keep"
