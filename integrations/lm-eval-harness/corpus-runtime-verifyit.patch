+"""Trusted JSON-only corpus scorer used by verifyit's ScriptSpec integration."""
+
+import json
+import hashlib
+import inspect
+import math
+import os
+import sys
+from collections import Counter
+from pathlib import Path
+
+from datasets import Dataset, DatasetDict
+
+from lm_eval.api import metrics as source_metrics
+from lm_eval.api.task import ConfigurableTask
+from lm_eval.tasks._yaml_loader import load_yaml
+from verifyit.adapters.harness_runtime import corpus_config_profile
+from verifyit.grade import InvalidTask
+
+
+def source_identity():
+    package = Path(__file__).resolve().parent
+    files = {
+        "task": Path(inspect.getfile(ConfigurableTask)).resolve(),
+        "metrics": Path(source_metrics.__file__).resolve(),
+        "yaml_loader": Path(load_yaml.__globals__["__file__"]).resolve(),
+        "runner": Path(__file__).resolve(),
+    }
+    expected = {
+        "task": package / "api" / "task.py",
+        "metrics": package / "api" / "metrics.py",
+        "yaml_loader": package / "tasks" / "_yaml_loader.py",
+        "runner": package / "verifyit_runtime.py",
+    }
+    if files != expected:
+        raise InvalidTask(
+            "imported harness modules do not belong to the trusted runner checkout"
+        )
+    return {
+        name: {
+            "path": str(path),
+            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+        }
+        for name, path in files.items()
+    }
+
+
+def enable_corpus_runtime(task, config_path):
+    """Opt in a task loaded from this trusted YAML to retained-runtime scoring.
+
+    The caller supplies installation metadata, never model-selected paths.
+    Grading-relevant configuration overrides require a separate reviewed profile.
+    """
+    source_identity()
+    config_path = Path(config_path).resolve()
+    tasks_root = Path(__file__).resolve().parent / "tasks"
+    if not config_path.is_relative_to(tasks_root):
+        raise InvalidTask("runtime configuration is outside the trusted task tree")
+    config = load_yaml(config_path, resolve_func=True)
+    if type(task).process_results is not ConfigurableTask.process_results:
+        raise InvalidTask(
+            "runtime scoring requires the default ConfigurableTask scorer"
+        )
+    for key in (
+        "task",
+        "output_type",
+        "doc_to_target",
+        "doc_to_choice",
+        "process_results",
+        "metric_list",
+    ):
+        if config.get(key) != getattr(task.config, key, None):
+            raise InvalidTask(
+                f"runtime task differs from trusted source configuration: {key}"
+            )
+    task._verifyit_corpus_config = config_path
+    return task
+
+
+def finite(value):
+    if (
+        isinstance(value, bool)
+        or not isinstance(value, (int, float))
+        or not math.isfinite(value)
+    ):
+        raise InvalidTask("corpus metric inputs and outputs must be finite numbers")
+    return value
+
+
+def score(payload):
+    provenance = source_identity()
+    config_path = Path(payload["config"]).resolve()
+    tasks_root = Path(__file__).resolve().parent / "tasks"
+    if not config_path.is_relative_to(tasks_root):
+        raise InvalidTask(
+            "configuration must belong to the trusted installed task tree"
+        )
+    provenance["config"] = {
+        "path": str(config_path),
+        "sha256": hashlib.sha256(config_path.read_bytes()).hexdigest(),
+    }
+    config = load_yaml(config_path, resolve_func=True)
+    selected_profile = corpus_config_profile(config)
+    if selected_profile is None:
+        raise InvalidTask("unrecognized corpus scoring configuration")
+    if config.get("process_results") is not None or config.get("class") is not None:
+        raise InvalidTask(
+            "custom scorers and task classes are outside this corpus profile"
+        )
+    samples = payload["samples"]
+    if not isinstance(samples, list) or not samples:
+        raise InvalidTask("corpus scoring requires a nonempty complete sample batch")
+    if any(
+        not isinstance(sample, dict) or set(sample) != {"doc", "responses"}
+        for sample in samples
+    ):
+        raise InvalidTask("samples require precisely doc and filtered responses")
+    docs = [sample["doc"] for sample in samples]
+    config.update(
+        num_fewshot=0,
+        training_split=None,
+        validation_split=None,
+        fewshot_split=None,
+        test_split="test",
+        custom_dataset=lambda **kwargs: DatasetDict(test=Dataset.from_list(docs)),
+    )
+    task = ConfigurableTask(config=config)
+    metrics = tuple(task._metric_fn_list)
+    for definition in config.get("metric_list", []):
+        if set(definition) - {"metric", "aggregation", "higher_is_better"}:
+            raise InvalidTask("unrecognized corpus metric options")
+    for metric, function in task._metric_fn_list.items():
+        if selected_profile == "code_text_smoothed_bleu":
+            if (
+                metric != "smoothed_bleu_4"
+                or task.aggregation()[metric] is not source_metrics.mean
+                or getattr(function, "__self__", None)
+                is not config["metric_list"][0]["metric"]
+            ):
+                raise InvalidTask(
+                    "code text requires its pinned BLEU callable and registered mean"
+                )
+            continue
+        if function is not getattr(source_metrics, f"{metric}_fn", None):
+            raise InvalidTask(
+                "corpus metric does not use the registered source passthrough"
+            )
+        aggregator_name = (
+            "weighted_perplexity"
+            if metric in {"word_perplexity", "byte_perplexity"}
+            else "mean" if metric == "acc" else metric
+        )
+        if task.aggregation()[metric] is not getattr(
+            source_metrics, aggregator_name, None
+        ):
+            raise InvalidTask(
+                "corpus metric does not use the registered source aggregator"
+            )
+    if selected_profile == "code_text_smoothed_bleu":
+        profile = selected_profile
+        for sample in samples:
+            doc = sample["doc"]
+            for key in ("code_tokens", "docstring_tokens"):
+                if (
+                    not isinstance(doc.get(key), list)
+                    or not doc[key]
+                    or any(not isinstance(token, str) for token in doc[key])
+                ):
+                    raise InvalidTask(
+                        "code text requires nonempty ordered string token vectors"
+                    )
+            if not task.doc_to_target(doc).strip():
+                raise InvalidTask("code text requires a nonempty normalized reference")
+            responses = sample["responses"]
+            if (
+                not isinstance(responses, list)
+                or len(responses) != 1
+                or not isinstance(responses[0], str)
+            ):
+                raise InvalidTask("code text requires one filtered string response")
+        source_file = Path(config["metric_list"][0]["metric"].__code__.co_filename)
+        provenance["metric_callable"] = {
+            "path": str(source_file),
+            "sha256": hashlib.sha256(source_file.read_bytes()).hexdigest(),
+        }
+    elif (
+        task.OUTPUT_TYPE == "generate_until"
+        and metrics
+        and set(metrics) <= {"bleu", "chrf", "ter"}
+    ):
+        profile = "translation_corpus"
+        for sample in samples:
+            responses = sample["responses"]
+            reference = task.doc_to_target(sample["doc"])
+            if not isinstance(reference, str) or not reference.strip():
+                raise InvalidTask(
+                    "translation corpus requires nonempty string references"
+                )
+            if (
+                not isinstance(responses, list)
+                or len(responses) != 1
+                or not isinstance(responses[0], str)
+            ):
+                raise InvalidTask(
+                    "translation corpus requires one filtered string response"
+                )
+    elif (
+        task.OUTPUT_TYPE == "loglikelihood_rolling"
+        and metrics
+        and set(metrics) <= {"word_perplexity", "byte_perplexity", "bits_per_byte"}
+    ):
+        profile = "rolling_likelihood_corpus"
+        for sample in samples:
+            responses = sample["responses"]
+            if (
+                not isinstance(responses, list)
+                or len(responses) != 1
+                or finite(responses[0]) > 0
+            ):
+                raise InvalidTask(
+                    "rolling likelihood requires one finite nonpositive model log probability"
+                )
+    elif (
+        task.OUTPUT_TYPE == "loglikelihood"
+        and metrics
+        and set(metrics) <= {"perplexity", "acc"}
+    ):
+        profile = "likelihood_corpus"
+        for sample in samples:
+            responses = sample["responses"]
+            if not isinstance(responses, list) or len(responses) != 1:
+                raise InvalidTask("likelihood requires one filtered response pair")
+            pair = responses[0]
+            if (
+                not isinstance(pair, (list, tuple))
+                or len(pair) != 2
+                or not isinstance(pair[1], bool)
+                or finite(pair[0]) > 0
+            ):
+                raise InvalidTask(
+                    "likelihood requires finite nonpositive log probability and boolean greedy flag"
+                )
+    else:
+        raise InvalidTask("unrecognized corpus scoring profile")
+    observations = []
+    values = {metric: [] for metric in metrics}
+    for sample in samples:
+        if profile == "code_text_smoothed_bleu" and not sample["responses"][0].strip():
+            observation = {"smoothed_bleu_4": 0.0}
+        else:
+            observation = task.process_results(sample["doc"], sample["responses"])
+        if set(observation) != set(metrics):
+            raise InvalidTask("source scorer omitted or added a metric")
+        if profile == "rolling_likelihood_corpus":
+            for item in observation.values():
+                if (
+                    not isinstance(item, (tuple, list))
+                    or len(item) != 2
+                    or finite(item[1]) <= 0
+                ):
+                    raise InvalidTask(
+                        "perplexity corpus has an empty or invalid weighting denominator"
+                    )
+                finite(item[0])
+        observations.append(observation)
+        for metric, value in observation.items():
+            values[metric].append(value)
+    aggregates = {
+        metric: finite(task.aggregation()[metric](items))
+        for metric, items in values.items()
+    }
+    return {
+        "status": "scored",
+        "reward": 0.0,
+        "detail": {
+            "coverage": "retained_runtime",
+            "source_provenance": provenance,
+            "dataset_origin": "supplied JSON documents via trusted custom_dataset factory; no dataset download",
+            "profile": profile,
+            "reward_policy": "no correctness projection; named source metrics are authoritative",
+            "observations": observations,
+            "aggregates": aggregates,
+            "scorer": "lm_eval.api.task.ConfigurableTask.process_results",
+            "aggregators": {
+                metric: f"{fn.__module__}.{fn.__qualname__}"
+                for metric, fn in task.aggregation().items()
+            },
+        },
+    }
+
+
+def main():
+    payload = json.loads(Path(sys.argv[1]).read_text())
+    calls = Counter()
+
+    def observe(frame, event, result):
+        module = frame.f_globals.get("__name__", "")
+        if event == "call" and (
+            module in {"lm_eval.api.task", "lm_eval.api.metrics"}
+            or frame.f_code.co_filename.endswith("/code_x_glue/code-text/bleu.py")
+            or frame.f_code.co_filename.endswith("/code_x_glue/code-text/utils.py")
+        ):
+            calls[f"{module}.{frame.f_code.co_name}"] += 1
+
+    sys.setprofile(observe)
+    try:
+        verdict = score(payload)
+    except InvalidTask as error:
+        verdict = {
+            "status": "invalid_task",
+            "reward": 0.0,
+            "detail": {"error": str(error)},
+        }
+    finally:
+        sys.setprofile(None)
+    verdict["detail"]["source_calls"] = dict(calls)
+    path = Path(os.environ["VERIFYIT_LOGS_DIR"]) / "corpus-verdict.json"
+    path.write_text(json.dumps(verdict, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
