diff --git a/lm_eval/verifyit_mlqa.py b/lm_eval/verifyit_mlqa.py
new file mode 100644
--- /dev/null
+++ b/lm_eval/verifyit_mlqa.py
@@ -0,0 +1,154 @@
+"""Grade source-normalized MLQA answers with exact and token-F1 primitives."""
+
+import hashlib
+from functools import partial
+from pathlib import Path
+
+from verifyit.adapters.harness_profiles import token_f1
+from verifyit.grade import InvalidTask, Status
+from verifyit.modes.grade_exact import grade_exact_candidate
+from verifyit.spec import ExactSpec
+
+from lm_eval.api import metrics as source_metrics
+from lm_eval.api.filter import FilterEnsemble
+from lm_eval.api.task import ConfigurableTask
+from lm_eval.filters.selection import TakeFirstFilter
+from lm_eval.tasks.mlqa import utils as source
+
+
+SOURCE_HASH = "597f08c0302ce42c158d17a609591e558897292bc3749015d67b55fe763d4c43"
+LANGUAGES = ("en", "es", "hi", "vi", "de", "ar", "zh")
+
+
+def _source_callback(callback, name):
+    code = getattr(callback, "__code__", None)
+    return (
+        callable(callback)
+        and getattr(callback, "__name__", None) == name
+        and code is not None
+        and hashlib.sha256(Path(code.co_filename).read_bytes()).hexdigest()
+        == SOURCE_HASH
+    )
+
+
+def _language(config):
+    task = config.get("task")
+    pieces = task.split("_") if isinstance(task, str) else []
+    if (
+        len(pieces) != 3
+        or pieces[0] != "mlqa"
+        or any(x not in LANGUAGES for x in pieces[1:])
+    ):
+        raise InvalidTask("MLQA task is not an audited language pair")
+    return pieces[1]
+
+
+def enable(config):
+    lang = _language(config)
+    if (
+        config.get("output_type") != "generate_until"
+        or config.get("doc_to_target") != "{{answers}}"
+    ):
+        raise InvalidTask("MLQA generation contract changed")
+    if not _source_callback(
+        config.get("process_results"), "process_results_" + lang
+    ) or not _source_callback(config.get("process_docs"), "process_docs"):
+        raise InvalidTask("MLQA source callbacks changed")
+    expected = [
+        {"metric": name, "aggregation": "mean", "higher_is_better": True}
+        for name in ("exact_match", "f1")
+    ]
+    if config.get("metric_list") != expected:
+        raise InvalidTask("MLQA source metrics changed")
+    config["process_results"] = partial(process_results, lang=lang)
+    return lang
+
+
+def validate_task(task):
+    lang = getattr(task, "_verifyit_mlqa", None)
+    if lang is None:
+        return
+    if (
+        type(task).process_results is not ConfigurableTask.process_results
+        or getattr(task.process_results, "__func__", None)
+        is not ConfigurableTask.process_results
+    ):
+        raise InvalidTask("MLQA task scorer changed")
+    callback = task.config.process_results
+    if (
+        not isinstance(callback, partial)
+        or callback.func is not process_results
+        or callback.args
+        or callback.keywords != {"lang": lang}
+    ):
+        raise InvalidTask("MLQA grading callback changed")
+    if (
+        _language({"task": task.config.task}) != lang
+        or task.config.doc_to_target != "{{answers}}"
+        or task.config.output_type != "generate_until"
+        or task.config.metadata.get("verifyit_mlqa") is not True
+    ):
+        raise InvalidTask("MLQA source configuration changed")
+    if task.aggregation() != {
+        "exact_match": source_metrics.mean,
+        "f1": source_metrics.mean,
+    } or task._metric_fn_list != {"exact_match": None, "f1": None}:
+        raise InvalidTask("MLQA metric functions or aggregation changed")
+    if not _source_callback(task.config.process_docs, "process_docs"):
+        raise InvalidTask("MLQA document preparation changed")
+    filters = task._filters
+    if (
+        len(filters) != 1
+        or type(filters[0]) is not FilterEnsemble
+        or filters[0].name != "none"
+        or len(filters[0].filters) != 1
+    ):
+        raise InvalidTask("MLQA response filter changed")
+    factory = filters[0].filters[0]
+    if (
+        not isinstance(factory, partial)
+        or factory.func is not TakeFirstFilter
+        or factory.args
+        or factory.keywords
+    ):
+        raise InvalidTask("MLQA response filter changed")
+
+
+def process_results(doc, results, *, lang):
+    if hashlib.sha256(Path(source.__file__).read_bytes()).hexdigest() != SOURCE_HASH:
+        raise InvalidTask("MLQA source normalization changed")
+    if lang not in LANGUAGES:
+        raise InvalidTask("Unknown MLQA language")
+    references = doc.get("answers")
+    if (
+        not isinstance(references, list)
+        or not references
+        or any(not isinstance(x, str) for x in references)
+    ):
+        raise InvalidTask("MLQA requires nonempty string reference alternatives")
+    normalized = [source.normalize_answer(reference, lang) for reference in references]
+    if any(not reference.strip() for reference in normalized):
+        raise InvalidTask("MLQA reference normalizes to empty text")
+    if not isinstance(results, list) or not results or not isinstance(results[0], str):
+        raise InvalidTask("MLQA requires a string prediction")
+    prediction = source.normalize_answer(results[0].strip(), lang)
+    exact = []
+    overlaps = []
+    for reference in normalized:
+        verdict = grade_exact_candidate(
+            ExactSpec(
+                (reference,),
+                ignore_case=False,
+                ignore_whitespace=False,
+                strip_outer_whitespace=False,
+            ),
+            prediction,
+        )
+        if verdict.status != Status.SCORED:
+            raise InvalidTask("MLQA exact primitive did not score")
+        exact.append(bool(verdict.reward))
+        overlap = token_f1(prediction.split(), reference.split())
+        if overlap.status != Status.SCORED:
+            raise InvalidTask("MLQA token-F1 primitive did not score")
+        overlaps.append(overlap.reward)
+    return {"exact_match": max(exact), "f1": max(overlaps)}
diff --git a/tests/unit/test_verifyit_mlqa.py b/tests/unit/test_verifyit_mlqa.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_verifyit_mlqa.py
@@ -0,0 +1,39 @@
+import pytest
+from verifyit.grade import InvalidTask
+
+from lm_eval.tasks.mlqa import utils as source
+from lm_eval.verifyit_mlqa import process_results
+
+
+@pytest.mark.parametrize(
+    "lang,gold",
+    [
+        ("en", "the"),
+        ("es", "el"),
+        ("de", "der"),
+        ("vi", "cái"),
+        ("ar", "ال"),
+        ("hi", "!!!"),
+        ("zh", "！！！"),
+    ],
+)
+def test_empty_normalized_reference_does_not_award_exact_match(lang, gold):
+    doc = {"answers": [gold]}
+    assert getattr(source, "process_results_" + lang)(doc, [""])["exact_match"] is True
+    with pytest.raises(InvalidTask, match="normalizes to empty"):
+        process_results(doc, [""], lang=lang)
+
+
+@pytest.mark.parametrize(
+    "prediction,gold",
+    [
+        ("红色", ["红色狐狸"]),
+        ("alternate", ["红色狐狸", "alternate"]),
+        ("unrelated", ["红色狐狸"]),
+    ],
+)
+def test_chinese_segmentation_and_alternative_references_match_source(prediction, gold):
+    doc = {"answers": gold}
+    assert process_results(doc, [prediction], lang="zh") == source.process_results_zh(
+        doc, [prediction]
+    )
