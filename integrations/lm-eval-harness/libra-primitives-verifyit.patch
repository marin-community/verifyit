diff --git a/lm_eval/verifyit_libra.py b/lm_eval/verifyit_libra.py
new file mode 100644
--- /dev/null
+++ b/lm_eval/verifyit_libra.py
@@ -0,0 +1,194 @@
+"""Compose existing exact and token primitives for source LIBRA length metrics."""
+
+import hashlib
+import re
+from collections import defaultdict
+from functools import partial
+from importlib.metadata import version
+from pathlib import Path
+
+from verifyit.adapters.harness_profiles import token_f1
+from verifyit.grade import InvalidTask, Status
+from verifyit.modes.grade_exact import grade_exact_candidate
+from verifyit.spec import ExactSpec
+
+from lm_eval.api.filter import FilterEnsemble
+from lm_eval.api.task import ConfigurableTask
+from lm_eval.filters.selection import TakeFirstFilter
+from lm_eval.tasks.libra import utils as source
+
+
+SOURCE_HASH = "4e6c9c2b0f675ff5c47414927f2a68a0e34d4f9189f7744cb2ddd7c4156af0b7"
+
+
+def _source_callback(function, name):
+    code = getattr(function, "__code__", None)
+    return (
+        callable(function)
+        and getattr(function, "__name__", None) == name
+        and code is not None
+        and hashlib.sha256(Path(code.co_filename).read_bytes()).hexdigest()
+        == SOURCE_HASH
+    )
+
+
+def _validate_source():
+    if hashlib.sha256(Path(source.__file__).read_bytes()).hexdigest() != SOURCE_HASH:
+        raise InvalidTask("LIBRA normalization source changed")
+    if (
+        version("pymorphy3") != "2.0.6"
+        or version("pymorphy3-dicts-ru") != "2.4.417150.4580142"
+    ):
+        raise InvalidTask(
+            "LIBRA morphology installation differs from the audited version"
+        )
+
+
+def enable(config):
+    _validate_source()
+    if (
+        config.get("output_type") != "generate_until"
+        or config.get("doc_to_target") != "positive_outputs"
+        or not _source_callback(config.get("process_results"), "process_results")
+    ):
+        raise InvalidTask("LIBRA source scoring contract changed")
+    definitions = config.get("metric_list")
+    if (
+        not isinstance(definitions, list)
+        or len(definitions) != 1
+        or definitions[0].get("metric") != "libra_score"
+    ):
+        raise InvalidTask("LIBRA requires its length-group score")
+    definition = definitions[0]
+    for name, replacement in AGGREGATORS.items():
+        if _source_callback(definition.get("aggregation"), name):
+            definition["aggregation"] = replacement
+            return
+    raise InvalidTask("LIBRA aggregate is outside the audited profiles")
+
+
+def validate_task(task):
+    if not getattr(task, "_verifyit_libra", False):
+        return
+    _validate_source()
+    if (
+        type(task).process_results is not ConfigurableTask.process_results
+        or getattr(task.process_results, "__func__", None)
+        is not ConfigurableTask.process_results
+    ):
+        raise InvalidTask("LIBRA task scorer changed")
+    if not _source_callback(
+        task.config.process_results, "process_results"
+    ) or task.aggregation() != {"libra_score": task._verifyit_libra_aggregation}:
+        raise InvalidTask("LIBRA source scorer or aggregate changed")
+    if (
+        task.config.output_type != "generate_until"
+        or task.config.doc_to_target != "positive_outputs"
+        or task.config.metadata.get("verifyit_libra") is not True
+    ):
+        raise InvalidTask("LIBRA source configuration changed")
+    filters = task._filters
+    if (
+        len(filters) != 1
+        or type(filters[0]) is not FilterEnsemble
+        or filters[0].name != "none"
+        or len(filters[0].filters) != 1
+    ):
+        raise InvalidTask("LIBRA response filter changed")
+    factory = filters[0].filters[0]
+    if (
+        not isinstance(factory, partial)
+        or factory.func is not TakeFirstFilter
+        or factory.args
+        or factory.keywords
+    ):
+        raise InvalidTask("LIBRA response filter changed")
+
+
+def _literal(candidate, reference, *, substring=False):
+    verdict = grade_exact_candidate(
+        ExactSpec(
+            (reference,),
+            ignore_case=False,
+            ignore_whitespace=False,
+            strip_outer_whitespace=False,
+            substring=substring,
+        ),
+        candidate,
+    )
+    if verdict.status != Status.SCORED:
+        raise InvalidTask("LIBRA exact primitive did not score")
+    return verdict.reward
+
+
+def _score(prediction, reference, profile):
+    if profile == "em":
+        expected = source.normalize_answer(reference)
+        if not expected.strip():
+            raise InvalidTask("LIBRA reference becomes empty after normalization")
+        return _literal(source.normalize_answer(prediction), expected, substring=True)
+    if profile == "f1":
+        return token_f1(list(prediction), list(reference)).reward
+    numbers = re.findall(r"\d+", prediction)
+    return (
+        sum(_literal(number, reference) for number in numbers) / len(numbers)
+        if numbers
+        else 0.0
+    )
+
+
+def _aggregate(results, profile):
+    _validate_source()
+    if not isinstance(results, list) or not results:
+        raise InvalidTask("LIBRA requires a complete nonempty sample batch")
+    groups = defaultdict(lambda: [0.0, 0])
+    for result in results:
+        if not isinstance(result, dict) or set(result) != {
+            "pred_answer",
+            "answers",
+            "length",
+        }:
+            raise InvalidTask("LIBRA sample observation is malformed")
+        references = result["answers"]
+        if (
+            not isinstance(references, list)
+            or not references
+            or any(not isinstance(x, str) for x in references)
+        ):
+            raise InvalidTask("LIBRA requires nonempty string reference alternatives")
+        length = result["length"]
+        if not isinstance(length, str) or not length:
+            raise InvalidTask("LIBRA length group is missing")
+        answers = set(source.normalize_answer(text) for text in references)
+        if any(not answer.strip() for answer in answers):
+            raise InvalidTask("LIBRA reference becomes empty after normalization")
+        if not isinstance(result["pred_answer"], str):
+            raise InvalidTask("LIBRA prediction must be a string")
+        prediction = source.normalize_answer(result["pred_answer"])
+        groups[length][1] += 1
+        # Preserve source first-positive set iteration, including its hash-seed sensitivity.
+        for answer in answers:
+            score = _score(prediction, answer, profile)
+            if score > 0:
+                groups[length][0] += score
+                break
+    return {key: correct / total for key, (correct, total) in groups.items()}
+
+
+def aggregate_results_em(results):
+    return _aggregate(results, "em")
+
+
+def aggregate_results_f1(results):
+    return _aggregate(results, "f1")
+
+
+def aggregate_results_count_score(results):
+    return _aggregate(results, "count")
+
+
+AGGREGATORS = {
+    "aggregate_results_em": aggregate_results_em,
+    "aggregate_results_f1": aggregate_results_f1,
+    "aggregate_results_count_score": aggregate_results_count_score,
+}
diff --git a/tests/unit/test_verifyit_libra.py b/tests/unit/test_verifyit_libra.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_verifyit_libra.py
@@ -0,0 +1,30 @@
+"""LIBRA normalization must not turn missing answers into positive scores."""
+
+import pytest
+from verifyit.grade import InvalidTask
+
+from lm_eval.tasks.libra import utils as source
+from lm_eval.verifyit_libra import aggregate_results_em, aggregate_results_f1
+
+
+@pytest.mark.parametrize("reference", ["", "!!!", "!!! !!!"])
+def test_normalized_empty_gold_aborts_group_aggregation(reference):
+    rows = [
+        {"pred_answer": "Москва", "answers": ["Москва"], "length": "8p"},
+        {"pred_answer": "", "answers": [reference], "length": "16p"},
+    ]
+    assert source.aggregate_results_em(rows) == {"8p": 1.0, "16p": 1.0}
+    with pytest.raises(InvalidTask, match="empty"):
+        aggregate_results_em(rows)
+
+
+def test_character_f1_preserves_source_first_positive_alternative():
+    rows = [{"pred_answer": "москв", "answers": ["москва", "москвич"], "length": "8p"}]
+    assert aggregate_results_f1(rows) == source.aggregate_results_f1(rows)
+
+
+def test_nonstring_prediction_does_not_match_coerced_gold():
+    rows = [{"pred_answer": None, "answers": ["None"], "length": "8p"}]
+    assert source.aggregate_results_em(rows) == {"8p": 1.0}
+    with pytest.raises(InvalidTask, match="string"):
+        aggregate_results_em(rows)
