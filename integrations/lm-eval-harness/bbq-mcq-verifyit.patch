@@ -0,0 +1,30 @@
+"""BBQ must reject undefined scores rather than return misleading observations."""
+
+import math
+
+import pytest
+from verifyit.grade import InvalidTask
+
+from lm_eval.tasks.cabbq import utils as source
+from lm_eval.verifyit_bbq import bias_score_disambig_agg, process_results
+
+
+def test_nan_winning_likelihood_does_not_award_accuracy():
+    doc = {"label": 0, "context_condition": "disambig", "question_type": "pro-stereo"}
+    responses = [(float("nan"), False)] + [(-2.0, False)] * 10
+    assert source.process_results(doc, responses)["acc_disambig"] == (1, 1)
+    with pytest.raises(InvalidTask, match="finite"):
+        process_results(doc, responses)
+
+
+def test_missing_comparison_population_aborts_bias_aggregation():
+    observations = [(1, 0, 1, 0)]
+    assert math.isnan(source.bias_score_disambig_agg(observations))
+    with pytest.raises(InvalidTask, match="finite"):
+        bias_score_disambig_agg(observations)
+
+
+def test_missing_unknown_alternatives_aborts():
+    doc = {"label": 0, "context_condition": "disambig", "question_type": "pro-stereo"}
+    with pytest.raises(InvalidTask, match="eleven"):
+        process_results(doc, [(-1.0, False), (-2.0, False), (-3.0, False)])
