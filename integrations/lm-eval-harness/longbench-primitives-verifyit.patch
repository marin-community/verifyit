+++ b/tests/unit/test_verifyit_longbench.py
@@ -0,0 +1,34 @@
+import pytest
+from verifyit.grade import InvalidTask
+
+from lm_eval.tasks.longbench import metrics as source
+from lm_eval.verifyit_longbench import process_results
+
+
+def test_blank_code_reference_cannot_award_similarity():
+    doc = {"answers": [""]}
+    assert source.get_code_sim_with_score(doc, [""])["score"] == 1
+    with pytest.raises(InvalidTask, match="nonempty string references"):
+        process_results(doc, [""], profile="code_sim")
+
+
+@pytest.mark.parametrize(
+    "profile,doc,prediction",
+    [
+        (
+            "classification",
+            {"answers": ["red fox"], "all_classes": ["red", "red fox", "bear"]},
+            "red fox bear",
+        ),
+        ("count", {"answers": ["7"]}, "7 8 7"),
+        ("retrieval_zh", {"answers": ["段落7"]}, "7 8 7"),
+        ("qa_f1", {"answers": ["the red fox", "alternate"]}, "red"),
+        ("qa_f1_zh", {"answers": ["红色狐狸"]}, "红色"),
+    ],
+)
+def test_native_compositions_preserve_source_fractional_scores(
+    profile, doc, prediction
+):
+    assert process_results(doc, [prediction], profile=profile) == getattr(
+        source, "get_" + profile + "_with_score"
+    )(doc, [prediction])
