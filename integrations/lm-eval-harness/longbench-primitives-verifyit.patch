+"""Compose LongBench answer scoring and retain source ROUGE/code runtimes."""
+
+import hashlib
+import json
+import math
+import os
+import re
+import sys
+import tempfile
+from functools import partial
+from importlib.metadata import version
+from pathlib import Path
+
+from verifyit.adapters.harness_profiles import token_f1
+from verifyit.grade import InvalidTask, Status, run
+from verifyit.modes.grade_exact import grade_exact_candidate
+from verifyit.spec import ExactSpec, ScriptSpec, render_spec
+
+from lm_eval.api import metrics as aggregate_metrics
+from lm_eval.api.filter import FilterEnsemble
+from lm_eval.api.task import ConfigurableTask
+from lm_eval.filters.selection import TakeFirstFilter
+from lm_eval.tasks.longbench import metrics as source
+
+
+SOURCE_HASH = "7111279c43e017abf49aba8e68ee3d7cedae7e715af1c8c0ad0c4bb72b758077"
+PROFILES = (
+    "qa_f1",
+    "qa_f1_zh",
+    "rouge",
+    "rouge_zh",
+    "code_sim",
+    "classification",
+    "count",
+    "retrieval",
+    "retrieval_zh",
+)
+RETAINED = ("rouge", "rouge_zh", "code_sim")
+
+
+def validate_source():
+    if any(
+        version(package) != expected
+        for package, expected in (
+            ("jieba", "0.42.1"),
+            ("fuzzywuzzy", "0.18.0"),
+            ("rouge", "1.0.1"),
+        )
+    ):
+        raise InvalidTask("LongBench dependency versions changed")
+    if source.fuzz.SequenceMatcher.__module__ != "difflib":
+        raise InvalidTask(
+            "LongBench fuzzy matching requires the audited difflib backend"
+        )
+    if hashlib.sha256(Path(source.__file__).read_bytes()).hexdigest() != SOURCE_HASH:
+        raise InvalidTask("LongBench source scorer changed")
+
+
+def enable(config):
+    validate_source()
+    callback = config.get("process_results")
+    profile = next(
+        (
+            p
+            for p in PROFILES
+            if getattr(callback, "__name__", None) == "get_" + p + "_with_score"
+        ),
+        None,
+    )
+    code = getattr(callback, "__code__", None)
+    if (
+        profile is None
+        or code is None
+        or hashlib.sha256(Path(code.co_filename).read_bytes()).hexdigest()
+        != SOURCE_HASH
+    ):
+        raise InvalidTask("LongBench callback is not audited")
+    if (
+        config.get("output_type", "generate_until") != "generate_until"
+        or config.get("doc_to_target") != "{{answers}}"
+    ):
+        raise InvalidTask("LongBench generation contract changed")
+    expected = [
+        {"metric": name, "aggregation": "mean", "higher_is_better": True}
+        for name in ("score", profile + "_score")
+    ]
+    if config.get("metric_list") != expected:
+        raise InvalidTask("LongBench metrics changed")
+    config["process_results"] = partial(process_results, profile=profile)
+    return profile
+
+
+def validate_task(task):
+    profile = getattr(task, "_verifyit_longbench", None)
+    if profile is None:
+        return
+    if (
+        type(task).process_results is not ConfigurableTask.process_results
+        or getattr(task.process_results, "__func__", None)
+        is not ConfigurableTask.process_results
+    ):
+        raise InvalidTask("LongBench task scorer changed")
+    callback = task.config.process_results
+    if (
+        not isinstance(callback, partial)
+        or callback.func is not process_results
+        or callback.args
+        or callback.keywords != {"profile": profile}
+    ):
+        raise InvalidTask("LongBench callback changed")
+    if (
+        task.config.doc_to_target != "{{answers}}"
+        or task.config.output_type != "generate_until"
+        or task.config.metadata.get("verifyit_longbench") is not True
+    ):
+        raise InvalidTask("LongBench generation configuration changed")
+    names = ("score", profile + "_score")
+    if task.aggregation() != {
+        name: aggregate_metrics.mean for name in names
+    } or task._metric_fn_list != {name: None for name in names}:
+        raise InvalidTask("LongBench aggregation changed")
+    filters = task._filters
+    if (
+        len(filters) != 1
+        or type(filters[0]) is not FilterEnsemble
+        or filters[0].name != "none"
+        or len(filters[0].filters) != 1
+    ):
+        raise InvalidTask("LongBench response filters changed")
+    factory = filters[0].filters[0]
+    if (
+        not isinstance(factory, partial)
+        or factory.func is not TakeFirstFilter
+        or factory.args
+        or factory.keywords
+    ):
+        raise InvalidTask("LongBench response filters changed")
+
+
+def exact(prediction, reference, *, substring=False):
+    verdict = grade_exact_candidate(
+        ExactSpec(
+            (reference,),
+            substring=substring,
+            ignore_case=False,
+            ignore_whitespace=False,
+            strip_outer_whitespace=False,
+        ),
+        prediction,
+    )
+    if verdict.status != Status.SCORED:
+        raise InvalidTask("LongBench exact primitive did not score")
+    return verdict.reward
+
+
+def tokens(text, profile):
+    if profile == "qa_f1":
+        return source.normalize_answer(text).split()
+    return [
+        clean
+        for token in source.jieba.cut(text, cut_all=False)
+        if (clean := source.normalize_zh_answer(token))
+    ]
+
+
+def validate_document(doc, results, profile):
+    validate_source()
+    if profile not in PROFILES:
+        raise InvalidTask("Unknown LongBench profile")
+    refs = doc.get("answers")
+    if (
+        not isinstance(refs, list)
+        or not refs
+        or any(not isinstance(x, str) or not x.strip() for x in refs)
+    ):
+        raise InvalidTask("LongBench requires nonempty string references")
+    if not isinstance(results, list) or not results or not isinstance(results[0], str):
+        raise InvalidTask("LongBench requires a string prediction")
+    if profile.startswith("qa_f1") and any(not tokens(ref, profile) for ref in refs):
+        raise InvalidTask("LongBench reference normalizes to empty")
+    if profile == "count" and any(re.fullmatch(r"\d+", ref) is None for ref in refs):
+        raise InvalidTask("LongBench count reference is not a number")
+    if profile.startswith("retrieval"):
+        pattern = r"段落(\d+)" if profile.endswith("_zh") else r"Paragraph (\d+)"
+        if any(not re.findall(pattern, ref) for ref in refs):
+            raise InvalidTask("LongBench retrieval reference has no paragraph ID")
+    if profile == "classification":
+        classes = doc.get("all_classes")
+        if (
+            not isinstance(classes, list)
+            or not classes
+            or any(not isinstance(x, str) or not x.strip() for x in classes)
+            or any(ref not in classes for ref in refs)
+        ):
+            raise InvalidTask("LongBench classification vocabulary is invalid")
+    return refs
+
+
+def native_score(doc, results, profile):
+    refs = validate_document(doc, results, profile)
+    prediction = results[0].strip()
+    scores = []
+    for ref in refs:
+        if profile.startswith("qa_f1"):
+            verdict = token_f1(tokens(prediction, profile), tokens(ref, profile))
+            if verdict.status != Status.SCORED:
+                raise InvalidTask("LongBench token-F1 did not score")
+            scores.append(verdict.reward)
+        elif profile in ("count", "retrieval", "retrieval_zh"):
+            if profile != "count":
+                ref = re.findall(
+                    r"段落(\d+)" if profile.endswith("_zh") else r"Paragraph (\d+)", ref
+                )[0]
+            numbers = re.findall(r"\d+", prediction)
+            scores.append(
+                sum(exact(number, ref) for number in numbers) / len(numbers)
+                if numbers
+                else 0.0
+            )
+        else:
+            matches = [
+                name
+                for name in doc["all_classes"]
+                if exact(prediction, name, substring=True)
+            ]
+            # Preserve source list mutation order when removing overlapping labels.
+            for term in matches:
+                if exact(ref, term, substring=True) and not exact(term, ref):
+                    matches.remove(term)
+            scores.append(
+                1.0 / len(matches) if any(exact(name, ref) for name in matches) else 0.0
+            )
+    score = max(scores)
+    return {"score": score, profile + "_score": score}
+
+
+def process_results(doc, results, *, profile):
+    validate_document(doc, results, profile)
+    if profile not in RETAINED:
+        return native_score(doc, results, profile)
+    with tempfile.TemporaryDirectory(prefix="verifyit-longbench-") as directory:
+        tests = Path(directory)
+        payload = tests / "input.json"
+        payload.write_text(
+            json.dumps(
+                {"doc": doc, "results": results, "profile": profile}, allow_nan=False
+            )
+        )
+        (tests / "run.sh").write_text('exec "$@"\n')
+        spec = ScriptSpec(
+            "run.sh",
+            args=(sys.executable, "-m", "lm_eval.verifyit_longbench", str(payload)),
+            timeout=30,
+            verdict_file="longbench.json",
+        )
+        config = tests / "verifier.toml"
+        config.write_text(render_spec(spec))
+        verdict = run(config, tests)
+    if verdict.status == Status.INVALID_TASK:
+        raise InvalidTask(f"LongBench runtime rejected the task: {verdict.detail}")
+    if verdict.status != Status.SCORED:
+        raise RuntimeError(
+            f"LongBench runtime failed: {verdict.status}: {verdict.detail}"
+        )
+    metrics = verdict.detail.get("metrics")
+    if not isinstance(metrics, dict) or set(metrics) != {"score", profile + "_score"}:
+        raise InvalidTask("LongBench runtime omitted scores")
+    return metrics
+
+
+def main():
+    payload = json.loads(Path(sys.argv[1]).read_text())
+    try:
+        doc = payload["doc"]
+        results = payload["results"]
+        profile = payload["profile"]
+        validate_document(doc, results, profile)
+        metrics = getattr(source, "get_" + profile + "_with_score")(doc, results)
+        if any(
+            not isinstance(v, (int, float)) or not math.isfinite(v) or not 0 <= v <= 1
+            for v in metrics.values()
+        ):
+            raise InvalidTask("LongBench source returned invalid scores")
+        verdict = {
+            "status": "scored",
+            "reward": metrics["score"],
+            "detail": {"metrics": metrics, "source_sha256": SOURCE_HASH},
+        }
+    except InvalidTask as error:
+        verdict = {
+            "status": "invalid_task",
+            "reward": 0,
+            "detail": {"error": str(error)},
+        }
+    (Path(os.environ["VERIFYIT_LOGS_DIR"]) / "longbench.json").write_text(
+        json.dumps(verdict, allow_nan=False)
+    )
+
+
+if __name__ == "__main__":
+    main()
