--- a/skyrl-agent/tests/test_coder1_verifyit.py
+++ b/skyrl-agent/tests/test_coder1_verifyit.py
@@ -435,3 +435,55 @@ def test_owning_host_cleans_nested_pytest_group_after_checker_death(monkeypatch)
         time.sleep(0.02)
     else:
         pytest.fail("owned pytest group remains after cleanup")
+
+
+@pytest.mark.parametrize(
+    "code,test_code,reward",
+    [
+        (
+            "def reverse(data): return data[::-1]",
+            "assert reverse(b'\\x00\\xffab') == b'ba\\xff\\x00'",
+            1,
+        ),
+        (
+            "def reverse(data): return data",
+            "assert reverse(b'\\x00\\xffab') == b'ba\\xff\\x00'",
+            0,
+        ),
+        (
+            "class Number:\n def __init__(self,n): self.n=n\n def __add__(self,x): return self.n+x\n def __rsub__(self,x): return x-self.n\n def __int__(self): return self.n\n def __neg__(self): return -self.n",
+            "n=Number(7)\nassert n+2==9\nassert 10-n==3\nassert int(n)==7\nassert -n == -7",
+            1,
+        ),
+        (
+            "class Number:\n def __init__(self,n): self.n=n\n def __add__(self,x): return self.n-x",
+            "assert Number(7)+2==9",
+            0,
+        ),
+    ],
+)
+def test_bytes_and_numeric_protocol_contracts(code, test_code, reward):
+    result = runtime.execute_contract(code, {"functional": test_code}, timeout=15)
+    assert result.status.value == "scored", result.detail
+    assert result.reward == reward, result.detail
+
+
+@pytest.mark.parametrize(
+    "inplace,expected",
+    [("self.n += other; return self", 1.0), ("return Number(self.n + other)", 0.0)],
+)
+def test_inplace_numeric_protocol_preserves_aliases(inplace, expected):
+    code = (
+        "class Number:\n def __init__(self,n): self.n=n\n def __iadd__(self,other): "
+        + inplace
+        + "\n def __int__(self): return self.n"
+    )
+    result = runtime.execute_contract(
+        code,
+        {
+            "functional": "n=Number(7)\nalias=n\nn+=2\nassert n is alias\nassert int(n)==9"
+        },
+        timeout=15,
+    )
+    assert result.status.value == "scored", result.detail
+    assert result.reward == expected, result.detail
