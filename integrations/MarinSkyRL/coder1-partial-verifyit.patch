+def test_owning_host_cleans_nested_pytest_group_after_checker_death(monkeypatch):
+    import os
+    import signal
+    import subprocess
+    import threading
+    import time
+
+    real_popen = subprocess.Popen
+    captured = {}
+
+    def observe_popen(*args, **kwargs):
+        process = real_popen(*args, **kwargs)
+        if "checker" not in captured:
+            captured["checker"] = process
+        return process
+
+    monkeypatch.setattr(subprocess, "Popen", observe_popen)
+    real_run = runtime.run
+
+    def kill_after_pytest_starts(path, *args, **kwargs):
+        root = Path(path).parent
+
+        def kill_checker():
+            deadline = time.monotonic() + 20
+            while time.monotonic() < deadline:
+                if (root / "pytest-started").exists():
+                    captured["pytest_pgid"] = int((root / "pytest.pgid").read_text())
+                    os.killpg(os.getpgid(captured["checker"].pid), signal.SIGKILL)
+                    return
+                time.sleep(0.02)
+
+        watcher = threading.Thread(target=kill_checker, daemon=True)
+        watcher.start()
+        try:
+            return real_run(path, *args, **kwargs)
+        finally:
+            watcher.join(timeout=21)
+
+    monkeypatch.setattr(runtime, "run", kill_after_pytest_starts)
+    tests = 'from pathlib import Path\nimport time\ndef test_wait():\n    Path("pytest-started").write_text("ready")\n    time.sleep(30)'
+    result = runtime.execute_contract(
+        "def f(): return 1", {"pytest": tests}, timeout=10
+    )
+    assert result.status.value == "infra_error", result.detail
+    assert result.reward == 0, result.detail
+    assert result.detail["pytest_process_cleanup"]["state"] == "killed", result.detail
+    assert captured["pytest_pgid"] == result.detail["pytest_process_cleanup"]["pgid"]
+    assert result.detail["session_cleanup"][0]["http_status"] == 200
+    deadline = time.monotonic() + 2
+    while time.monotonic() < deadline:
+        try:
+            os.killpg(captured["pytest_pgid"], 0)
+        except ProcessLookupError:
+            break
+        time.sleep(0.02)
+    else:
+        pytest.fail("owned pytest group remains after cleanup")
