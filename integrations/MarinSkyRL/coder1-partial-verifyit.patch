+            "value": {"kind": "tuple", "items": "malformed"},
+            "argument_nodes": {},
+        },
+        {
+            "kind": "exception",
+            "type": ["ValueError"],
+            "message": "malformed",
+            "argument_nodes": {},
+        },
+    ],
+)
+def test_malformed_rpc_packet_is_fatal_verifier_error(packet):
+    import threading
+    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+    from skyrl_gym.envs.nemotron_ultra.sandbox import SandboxClient
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+
+        def do_POST(self):
+            body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            code = body["generated_code"]
+            if "_namespace = " in code:
+                stdout = "VERIFYIT_READY"
+            elif "VERIFYIT_LIMIT_READY" in code:
+                stdout = "VERIFYIT_LIMIT_READY"
+            else:
+                stdout = "VERIFYIT_RPC:" + json.dumps(packet)
+            payload = json.dumps(
+                {
+                    "process_status": "completed",
+                    "stdout": stdout,
+                    "stderr": "",
+                    "new_session_created": False,
+                }
+            ).encode()
+            self.send_response(200)
+            self.end_headers()
+            self.wfile.write(payload)
+
+        def do_DELETE(self):
+            self.send_response(200)
+            self.end_headers()
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        client = SandboxClient(host="127.0.0.1", port=server.server_port)
+        result = runtime.execute_contract(
+            "def f(): return 1",
+            {"functional": "assert f()==1"},
+            sandbox=client,
+            timeout=5,
+        )
+        assert result.status.value == "infra_error", result.detail
+        assert result.reward == 0, result.detail
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+@pytest.mark.parametrize(
+    "code,tests,reward",
+    [
+        ("def f(): return __name__", {"functional": 'assert f()=="__main__"'}, 1),
+        (
+            "def f(): return __name__",
+            {"solution_file": 'from solution import f\nassert f()=="solution"'},
+            1,
+        ),
+        (
+            'def f(): return 1\nif __name__=="__main__": raise ValueError()',
+            {"functional": "assert f()==1"},
+            0,
+        ),
+    ],
+)
+def test_source_execution_module_name(code, tests, reward):
+    result = runtime.execute_contract(code, tests, timeout=15)
+    assert result.status.value == "scored", result.detail
+    assert result.reward == reward, result.detail
+
+
+def test_rich_comparison_never_sends_trusted_expected_value():
+    code = "class C:\n    def __eq__(self,expected): return True\ndef f(): return C()"
+    result = runtime.execute_contract(
+        code, {"functional": "assert f()==982713548235"}, timeout=15
+    )
+    assert result.status.value == "invalid_task", result.detail
+    assert result.reward == 0, result.detail
+
