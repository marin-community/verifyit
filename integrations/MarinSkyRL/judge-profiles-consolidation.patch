+def test_composition_deadline_discards_earlier_positive_judgments(server):
+    owner, judge = server
+    owner.reply = "[[YES]]"
+    owner.second_delay = 4.0
+    score, detail = grade_judge_profile_verifyit(
+        "candidate", {"rubric": [{"question": "First?"}, {"question": "Second?"}]},
+        judge, kind="multichallenge", timeout_seconds=3.0,
+    )
+    assert score == 0.0
+    assert detail["error_type"] == "verification_error"
+    assert len(owner.requests) == 2
+
+
+def test_hard_deadline_stops_continuously_arriving_judge_body(server):
+    owner, judge = server
+    owner.drip = True
+    started = time.monotonic()
+    score, detail = grade_judge_profile_verifyit(
+        "candidate", {"question": "Question", "answer": "Reference"},
+        judge, kind="abstention", timeout_seconds=3.0,
+    )
+    assert score == 0.0
+    assert detail["error_type"] == "verification_error"
+    assert owner.requests
+    assert time.monotonic() - started < 4.5
+
+
+def test_blank_multichallenge_is_candidate_zero_not_invalid_task(server):
+    owner, judge = server
+    record = {"rubric": [{"question": "Criterion one?"}, {"question": "Criterion two?"}]}
+    score, feedback = grade_judge_profile_verifyit(" \n\t", record, judge, kind="multichallenge")
+    assert score == 0.0
+    assert feedback == {"reason": "empty_output"}
+    assert owner.requests == []
+    assert_environment_step(owner, judge, "multichallenge_simple_agent", record, "", 0.0)
+    assert owner.requests == []
