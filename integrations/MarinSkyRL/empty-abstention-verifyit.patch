+@pytest.mark.parametrize("response", ["", " \n\t", "<think>Completed reasoning.</think>"])
+def test_present_empty_abstention_reaches_the_source_judge_contract(server, response):
+    owner, judge = server
+    owner.reply = "C"
+    record = {"question": "Which field marks no random access?", "answer": "nil ReaderAt field"}
+    native = grade_abstention(response, record, judge)
+    requests = list(owner.requests)
+    owner.requests.clear()
+    cutover = grade_judge_profile_verifyit(response, record, judge, kind="abstention")
+    assert native == cutover
+    assert cutover[0] == 0.5
+    assert cutover[1]["verdict"] == "abstain"
+    assert owner.requests == requests
+
+
+@pytest.mark.parametrize("response", ["<think>unfinished", "<thinking>unfinished", "<|start_think|>unfinished"])
+def test_incomplete_reasoning_cannot_be_reclassified_as_empty_abstention(server, response):
+    owner, judge = server
+    owner.reply = "C"
+    record = {"question": "Which field marks no random access?", "answer": "nil ReaderAt field"}
+    assert grade_abstention(response, record, judge)[0] == 0.5
+    owner.requests.clear()
+    cutover = grade_judge_profile_verifyit(response, record, judge, kind="abstention")
+    assert cutover[0] == 0
+    assert cutover[1]["reason"] == "incomplete_response"
+    assert owner.requests == []
+
+
+def test_empty_candidate_does_not_turn_empty_judge_transport_into_abstention(server):
+    owner, judge = server
+    owner.reply = ""
+    record = {"question": "Which field marks no random access?", "answer": "nil ReaderAt field"}
+    result = grade_judge_profile_verifyit("", record, judge, kind="abstention")
+    assert result[0] == 0
+    assert result[1].get("verdict") != "abstain"
+    assert owner.requests
+
+
+@pytest.mark.parametrize("response, expected", [("", 0.5), ("<think>finished</think>", 0.5), ("<think>unfinished", 0.0)])
+def test_environment_preserves_empty_versus_incomplete_abstention(server, response, expected):
+    owner, judge = server
+    owner.reply = "C"
+    record = {"question": "Which field marks no random access?", "answer": "nil ReaderAt field"}
+    env = NemotronUltraEnv(
+        {"verifyit_enabled": True},
+        extras={"extra_info": {"nemotron_ultra": {
+            "route": "skyrl_gym", "agent": "abstention_simple_agent",
+            "record_json": json.dumps(record), "request_json": "{}",
+        }}},
+    )
+    env.general_judge = judge
+    result = env.step(response)
+    assert result["reward"] == expected
+    assert result["done"] is True
+    assert bool(owner.requests) == bool(expected)
